

{% liquid
  assign block_settings = block.settings
  assign use_inverse_logo = false

  if section.settings.enable_transparent_header_home and template.name == 'index' and section.settings.home_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_product and template.name == 'product' and section.settings.product_inverse_logo == true
    assign use_inverse_logo = true
  elsif section.settings.enable_transparent_header_collection and template.name == 'collection' and section.settings.collection_inverse_logo == true
    assign use_inverse_logo = true
  endif

  if use_inverse_logo
    if settings.logo_inverse != blank
      assign inverse_logo = settings.logo_inverse
    else
      assign inverse_logo = settings.logo
    endif
  endif

  assign alt_text_fallback = 'accessibility.home_logo_alt' | t: store_name: shop.name
%}

{% comment %}
  Output all logo variants, use CSS to hide/show the appropriate one
  based on the .header[transparent] selector
{% endcomment %}
<a
  {% if template.name == 'index' and block_settings.hide_logo_on_home_page %}
    data-hidden-on-home-page
  {% endif %}
  href="{{ routes.root_url }}"
  class="size-style spacing-style header-logo"
  style="
    {% render 'size-style', settings: block_settings %}
    {% render 'spacing-style', settings: block_settings %}
    --font-family: var(--font-body--family);
    --font-style: var(--font-body--style);
    --font-weight: 600;
  "
  {{ block.shopify_attributes }}
>
  {% liquid
    assign logo_width = settings.logo_height | times: settings.logo.aspect_ratio | ceil
    assign logo_width_mobile = settings.logo_height_mobile | times: settings.logo.aspect_ratio | ceil
    assign inverse_logo_width = settings.logo_height | times: inverse_logo.aspect_ratio | ceil
    assign inverse_logo_width_mobile = settings.logo_height_mobile | times: inverse_logo.aspect_ratio | ceil
    assign logo_style = '--header-logo-image-width: ' | append: logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: settings.logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: settings.logo_height_mobile | append: 'px;'
    assign inverse_logo_style = '--header-logo-image-width: ' | append: inverse_logo_width | append: 'px;' | append: '--header-logo-image-width-mobile: ' | append: inverse_logo_width_mobile | append: 'px; --header-logo-image-height: ' | append: settings.logo_height | append: 'px; --header-logo-image-height-mobile: ' | append: settings.logo_height_mobile | append: 'px;'
  %}

  <span
    {% if use_inverse_logo %}
      class="header-logo__solid-header-image-container"
    {% endif %}
    data-testid="header-logo"
  >
    {% render 'image',
      image: settings.logo,
      class: 'header-logo__image',
      height: settings.logo_height,
      alt_text_fallback: alt_text_fallback,
      text_fallback: shop.name,
      style: logo_style
    %}
  </span>

  {% if use_inverse_logo %}
    <span
      class="header-logo__transparent-header-image-container"
      data-testid="header-logo-inverse"
    >
      {% render 'image',
        image: inverse_logo,
        class: 'header-logo__image',
        height: settings.logo_height,
        alt_text_fallback: alt_text_fallback,
        text_fallback: shop.name,
        style: inverse_logo_style
      %}
    </span>
  {% endif %}
</a>

{% stylesheet %}
  .header-logo {
    display: flex;
    height: 100%;
    font-size: var(--font-size--md);
    font-family: var(--font-family);
    font-weight: var(--font-weight);
    font-style: var(--font-style);
    color: var(--color-foreground);
    justify-content: center;
    align-items: center;
    text-decoration: none;

    &[data-hidden-on-home-page] {
      display: none;

      #header-component:is(
          [sticky='always']:not([data-scroll-direction='none']),
          [sticky='scroll-up'][data-scroll-direction='up']
        )
        & {
        display: flex;
      }
    }

    @media screen and (max-width: 749px) {
      padding: 0;
    }

    @media screen and (min-width: 750px) {
      flex-shrink: 0;
    }

    &:hover {
      text-decoration: none;
    }
  }

  .header-logo__image {
    object-fit: contain;
    height: var(--header-logo-image-height-mobile);
    width: var(--header-logo-image-width-mobile);

    @media screen and (min-width: 750px) {
      height: var(--header-logo-image-height);
      width: var(--header-logo-image-width);
    }
  }

  .header-logo__solid-header-image-container {
    display: var(--header-logo-display, block);
  }

  .header-logo__transparent-header-image-container {
    display: var(--header-logo-inverse-display, none);
  }
  /* Somna (2026-10-15): header + Halloween banner fit on one screen on laptops and desktops
     (990px and up; phones and tablets unchanged). Kept here because this logo block is in the
     header on every page.
     - Header (every page): less white above and below the logo row, logo 160px wide (was 173px);
       the witch hat still clears the orange announcement bar.
     - Banner (homepage + Halloween Sale page): exactly the screen height left under the header
       (--header-group-height is measured by the theme), never taller than 62% of the width or
       shorter than 480px. The white wave is shallower, and the copy, "70% OFF" and the homepage
       button scale with the screen height, so everything shows on a 16-inch laptop. Same layout as Figma. */
  @media screen and (min-width: 990px) {
    #header-component {
      padding-top: 2px;
    }

    #header-component .header__row--top .header__columns {
      --padding-block-start: 16px;
      --padding-block-end: 8px;
    }

    #header-component .header-logo span[data-testid='header-logo'] {
      width: 160px;
    }

    :is(#MainContent[data-template='index'] [id$='__hero_jVaWmY'], #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale']) .hero {
      min-height: max(480px, min(62vw, calc(100svh - var(--header-group-height, 128px)))) !important;
    }

    /* The whole wave curve (Figma 1442 x 533 shape; its curve is the bottom 86 units) is scaled
       into this shorter strip, so it stays smooth instead of being cut flat at the top */
    :is(#MainContent[data-template='index'] [id$='__hero_jVaWmY'], #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale']) .hero::before {
      height: clamp(36px, 3.6vw, 56px) !important;
      background-size: 100% calc(clamp(36px, 3.6vw, 56px) * 6.2) !important;
    }

    :is(#MainContent[data-template='index'] [id$='__hero_jVaWmY'], #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale']) .hero__container {
      padding-block: calc(clamp(36px, 3.6vw, 56px) + clamp(12px, 3svh, 36px)) clamp(40px, 8svh, 96px) !important;
    }

    /* "THE somna. HALLOWEEN SALE" */
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .text-block--text_VDbt3L,
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .text-block--text_VDbt3L > *,
    #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale'] .text-block--text_hwsub,
    #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale'] .text-block--text_hwsub > * {
      font-size: clamp(14px, min(1.6vw, 2.6svh), 22px) !important;
    }

    /* "NO TRICKS. ONLY TREATS." */
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .text-block--text_eT6TMz,
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .text-block--text_eT6TMz > *,
    #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale'] .text-block--text_hwtitle,
    #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale'] .text-block--text_hwtitle > * {
      font-size: clamp(40px, min(5.2vw, 8svh), 76px) !important;
    }

    /* "70% OFF" */
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .text-block[style*='font-display-spray'],
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .text-block[style*='font-display-spray'] > * {
      font-size: clamp(56px, min(8vw, 12svh), 120px) !important;
    }


    /* "On Nasal Strips & Mouth Tape. Ends Oct 31" + perks line */
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] :is(.text-block--text_Lqf6bA, .text-block--text_hwperks),
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] :is(.text-block--text_Lqf6bA, .text-block--text_hwperks) > *,
    #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale'] :is(.text-block--text_hwon, .text-block--text_hwperks),
    #MainContent[data-template='page.halloween-sale'] [id$='__hero_hwsale'] :is(.text-block--text_hwon, .text-block--text_hwperks) > * {
      font-size: clamp(13px, min(1.2vw, 2.2svh), 17px) !important;
    }

    /* Homepage "Shop the sale" button: a little shorter on short screens */
    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .size-style.button.button--button_6EgajN {
      min-height: clamp(44px, 7svh, 54px) !important;
    }

    #MainContent[data-template='index'] [id$='__hero_jVaWmY'] .button::before {
      width: clamp(36px, 5.6svh, 46px) !important;
      height: clamp(36px, 5.6svh, 46px) !important;
    }
  }
  /* Somna (2026-10-15): "Small essentials. Thoughtfully made." (homepage, section_ibM3ft) shows
     completely still, by request: no moon, no floating dots, no glow or breathing on the icons,
     no scroll-in entrance and no fade-up. Overrides section 12 of somna-motion.css (that file is
     unchanged; delete this block to bring the motion back). Layout and colours are unchanged. */
  .shopify-section[id$='__section_ibM3ft'] .section::before,
  .shopify-section[id$='__section_ibM3ft'] .section::after,
  .shopify-section[id$='__section_ibM3ft'] .section-background::before,
  .shopify-section[id$='__section_ibM3ft'] .icon-block::before {
    content: none !important;
    animation: none !important;
  }

  .shopify-section[id$='__section_ibM3ft'] :is(.icon-block__media, .custom-header > *, .group-block, .divider__line) {
    animation: none !important;
  }

  .shopify-section[id$='__section_ibM3ft'] .sm-reveal,
  .shopify-section[id$='__section_ibM3ft'] .sm-reveal.sm-in {
    opacity: 1 !important;
    translate: none !important;
    scale: none !important;
    transition: none !important;
  }
  /* Somna (2026-10-15): Halloween "Sale" link in the header menu (the link set as "Highlighted link"
     in the menu block). The theme's jack-o'-lantern (the one on the logo's "o") sits before the word
     and gives a little wobble every few seconds, the word glows softly like a lantern, and on hover
     the pumpkin hops. Visitors who prefer reduced motion see a still pumpkin. */
  .menu-list__link--highlight .menu-list__link-title {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
  }

  .menu-list__link--highlight .menu-list__link-title::before {
    content: '';
    flex: none;
    width: 1.3em;
    height: 1.3em;
    background: url('/cdn/shop/files/somna-halloween-pumpkin-lantern.png?width=80') center / contain no-repeat;
    transform-origin: 50% 90%;
  }

  @keyframes somna-sale-wobble {
    0%, 60%, 100% {
      rotate: 0deg;
      translate: 0 0;
    }

    66% {
      rotate: -14deg;
      translate: 0 -2px;
    }

    74% {
      rotate: 12deg;
      translate: 0 -3px;
    }

    82% {
      rotate: -7deg;
      translate: 0 -1px;
    }

    90% {
      rotate: 3deg;
      translate: 0 0;
    }
  }

  @keyframes somna-sale-glow {
    0%, 100% {
      text-shadow: 0 0 0 rgb(255 152 69 / 0);
    }

    50% {
      text-shadow: 0 0 10px rgb(255 152 69 / 0.8);
    }
  }

  @keyframes somna-sale-hop {
    0%, 100% {
      rotate: 0deg;
      translate: 0 0;
    }

    40% {
      rotate: -10deg;
      translate: 0 -5px;
    }

    70% {
      rotate: 6deg;
      translate: 0 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .menu-list__link--highlight .menu-list__link-title {
      animation: somna-sale-glow 3.2s ease-in-out infinite;
    }

    .menu-list__link--highlight .menu-list__link-title::before {
      animation: somna-sale-wobble 3.2s ease-in-out infinite;
    }

    .menu-list__link--highlight:hover .menu-list__link-title::before {
      animation: somna-sale-hop 0.6s ease-in-out infinite;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.logo",
  "tag": null,
  "class": "header-logo",
  "settings": [
    {
      "type": "paragraph",
      "content": "t:content.edit_logo_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_logo_on_home_page",
      "label": "t:settings.hide_logo_on_home_page",
      "info": "t:info.hide_logo_on_home_page_help"
    },
    {
      "type": "header",
      "content": "t:content.padding_desktop"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
