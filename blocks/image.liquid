

{% liquid
  assign block_settings = block.settings
  assign ratio = 1

  case block_settings.image_ratio
    when 'landscape'
      assign ratio = '16 / 9'
    when 'portrait'
      assign ratio = '4 / 5'
    when 'adapt'
      assign ratio = block_settings.image.aspect_ratio
  endcase

  if ratio == 0 or ratio == null
    assign ratio = 1
  endif
%}

{% capture class %}
  image-block image-block--{{ block.id }} image-block--height-{{ block_settings.height }} spacing-style size-style
  {%- if block_settings.visibility == 'mobile' %} image-block--hide-desktop{% elsif block_settings.visibility == 'desktop' %} image-block--hide-mobile{% endif %}
{% endcapture %}

{% capture style %}
  --ratio: {{ ratio }};
  {% render 'size-style', settings: block_settings %}
  {% render 'spacing-style', settings: block_settings %}
  {% if block_settings.width_desktop != blank %}--image-width-desktop: {{ block_settings.width_desktop }}px;{% endif %}
{% endcapture %}

{% capture image_border_style %}
  --ratio: {{ ratio }};
  {% if block_settings.image_ratio_desktop == 'adapt' %}
    --ratio-desktop: {{ block_settings.image_desktop.aspect_ratio | default: block_settings.image.aspect_ratio | default: 1 }};
  {% elsif block_settings.image_ratio_desktop != blank %}
    --ratio-desktop: {{ block_settings.image_ratio_desktop }};
  {% endif %}
  {% render 'border-override', settings: block_settings %}
{% endcapture %}

{% liquid
  assign media_width_desktop = '100vw'
  assign media_width_mobile = '100vw'
  assign sizes = 'auto, (min-width: 750px) ' | append: media_width_desktop | append: ', ' | append: media_width_mobile
  assign widths = '240, 352, 832, 1200, 1600, 1920, 2560, 3840'
%}

{% capture image %}
  {%- liquid
    assign image_class = 'image-block__image border-style'
    if block_settings.image_desktop != blank
      assign image_class = 'image-block__image image-block__image--mobile border-style'
    endif
  -%}
  {%- if block_settings.image -%}
    {{
      block_settings.image
      | image_url: width: 3840
      | image_tag:
        width: block_settings.image.width,
        widths: widths,
        height: block_settings.image.height,
        class: image_class,
        style: image_border_style,
        sizes: sizes
    }}
  {%- endif -%}
  {%- comment -%} Optional desktop image (990px and up) {%- endcomment -%}
  {%- if block_settings.image_desktop -%}
    {{
      block_settings.image_desktop
      | image_url: width: 3840
      | image_tag:
        width: block_settings.image_desktop.width,
        widths: widths,
        height: block_settings.image_desktop.height,
        class: 'image-block__image image-block__image--desktop border-style',
        style: image_border_style,
        sizes: sizes,
        loading: 'lazy'
    }}
  {%- endif -%}
  {%- if block_settings.image == blank and block_settings.image_desktop == blank -%}
    {% comment %} <div class="placeholder-image border-style size-style" style="{{ image_border_style }}">
      {{ 'detailed-apparel-1' | placeholder_svg_tag: 'image-block__placeholder' }}
    </div> {% endcomment %}
  {%- endif -%}
{% endcapture %}

{% if block_settings.link == blank %}
  <div
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </div>
{% else %}
  <a
    href="{{ block_settings.link }}"
    class="{{ class }}"
    style="{{ style }}"
    {{ block.shopify_attributes }}
  >
    {{ image }}
  </a>
{% endif %}

{% stylesheet %}
  .image-block__placeholder {
    height: 100%;
    width: 100%;
    object-fit: cover;
    object-position: center center;
    overflow: hidden;
    position: relative;
  }

  .placeholder-image {
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
  }

  .image-block {
    display: flex;

    /* When the image is nested in a group, section, etc, respect the parent's horizontal alignment */
    justify-content: var(--horizontal-alignment, 'inline-start');
  }

  .image-block--height-fill .image-block__image {
    height: 100%;
  }

  .image-block__image {
    object-fit: cover;
    aspect-ratio: var(--ratio);
  }

  /* Desktop image + "Show on" setting (990px breakpoint); other desktop
     image settings are applied in somna-home-desktop.css */
  .image-block__image--desktop {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .image-block--hide-mobile {
      display: none;
    }
  }

  @media screen and (min-width: 990px) {
    .image-block__image--desktop {
      display: block;
    }

    .image-block__image--mobile,
    .image-block--hide-desktop {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.image",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.size"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        },
        {
          "value": "landscape",
          "label": "t:options.landscape"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "select",
      "id": "width",
      "label": "t:settings.width_desktop",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width == 'custom' }}"
    },
    {
      "type": "select",
      "id": "width_mobile",
      "label": "t:settings.width_mobile",
      "options": [
        {
          "value": "fit-content",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        },
        {
          "value": "custom",
          "label": "t:options.custom"
        }
      ],
      "default": "fill"
    },
    {
      "type": "range",
      "id": "custom_width_mobile",
      "label": "t:settings.custom_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 100,
      "visible_if": "{{ block.settings.width_mobile == 'custom' }}"
    },
    {
      "type": "select",
      "id": "height",
      "label": "t:settings.height",
      "options": [
        {
          "value": "fit",
          "label": "t:options.fit_content"
        },
        {
          "value": "fill",
          "label": "t:options.fill"
        }
      ],
      "default": "fit",
      "visible_if": "{{ block.settings.image_ratio == 'adapt' }}"
    },
    {
      "type": "header",
      "content": "t:content.borders"
    },
    {
      "type": "select",
      "id": "border",
      "label": "t:settings.style",
      "options": [
        {
          "value": "none",
          "label": "t:options.none"
        },
        {
          "value": "solid",
          "label": "t:options.solid"
        }
      ],
      "default": "none"
    },
    {
      "type": "range",
      "id": "border_width",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "label": "t:settings.thickness",
      "default": 1,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "label": "t:settings.opacity",
      "default": 100,
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "t:settings.color",
      "placeholder": "t:settings.default",
      "visible_if": "{{ block.settings.border != 'none' }}"
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "t:settings.border_radius",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "header",
      "content": "Desktop (990px and up)",
      "info": "Leave empty to use the mobile value."
    },
    {
      "type": "image_picker",
      "id": "image_desktop",
      "label": "Desktop image",
      "info": "Optional. Shown from 990px instead of the image above."
    },
    {
      "type": "select",
      "id": "image_ratio_desktop",
      "label": "Aspect ratio (desktop)",
      "options": [
        {
          "value": "",
          "label": "Same as mobile"
        },
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "4 / 5",
          "label": "t:options.portrait"
        },
        {
          "value": "1",
          "label": "t:options.square"
        },
        {
          "value": "16 / 9",
          "label": "t:options.landscape"
        },
        {
          "value": "2 / 1",
          "label": "Wide (2:1)"
        }
      ],
      "default": ""
    },
    {
      "type": "number",
      "id": "width_desktop",
      "label": "Width (desktop, px)"
    },
    {
      "type": "number",
      "id": "border_radius_desktop",
      "label": "Corner radius (desktop, px)"
    },
    {
      "type": "select",
      "id": "border_corners_desktop",
      "label": "Rounded corners (desktop)",
      "options": [
        {
          "value": "all",
          "label": "All"
        },
        {
          "value": "bottom",
          "label": "Bottom only"
        },
        {
          "value": "top",
          "label": "Top only"
        }
      ],
      "default": "all"
    },
    {
      "type": "select",
      "id": "visibility",
      "label": "Show on",
      "options": [
        {
          "value": "all",
          "label": "All screens"
        },
        {
          "value": "mobile",
          "label": "Mobile and tablet only (hide from 990px)"
        },
        {
          "value": "desktop",
          "label": "Desktop only (from 990px)"
        }
      ],
      "default": "all"
    }
  ],
  "presets": [
    {
      "name": "t:names.image",
      "category": "t:categories.basic"
    }
  ]
}
{% endschema %}
