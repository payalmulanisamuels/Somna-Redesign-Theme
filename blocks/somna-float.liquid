{%- comment -%}
  Somna floating image (decorative).
  Sits on top of the section, out of the layout flow, so it never moves or resizes anything.
  Motion (gentle float + slow drift on scroll) lives in assets/somna-motion.css, section 5.
{%- endcomment -%}
{%- liquid
  assign image = block.settings.image
  assign classes = 'somna-float'
  if block.settings.round
    assign classes = classes | append: ' somna-float--round'
  endif
  if block.settings.show_on_mobile == false
    assign classes = classes | append: ' somna-float--desktop-only'
  endif
  if block.settings.bob
    assign classes = classes | append: ' somna-float--bob'
  endif
  assign sizes = '(min-width: 750px) ' | append: block.settings.width | append: 'px, ' | append: block.settings.width_mobile | append: 'px'
-%}
<div
  class="{{ classes }}"
  aria-hidden="true"
  style="--sf-x: {{ block.settings.x }}%; --sf-y: {{ block.settings.y }}%; --sf-w: {{ block.settings.width }}px; --sf-x-m: {{ block.settings.x_mobile }}%; --sf-y-m: {{ block.settings.y_mobile }}%; --sf-w-m: {{ block.settings.width_mobile }}px; --sf-rotate: {{ block.settings.rotation }}deg; --sf-depth: {{ block.settings.depth }}px; --sf-bob-delay: -{{ block.settings.bob_delay }}s;"
  {{ block.shopify_attributes }}
>
  {%- if image != blank -%}
    {{-
      image
      | image_url: width: 600
      | image_tag:
        alt: '',
        loading: 'lazy',
        fetchpriority: 'low',
        decoding: 'async',
        widths: '120, 240, 360, 480, 600',
        sizes: sizes,
        class: 'somna-float__image'
    -}}
  {%- elsif request.design_mode -%}
    {{ 'image' | placeholder_svg_tag: 'somna-float__image somna-float__placeholder' }}
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Floating image",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "A small decorative image that floats over this section. It never changes the layout. Works best with a cut-out PNG (transparent background)."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "checkbox",
      "id": "round",
      "label": "Round crop with soft shadow",
      "info": "Turn off for cut-out PNGs with a transparent background.",
      "default": true
    },
    {
      "type": "header",
      "content": "Desktop position"
    },
    {
      "type": "range",
      "id": "x",
      "label": "Left to right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "y",
      "label": "Top to bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 20
    },
    {
      "type": "range",
      "id": "width",
      "label": "Size",
      "min": 40,
      "max": 320,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "header",
      "content": "Mobile position"
    },
    {
      "type": "checkbox",
      "id": "show_on_mobile",
      "label": "Show on mobile",
      "default": true
    },
    {
      "type": "range",
      "id": "x_mobile",
      "label": "Left to right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 85
    },
    {
      "type": "range",
      "id": "y_mobile",
      "label": "Top to bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 12
    },
    {
      "type": "range",
      "id": "width_mobile",
      "label": "Size",
      "min": 24,
      "max": 160,
      "step": 2,
      "unit": "px",
      "default": 64
    },
    {
      "type": "header",
      "content": "Motion"
    },
    {
      "type": "range",
      "id": "rotation",
      "label": "Tilt",
      "min": -45,
      "max": 45,
      "step": 1,
      "unit": "°",
      "default": -8
    },
    {
      "type": "range",
      "id": "depth",
      "label": "Drift while scrolling",
      "info": "How far it slides up as the page scrolls. 0 turns it off.",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "checkbox",
      "id": "bob",
      "label": "Gentle float",
      "default": true
    },
    {
      "type": "range",
      "id": "bob_delay",
      "label": "Float timing offset",
      "info": "Give each floating image a different value so they don't move together.",
      "min": 0,
      "max": 6,
      "step": 0.5,
      "unit": "s",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Floating image"
    }
  ]
}
{% endschema %}
