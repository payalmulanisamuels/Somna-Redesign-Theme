

{% liquid
  assign product_resource = closest.product
  if request.visual_preview_mode and product_resource == blank
    assign product_resource = collections.all.products.first
  endif
-%}

{% unless product_resource == blank %}
  {% render 'variant-main-picker', product_resource: product_resource, section: section, product: product %}
{% endunless %}

{% stylesheet %}
  /* Somna (2026-10-15): product page buy box on tablet and desktop (750px and up), compact so the
     sizes, Autoship box and Add to cart fit in about one screen. Same layout and colours; gaps are
     small and even (8px between parts, 6-14px inside the boxes), text 1-2px smaller, bag pictures
     smaller, Add to cart 48px tall (was 57px). Phones and the Halloween Sale page are unchanged. */
  @media screen and (min-width: 750px) {
    .template-product .product-details .group-block:has(> .group-block-content > .somna-buybox-review),
    .template-product .product-details .group-block.color-custom-group_6Ynwc9 {
      padding-block: 14px 12px !important;
    }

    .template-product .product-details .somna-buybox-review {
      margin: 0 0 8px !important;
      padding: 6px 12px !important;
    }

    .template-product .product-details .somna-buybox-review__top {
      font-size: 15px !important;
    }

    .template-product .product-details .somna-buybox-review__quote {
      margin-top: 1px !important;
      font-size: 12px !important;
    }

    .template-product .product-details .somna-buybox-picker {
      margin: 0 !important;
      padding-block: 0 4px !important;
    }

    .template-product .product-details .somna-buybox-picker .variant-option--buttons:has(> .somna-tier) {
      gap: 10px !important;
      margin: 0 !important;
      padding-top: 11px !important;
    }

    .template-product .product-details .somna-buybox-picker .variant-option__button-label--card.somna-tier {
      padding: 0 6px 13px !important;
    }

    .template-product .product-details .somna-tier .variant-card__inner {
      padding-top: 10px !important;
    }

    .template-product .product-details .somna-tier .variant-card__title {
      font-size: 20px !important;
    }

    .template-product .product-details .somna-tier .variant-card__img {
      height: 38px !important;
    }

    .template-product .product-details .somna-tier__price {
      margin-top: 2px !important;
    }

    .template-product .product-details .somna-tier__night {
      font-size: 15px !important;
    }

    .template-product .product-details .somna-tier__perk {
      font-size: 13px !important;
    }

    .template-product .product-details .somna-custom-subscription-container {
      gap: 8px !important;
      margin-top: 10px !important;
    }

    .template-product .product-details .somna-box-banner {
      padding: 4px 0 !important;
      font-size: 12px !important;
    }

    .template-product .product-details .somna-purchase-box[data-purchase-card='subscribe'] .somna-box-top-row {
      padding: 8px 14px 4px !important;
    }

    .template-product .product-details .somna-purchase-box[data-purchase-card='subscribe'] .somna-box-inner {
      padding: 6px 14px 8px !important;
    }

    .template-product .product-details .somna-box-title {
      font-size: 17px !important;
    }

    .template-product .product-details .somna-perks-list {
      gap: 2px !important;
      margin-block: 0 !important;
      font-size: 14px !important;
    }

    .template-product .product-details .somna-gifts {
      margin-top: 6px !important;
      gap: 6px !important;
    }

    .template-product .product-details .somna-gift {
      gap: 2px !important;
      min-height: 40px !important;
      font-size: 12px !important;
    }

    .template-product .product-details .somna-gift__icon {
      width: 16px !important;
      height: 16px !important;
    }

    .template-product .product-details .somna-dropdown-wrap {
      margin-top: 6px !important;
    }

    .template-product .product-details .somna-frequency-dropdown {
      padding: 6px 16px !important;
      font-size: 14px !important;
    }

    .template-product .product-details .somna-purchase-box[data-purchase-card='onetime'] .somna-box-inner {
      padding: 8px 14px !important;
    }

    .template-product .product-details .somna-onetime-save {
      font-size: 14px !important;
    }

    .template-product .product-details .product-form-buttons {
      padding-block: 8px 0 !important;
    }

    .template-product .product-details .button[id^='BuyButtons-ProductSubmitButton-'] {
      height: 48px !important;
      font-size: 22px !important;
    }

    .template-product .product-details .somna-buybox-flex {
      margin: 15px 0 6px 0!important;
      font-size: 13px !important;
    }

    .template-product .product-details .somna-buybox-delivery {
      padding: 6px 12px !important;
      font-size: 14px !important;
    }
  }

