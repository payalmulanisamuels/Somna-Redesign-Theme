{%- doc -%}
  Somna "Autoship & Save" / "One-Time Purchase" box.

  Works with any native selling plan (Shopify Subscriptions, or any app that
  creates real selling plans). Delivery wording is shown in days via
  `somna-plan-label` ("Deliver every 2 months" -> "Delivery every 60 days").
  Checkout still shows the plan's own name from the Subscriptions app.

  Variant "nights" (used to preselect the matching plan) come from the
  `custom.nights` variant metafield, then the `custom.nights` product metafield,
  falling back to variant position (1st = 30, 2nd = 60, 3rd+ = 120).

  Halloween 2026: when the product's `custom.halloween_sale_text` metafield has a value
  (e.g. "70% OFF"), the banner reads "HALLOWEEN: <value> + 3 FREE GIFTS ON YOUR FIRST ORDER"
  and the third perk reads "Lock in your Halloween price on every delivery." The metafield is
  display text only; every price, saving and % here comes from the real selling plans.
  Products without the metafield keep the normal wording.

  Sale "was" prices (2026-10-15, Nasal Strips + Mouth Tape): optional variant metafields
  `custom.autoship_compare_at` and `custom.onetime_compare_at` (decimal, e.g. 264 / 393).
  - Autoship "YOU SAVE" (and its hidden crossed-out price) = autoship_compare_at - Autoship price.
  - One-time "% OFF" pill = onetime_compare_at vs the one-time price.
  The "x% off every order" perk and "You'd save $x with Autoship" keep the real plan saving.
  Variants without these metafields work exactly as before.

  @param {object} product_resource - The product object.
  @param {object} section - The section object.
{%- enddoc -%}

{%- liquid
  assign current_var = product_resource.selected_or_first_available_variant
  assign somna_hw_text = product_resource.metafields.custom.halloween_sale_text.value | strip

  assign has_selling_plans = false
  for v in product_resource.variants
    if v.selling_plan_allocations.size > 0
      assign has_selling_plans = true
      break
    endif
  endfor

  assign init_plan_id = ''
  assign init_has_plans = false
  assign init_diff = 100000

  # Find the Size / Quantity / Set option (e.g. "1 Bag", "2 Sets", "3+1 Bags").
  # A variant's supply is read from that option's position, not its position
  # in the full variant list — so "Red / 1 Set" is 30 nights, not 120.
  assign supply_option = nil
  for product_option in product_resource.options_with_values
    assign option_name_check = product_option.name | downcase
    if option_name_check contains 'size' or option_name_check contains 'quantity' or option_name_check contains 'set'
      assign supply_option = product_option
      break
    endif
  endfor
-%}

{%- if has_selling_plans -%}
  <script type="application/json" id="SomnaSubscriptionData-{{ section.id }}">
    {
      "variants": {
        {%- for v in product_resource.variants -%}
          {%- liquid
            assign supply_index = forloop.index
            if supply_option
              assign supply_value_index = supply_option.position | minus: 1
              assign supply_value = v.options[supply_value_index]
              for option_value in supply_option.values
                if option_value.name == supply_value
                  assign supply_index = forloop.index
                  break
                endif
              endfor
            endif
            assign v_nights = 30
            if supply_index == 2
              assign v_nights = 60
            elsif supply_index >= 3
              assign v_nights = 120
            endif
            # Nights override: variant metafield, else product metafield (e.g. single-variant 3-pack sets = 90)
            if v.metafields.custom.nights != blank
              assign v_nights = v.metafields.custom.nights.value | plus: 0
            elsif product_resource.metafields.custom.nights != blank
              assign v_nights = product_resource.metafields.custom.nights.value | plus: 0
            endif
            assign is_current = false
            if v.id == current_var.id
              assign is_current = true
            endif

            # Bags in this variant (30 nights per bag: 1 / 2 / 4), used for the per-bag price.
            assign v_bags = v_nights | divided_by: 30.0 | round
            if v_bags < 1
              assign v_bags = 1
            endif

            # Sale "was" prices from variant metafields, in cents (0 = not set)
            assign v_auto_cmp = 0
            if v.metafields.custom.autoship_compare_at != blank
              assign v_auto_cmp = v.metafields.custom.autoship_compare_at.value | times: 100 | round
            endif
            assign v_once_cmp = 0
            if v.metafields.custom.onetime_compare_at != blank
              assign v_once_cmp = v.metafields.custom.onetime_compare_at.value | times: 100 | round
            endif
            assign v_once_pct = 0
            if v_once_cmp > v.price
              assign v_once_pct = v_once_cmp | minus: v.price | times: 100.0 | divided_by: v_once_cmp | round
            endif
            if is_current
              assign init_once_pct = v_once_pct
            endif
          -%}
          "{{ v.id }}": {
            "nights": {{ v_nights }},
            "price": {{ v.price | money_without_trailing_zeros | json }},
            "onetimePct": {{ v_once_pct }},
            "plans": [
              {%- for alloc in v.selling_plan_allocations -%}
                {%- liquid
                  assign plan = alloc.selling_plan

                  # Day length + "Delivery every X days" wording (shared with the cart).
                  capture plan_days
                    render 'somna-plan-label', selling_plan: plan, days_only: true
                  endcapture
                  assign plan_days = plan_days | plus: 0
                  capture plan_label
                    render 'somna-plan-label', selling_plan: plan
                  endcapture
                  assign plan_label = plan_label | strip

                  assign regular = alloc.compare_at_price | default: v.price
                  assign save_cents = regular | minus: alloc.price
                  assign discount = 0
                  if save_cents > 0
                    assign discount = save_cents | times: 100.0 | divided_by: regular | round
                  endif

                  # Autoship "was" price + saving: the metafield price when set, else the one-time price
                  assign auto_regular = regular
                  if v_auto_cmp > alloc.price
                    assign auto_regular = v_auto_cmp
                  endif
                  assign auto_save = auto_regular | minus: alloc.price

                  # Subscription price per bag (1 / 2 / 4), kept in cents so it shows with decimals.
                  assign per_bag = alloc.price | times: 1.0 | divided_by: v_bags | round

                  # Per night across the nights this variant supplies (e.g. 4 bags = 120 nights).
                  assign per_night = ''
                  if v_nights > 0
                    assign per_night = alloc.price | times: 1.0 | divided_by: v_nights | round | money
                  endif

                  if is_current
                    assign init_has_plans = true
                    # Preselect the plan closest to the variant's supply (30 / 60 / 120 nights).
                    assign plan_diff = plan_days | minus: v_nights | abs
                    if forloop.first or plan_diff < init_diff
                      assign init_diff = plan_diff
                      assign init_plan_id = plan.id
                      assign init_name = plan_label
                      assign init_price = alloc.price
                      assign init_regular = auto_regular
                      assign init_save = save_cents
                      assign init_auto_save = auto_save
                      assign init_per_bag = per_bag
                      assign init_discount = discount
                      assign init_per_night = per_night
                    endif
                  endif
                -%}
                {
                  "id": {{ plan.id | json }},
                  "name": {{ plan.name | json }},
                  "interval": {{ plan_label | json }},
                  "days": {{ plan_days }},
                  "price": {{ alloc.price | money_without_trailing_zeros | json }},
                  "regular": {{ auto_regular | money_without_trailing_zeros | json }},
                  "save": {{ save_cents | money_without_trailing_zeros | json }},
                  "saveCents": {{ save_cents }},
                  "autoSave": {{ auto_save | money_without_trailing_zeros | json }},
                  "autoSaveCents": {{ auto_save }},
                  "perBag": {{ per_bag | money_without_trailing_zeros | json }},
                  "discount": {{ discount }},
                  "perNight": {{ per_night | json }}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      }
    }
  </script>

  {%- liquid
    assign one_time_selected = false
    if init_has_plans == false
      assign one_time_selected = true
    endif
  -%}

  <div
    class="somna-custom-subscription-container"
    id="SomnaSubscriptionWidget-{{ section.id }}"
    data-section-id="{{ section.id }}"
  >
    <!-- Option 1: Autoship & Save Box -->
    <div
      class="somna-purchase-box{% unless one_time_selected %} active{% endunless %}"
      data-purchase-card="subscribe"
      {% if one_time_selected %}hidden{% endif %}
    >
      <div class="somna-box-banner">
        {%- if somna_hw_text != blank -%}
          HALLOWEEN: <span class="somna-box-banner__offer">{{ somna_hw_text | escape }}</span> + 3 FREE GIFTS ON YOUR FIRST ORDER
        {%- else -%}
          <span class="somna-box-banner__offer"><span data-somna="discount">{{ init_discount | default: 0 }}</span>% OFF</span> + 3 FREE GIFTS ON YOUR FIRST ORDER
        {%- endif -%}
      </div>
      <div class="somna-box-top-row">
        <label class="somna-radio-label">
          <input type="radio" name="somna_purchase_type_{{ section.id }}" value="subscribe" {% unless one_time_selected %}checked{% endunless %}>
          <span class="somna-radio-bullet"></span>
          <div class="somna-title-stack">
            <span class="somna-box-title">Autoship & Save</span>
            <span class="somna-per-night" {% if init_per_night == blank %}hidden{% endif %}>
              <span data-somna="per-night">{{ init_per_night }}</span> Per Night
            </span>
          </div>
        </label>
        <div class="somna-price-stack">
          <div class="somna-pricing-row">
            <span class="somna-strike-price" data-somna="regular" {% if init_auto_save <= 0 %}hidden{% endif %}>
              {{- init_regular | money_without_trailing_zeros -}}
            </span>
            <span class="somna-active-price" data-somna="price">{{ init_price | money_without_trailing_zeros }}</span>
          </div>
          <div class="somna-save-pill" {% if init_auto_save <= 0 %}hidden{% endif %}>
            YOU SAVE <span data-somna="auto-save">{{ init_auto_save | money_without_trailing_zeros }}</span>
          </div>
        </div>
      </div>
      <div class="somna-box-inner">
        {%- liquid
          # "Delivery every 60 days" -> "delivery every 60 days" for the perk line
          assign init_name_first = init_name | slice: 0 | downcase
          assign init_name_rest = init_name | slice: 1, 200
          assign init_name_lc = init_name_first | append: init_name_rest
        -%}
        <ul class="somna-perks-list">
          <li>
            <span class="somna-perk-check" aria-hidden="true">✓</span>
            <b><span data-somna="per-bag">{{ init_per_bag | money_without_trailing_zeros }}</span>/mo · 
            
            {%  if product.handle contains 'nasal-strips' and product.handle contains 'mouth-tape' %}
            <span data-somna="discount">{{ init_discount | default: 0 }}</span>% off every order
            {% endif %}</b>

          </li>
          <li>
            <span class="somna-perk-check" aria-hidden="true">✓</span>
            <span><strong>FREE</strong> shipping · <span data-somna="interval-lc">{{ init_name_lc }}</span></span>
          </li>
          <li>
            <span class="somna-perk-check" aria-hidden="true">✓</span>
            {%- if somna_hw_text != blank -%}
              <span><b>Lock in your Halloween price</b> on every delivery.</span>
            {%- else -%}
              <b><span data-somna="discount">{{ init_discount | default: 0 }}</span>% off every delivery, not just the first</b>
            {%- endif -%}
          </li>
        </ul>

        <div class="somna-gifts" aria-label="Free gifts included">
          <div class="somna-gift">
            <svg class="somna-gift__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.3 5 7.6 4.3 3 4.5v14c4.6-.2 7.3.5 9 2 1.7-1.5 4.4-2.2 9-2v-14c-4.6-.2-7.3.5-9 2Z"/><path d="M12 6.5v14"/></g></svg>
            <span>Sleep Guide 1</span>
          </div>
          <div class="somna-gift">
            <svg class="somna-gift__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 6.5C10.3 5 7.6 4.3 3 4.5v14c4.6-.2 7.3.5 9 2 1.7-1.5 4.4-2.2 9-2v-14c-4.6-.2-7.3.5-9 2Z"/><path d="M12 6.5v14"/></g></svg>
            <span>Sleep Guide 2</span>
          </div>
          <div class="somna-gift">
            <svg class="somna-gift__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/><path d="m8.5 15 2.5 2.5 4.5-4.5"/></g></svg>
            <span>30-Night Tracker</span>
          </div>
        </div>

        <div class="somna-dropdown-wrap">
          <select
            class="somna-frequency-dropdown"
            aria-label="Delivery frequency"
            data-somna="plan-select"
          >
            {%- for alloc in current_var.selling_plan_allocations -%}
              <option
                value="{{ alloc.selling_plan.id }}"
                {% if alloc.selling_plan.id == init_plan_id %}selected{% endif %}
              >
                {%- render 'somna-plan-label', selling_plan: alloc.selling_plan -%}
              </option>
            {%- endfor -%}
          </select>
        </div>
      </div>
    </div>

    <!-- Option 2: One-Time Purchase Box -->
    {%- unless product_resource.requires_selling_plan -%}
      <div class="somna-purchase-box{% if one_time_selected %} active{% endif %}" data-purchase-card="onetime">
        <div class="somna-box-inner">
          <div class="somna-box-top-row">
            <label class="somna-radio-label">
              <input type="radio" name="somna_purchase_type_{{ section.id }}" value="onetime" {% if one_time_selected %}checked{% endif %}>
              <span class="somna-radio-bullet"></span>
              <span class="somna-box-title">One-time purchase</span>
            </label>
            <div class="somna-price-stack">
              <span class="somna-active-price" data-somna="onetime-price">{{ current_var.price | money_without_trailing_zeros }}</span>
            </div>
          </div>
          <p class="somna-onetime-save" data-somna-onetime-save {% if init_save <= 0 %}hidden{% endif %}>
            <span>You'd save <b data-somna="save">{{ init_save | money_without_trailing_zeros }}</b> with Autoship</span>
            <span class="somna-onetime-pill"><span data-somna="onetime-pct">{% if init_once_pct > 0 %}{{ init_once_pct }}{% else %}{{ init_discount | default: 0 }}{% endif %}</span>% OFF</span>
          </p>
        </div>
      </div>
    {%- endunless -%}
  </div>

  <script>
    (() => {
      const sectionId = {{ section.id | json }};

      const init = () => {
        const container = document.getElementById(`SomnaSubscriptionWidget-${sectionId}`);
        const dataEl = document.getElementById(`SomnaSubscriptionData-${sectionId}`);
        if (!container || !dataEl || container.dataset.somnaReady) return;
        container.dataset.somnaReady = 'true';

        const data = JSON.parse(dataEl.textContent);
        const subBox = container.querySelector('[data-purchase-card="subscribe"]');
        const oneTimeBox = container.querySelector('[data-purchase-card="onetime"]');
        const select = container.querySelector('[data-somna="plan-select"]');

        const productForm =
          document.getElementById(`BuyButtons-ProductForm-${sectionId}`) ||
          container.closest('.shopify-section')?.querySelector('form[data-type="add-to-cart-form"]');
        if (!productForm) return;

        // The real selling plan id submitted to /cart/add. Disabled = one-time purchase.
        let planInput = productForm.querySelector('input[name="selling_plan"]');
        if (!planInput) {
          planInput = document.createElement('input');
          planInput.type = 'hidden';
          planInput.name = 'selling_plan';
          productForm.appendChild(planInput);
        }

        const variantIdInput = productForm.querySelector('input[name="id"]');
        const regularEl = container.querySelector('[data-somna="regular"]');
        const savePill = container.querySelector('.somna-save-pill');
        const perNightEl = container.querySelector('.somna-per-night');
        const oneTimeSaveEl = container.querySelector('[data-somna-onetime-save]');
        let plans = [];
        let currentVariant = null;
        let currentVariantId = null;

        // The widget isn't re-rendered on variant change, so look each field's nodes up once.
        const fieldEls = {};
        const setText = (key, value) => {
          fieldEls[key] ??= container.querySelectorAll(`[data-somna="${key}"]`);
          fieldEls[key].forEach((el) => {
            if (el.textContent !== value) el.textContent = value;
          });
        };

        const isSubscribe = () => subBox && !subBox.hidden && subBox.classList.contains('active');

        const syncForm = () => {
          if (isSubscribe() && select.value) {
            planInput.value = select.value;
            planInput.disabled = false;
          } else {
            planInput.value = '';
            planInput.disabled = true;
          }

          // Programmatic changes fire no `change` event, so announce the new purchase option
          // (the sticky add-to-cart bar mirrors it — see assets/sticky-add-to-cart.js).
          container.dispatchEvent(
            new CustomEvent('somna:purchase-option-change', {
              bubbles: true,
              detail: {
                mode: planInput.disabled ? 'onetime' : 'subscribe',
                sellingPlanId: planInput.value,
              },
            })
          );
        };

        const boxes = container.querySelectorAll('.somna-purchase-box');
        const activate = (box, sync = true) => {
          boxes.forEach((b) => b.classList.toggle('active', b === box));
          const radio = box?.querySelector('input[type="radio"]');
          if (radio) radio.checked = true;
          if (sync) syncForm();
        };

        const renderPlan = () => {
          const plan = plans.find((p) => String(p.id) === select.value);
          if (!plan) return;
          setText('discount', String(plan.discount));
          setText('price', plan.price);
          setText('per-bag', plan.perBag);
          setText('regular', plan.regular);
          setText('save', plan.save);
          setText('auto-save', plan.autoSave);
          setText('onetime-pct', String(currentVariant?.onetimePct > 0 ? currentVariant.onetimePct : plan.discount));
          setText('per-night', plan.perNight);
          setText('interval', plan.interval);
          setText('interval-lc', plan.interval.charAt(0).toLowerCase() + plan.interval.slice(1));
          regularEl.hidden = plan.autoSaveCents <= 0;
          if (oneTimeSaveEl) oneTimeSaveEl.hidden = plan.saveCents <= 0;
          savePill.hidden = plan.autoSaveCents <= 0;
          perNightEl.hidden = !plan.perNight;
          syncForm();
        };

        const renderVariant = (variantId) => {
          // Skip repeat calls for the variant already shown.
          if (String(variantId) === currentVariantId) return;
          const variant = data.variants[String(variantId)];
          if (!variant) return;
          currentVariantId = String(variantId);
          currentVariant = variant;

          setText('onetime-price', variant.price);
          plans = variant.plans;

          if (!plans.length) {
            subBox.hidden = true;
            if (oneTimeSaveEl) oneTimeSaveEl.hidden = true;
            activate(oneTimeBox);
            return;
          }

          const wasHidden = subBox.hidden;
          subBox.hidden = false;

          // Rebuild the dropdown from this variant's real selling plans and
          // preselect the plan closest to the variant's supply (30 / 60 / 120 nights).
          select.replaceChildren(...plans.map((p) => new Option(p.interval, p.id)));
          const distance = (p) => Math.abs(p.days - variant.nights);
          const match = plans.reduce((best, p) => (distance(p) < distance(best) ? p : best), plans[0]);
          select.value = String(match.id);

          // renderPlan() syncs the form, so don't sync (and fire the change event) twice.
          if (wasHidden || !oneTimeBox) activate(subBox, false);
          renderPlan();
        };

        boxes.forEach((box) => {
          box.addEventListener('click', () => activate(box));
        });

        select.addEventListener('change', renderPlan);

        // Horizon fires this when a variant is picked. The clicked option's variant id is in
        // event.detail straight away, so render from the local JSON now instead of waiting for
        // the section re-render fetch. The promise is only a fallback (no variant id on the option,
        // e.g. a combination that doesn't exist yet).
        const scope = container.closest('.shopify-section') || document;
        scope.addEventListener('shopify:product:select', (event) => {
          if (event.target instanceof Element && event.target.closest('product-card')) return;
          const variantId = event.detail?.variantId;
          if (variantId) {
            renderVariant(variantId);
            return;
          }
          event.promise
            .then((result) => {
              const id = result?.detail?.resource?.id ?? variantIdInput?.value;
              if (id) renderVariant(id);
            })
            .catch(() => {
              /* aborted fetch — a newer selection will follow */
            });
        });

        renderVariant(variantIdInput?.value || {{ current_var.id | json }});
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', init);
      } else {
        init();
      }
    })();
  </script>
{%- endif -%}
