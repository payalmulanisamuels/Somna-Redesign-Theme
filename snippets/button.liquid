{%- doc -%}
  Intended for use in a block similar to the button block.

  @param {string} link - link to render
  @param {object} [block] - The block

  @example
  {% render 'button', link: '/collections/all' %}
{%- enddoc -%}

{% assign block_settings = block.settings %}
{% render 'button-custom-styles', block_settings: block_settings, block_id: block.id %}

{%  if block_settings.label != blank %}
<a
  {% if link == blank %}
    role="link"
    aria-disabled="true"
  {% else %}
    href="{{ link }}"
  {% endif %}
  class="
    size-style
    {{ block_settings.style_class }}
    {{ block_settings.style_class }}--{{ block.id }}
    {% if block_settings.font_size != blank %}button-font-size{% endif %}
    {% if block_settings.font_size_tablet != blank %}button-font-size-tablet{% endif %}
    {% if block_settings.font_size_desktop != blank %}button-font-size-desktop{% endif %}
    {% if block_settings.height_desktop != blank %}button-height-desktop{% endif %}
    {% if block_settings.padding_inline_desktop != blank %}button-padding-desktop{% endif %}
    {% if block_settings.button_radius_desktop != blank %}button-radius-desktop{% endif %}
    {% if block_settings.icon != blank %}button--has-icon{% if block_settings.icon_size != blank %} button--icon-size{% endif %}{% endif %}
  "
  style="
    {% render 'size-style', settings: block_settings %}
    {% if block_settings.font_size != blank %}--button-font-size: {{ block_settings.font_size }};{% endif %}
    {% if block_settings.font_size_tablet != blank %}--button-font-size-tablet: {{ block_settings.font_size_tablet }};{% endif %}
    {% if block_settings.font_size_desktop != blank %}--button-font-size-desktop: {{ block_settings.font_size_desktop }};{% endif %}
    {% if block_settings.height_desktop != blank %}--button-height-desktop: {{ block_settings.height_desktop }}px;{% endif %}
    {% if block_settings.padding_inline_desktop != blank %}--button-padding-desktop: {{ block_settings.padding_inline_desktop }}px;{% endif %}
    {% if block_settings.button_radius_desktop != blank %}--button-radius-desktop: {{ block_settings.button_radius_desktop }}px;{% endif %}
    {% if block_settings.icon != blank %}--button-icon: url('{{ block_settings.icon | image_url: width: 160 }}');{% endif %}
    {% if block_settings.icon != blank and block_settings.icon_size != blank %}--button-icon-size: {{ block_settings.icon_size }}px;{% endif %}
  "
  {%- if block_settings.open_in_new_tab -%}
    target="_blank"
    rel="noopener noreferrer"
  {%- endif -%}
  {{ block.shopify_attributes }}
>
  {{ block_settings.label }}
</a>
{%  endif %}

{% stylesheet %}
  /* Button icon (block setting "Icon"): drawn before the label. It replaces any icon that
     section CSS already puts there (e.g. the hero's pumpkin), so each button can have an
     icon that suits its own colour. Size and spacing come from the existing button styles,
     or from "Icon size (px)" when that is filled in. */
  .size-style.button--has-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5em;
  }

  .size-style.button--has-icon::before {
    content: '';
    flex: none;
    width: var(--button-icon-size, 1.6em);
    height: var(--button-icon-size, 1.6em);
    background: var(--button-icon) center / contain no-repeat !important;
    filter: none !important;
  }

  .size-style.button--icon-size::before {
    width: var(--button-icon-size) !important;
    height: var(--button-icon-size) !important;
  }

  /* Responsive button font size (mobile first) */
  .size-style.button-font-size {
    font-size: var(--button-font-size);
  }

  @media screen and (min-width: 750px) {
    .size-style.button-font-size-tablet {
      font-size: var(--button-font-size-tablet);
    }
  }

  @media screen and (min-width: 990px) {
    .size-style.button-font-size-desktop {
      font-size: var(--button-font-size-desktop);
    }
  }
{% endstylesheet %}
