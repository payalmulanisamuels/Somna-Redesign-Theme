{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
          {%- liquid
  # Target the variant object for this option value
  assign current_variant = product_option_value.variant

  # Check if current option is Size / Quantity / Set
  assign option_name_downcase = product_option.name | downcase
  assign is_size_option = false
  if option_name_downcase contains 'size' or option_name_downcase contains 'quantity' or option_name_downcase contains 'set'
    assign is_size_option = true
  endif

  if is_size_option
    # Subscription / Selling Plan pricing
    assign has_selling_plan = false
    assign sub_price = current_variant.price
    assign one_time_price = current_variant.price

    for alloc in current_variant.selling_plan_allocations
      assign has_selling_plan = true
      assign sub_price = alloc.price
      assign one_time_price = alloc.compare_at_price | default: current_variant.price
      break
    endfor

    # Metafield fallbacks
    if current_variant.metafields.custom.subscription_price != blank
      assign sub_price = current_variant.metafields.custom.subscription_price.value
    endif
    if current_variant.metafields.custom.one_time_price != blank
      assign one_time_price = current_variant.metafields.custom.one_time_price.value
    endif
    assign duration_text = current_variant.metafields.custom.duration.value | default: current_variant.metafields.custom.subtitle.value

    # Nights calculation for per-night dynamic pricing
    assign nights_count = 30
    if forloop.index == 2
      assign nights_count = 60
    elsif forloop.index >= 3
      assign nights_count = 120
    endif
  endif
-%}

{%- if is_size_option -%}
  {% comment %} =========================================================
    SIZE / QUANTITY CARDS (DYNAMIC DATA ATTRIBUTES ENABLED)
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label variant-option__button-label--card {% if forloop.index == 2 %}most_popular{% endif %} {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
    data-sub-formatted="{{ sub_price | money_without_trailing_zeros }}"
    data-onetime-formatted="{{ one_time_price | money_without_trailing_zeros }}"
    data-sub-numeric="{{ sub_price | divided_by: 100.0 }}"
    data-onetime-numeric="{{ one_time_price | divided_by: 100.0 }}"
    data-nights="{{ nights_count }}"
  >
    {% comment %} Top Badges {% endcomment %}
    {% if forloop.index == 2 %}
      <span class="variant-card__badge popular">MOST POPULAR</span>
    {% elsif forloop.index >= 3 %}
      <span class="variant-card__badge free-bag">4th BAG FREE</span>
    {% endif %}

    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    <div class="variant-card__inner">
      <span class="variant-card__title">{{- product_option_value | escape -}}</span>
      <span class="variant-card__sub-title">
        {% if forloop.index == 1 %}30 nights . one month{% elsif forloop.index == 2 %}60 nights - two months{% else %}120 nights - four months{% endif %}
      </span>
      <div class="variant-card__img-wrap">
        {%- assign var_img = current_variant.metafields.custom.variant_image.value | default: product.featured_image -%}
        {%- if var_img != blank -%}
          {{ var_img | image_url: width: 200 | image_tag: loading: 'lazy', class: 'variant-card__img' }}
        {%- endif -%}
      </div>
      <span class="variant-card__gift">+2 free gifts</span>
    </div>

    {%- liquid
      assign diff_amount = one_time_price | minus: sub_price
    -%}
    {% if forloop.index >= 3 and diff_amount > 0 %}
      <span class="variant-card__bottom-save-pill">SAVE {{ diff_amount | money_without_trailing_zeros }}</span>
    {% endif %}

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>

{%- else -%}
  {% comment %} =========================================================
    ALL OTHER OPTIONS (Color, Style, etc.)
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
  >
    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    {% if variant_style == 'swatch' %}
      {% liquid
        assign featured_media = product_option_value.variant.featured_media
        if featured_media == blank and product_option_value.product_url
          assign featured_media = product_option_value.variant.product.featured_media
        endif
      %}
      {% render 'swatch',
        swatch: product_option_value.swatch,
        variant_image: featured_media,
        mode: 'unscaled'
      %}
    {% else %}
      {% if product_option_value.available == true %}
        <span class="variant-option__button-label__pill" data-key="variant-option-pill"></span>
      {% endif %}
      <span class="variant-option__button-label__text" data-key="variant-option-text">
        {{- product_option_value  -}}
      </span>
    {% endif %}

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>
{%- endif -%}
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.5 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% comment %} =========================================================
  CUSTOM SUBSCRIPTION BOX (FULLY DYNAMIC PRICE, PER NIGHT & SAVINGS)
========================================================= {% endcomment %}
<div class="somna-custom-subscription-container" id="SomnaSubscriptionWidget">
  <!-- Option 1: Autoship & Save Box -->
  <div class="somna-purchase-box active" data-purchase-card="subscribe">
    <div class="somna-box-banner">10% OFF YOUR FIRST ORDER</div>
    <div class="somna-box-inner">
      <div class="somna-box-top-row">
        <label class="somna-radio-label">
          <input type="radio" name="somna_purchase_type" value="subscribe" checked>
          <span class="somna-radio-bullet"></span>
          <div class="somna-title-stack">
            <span class="somna-box-title">Autoship & Save</span>
            <span class="somna-per-night" id="SomnaPerNightPrice">$1.32 Per Night</span>
          </div>
        </label>
        <div class="somna-price-stack">
          <div class="somna-pricing-row">
            <span class="somna-strike-price" id="SomnaStrikePrice">$88</span>
            <span class="somna-active-price" id="SomnaSubPrice">$79</span>
          </div>
        </div>
      </div>
      <div class="somna-save-pill" id="SomnaSavePill">SAVE $9</div>

      <ul class="somna-perks-list">
        <li>✓ Same price, for as long as you stay subscribed</li>
        <li>✓ <strong>FREE</strong> shipping</li>
        <li>✓ FREE Gifts included in Every Delivery</li>
        <li>✓ Skip, pause, or cancel anytime</li>
      </ul>

      <div class="somna-dropdown-wrap">
        <select class="somna-frequency-dropdown" id="SomnaSellingPlanSelect" name="selling_plan">
          {%- liquid
            assign current_var = product_resource.selected_or_first_available_variant
            for allocation in current_var.selling_plan_allocations
              echo '<option value="' | append: allocation.selling_plan.id | append: '">' | append: allocation.selling_plan.name | append: '</option>'
            endfor
          -%}
          {% if current_var.selling_plan_allocations.size == 0 %}
            <option value="60">Delivery every 60 Days</option>
            <option value="30">Delivery every 30 Days</option>
            <option value="90">Delivery every 90 Days</option>
          {% endif %}
        </select>
      </div>
    </div>
  </div>

  <!-- Option 2: One-Time Purchase Box -->
  <div class="somna-purchase-box" data-purchase-card="onetime">
    <div class="somna-box-inner">
      <div class="somna-box-top-row">
        <label class="somna-radio-label">
          <input type="radio" name="somna_purchase_type" value="onetime">
          <span class="somna-radio-bullet"></span>
          <span class="somna-box-title">One-Time Purchase</span>
        </label>
        <div class="somna-price-stack">
          <span class="somna-active-price" id="SomnaOneTimePrice">$88</span>
        </div>
      </div>
    </div>
  </div>

  <!-- Guarantees & Timeline Footer -->
  <div class="somna-widget-meta-footer">
    <div class="somna-guarantee-text">
      🛡️ 30-Night Money-Back Guarantee &nbsp;|&nbsp; Made in USA &nbsp;|&nbsp; <a href="/pages/return-refund-policy" class="somna-policy-link">Learn more →</a>
    </div>
    <div class="somna-delivery-timeline">
      <div class="somna-timeline-header">
        <span>Order Today</span>
        <span>Arrives in 7 to 9 business days</span>
      </div>
      <div class="somna-timeline-line">
        <div class="somna-timeline-box-icon">📦</div>
      </div>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const container = document.getElementById('SomnaSubscriptionWidget');
    if (!container) return;

    const purchaseBoxes = container.querySelectorAll('.somna-purchase-box');
    const sellingPlanSelect = document.getElementById('SomnaSellingPlanSelect');
    
    const productForm = document.querySelector('form[action*="/cart/add"]') || document.querySelector('.variant-picker__form');
    let hiddenSellingPlanInput = productForm ? productForm.querySelector('input[name="selling_plan"][type="hidden"]') : null;

    if (productForm && !hiddenSellingPlanInput) {
      hiddenSellingPlanInput = document.createElement('input');
      hiddenSellingPlanInput.type = 'hidden';
      hiddenSellingPlanInput.name = 'selling_plan';
      productForm.appendChild(hiddenSellingPlanInput);
    }

    function updateFormSellingPlan() {
      const activeBox = container.querySelector('.somna-purchase-box.active');
      if (activeBox && activeBox.getAttribute('data-purchase-card') === 'subscribe') {
        if (hiddenSellingPlanInput && sellingPlanSelect) {
          hiddenSellingPlanInput.value = sellingPlanSelect.value;
        }
      } else {
        if (hiddenSellingPlanInput) {
          hiddenSellingPlanInput.value = '';
        }
      }
    }

    // Dynamic price, per-night and savings calculator
    function syncSubscriptionPrices() {
      const selectedCard = document.querySelector('label.variant-option__button-label--card.selected') || document.querySelector('label.variant-option__button-label--card:has(input:checked)');
      if (!selectedCard) return;

      const subFormatted = selectedCard.getAttribute('data-sub-formatted');
      const onetimeFormatted = selectedCard.getAttribute('data-onetime-formatted');
      const subNumeric = parseFloat(selectedCard.getAttribute('data-sub-numeric') || '0');
      const onetimeNumeric = parseFloat(selectedCard.getAttribute('data-onetime-numeric') || '0');
      const nights = parseInt(selectedCard.getAttribute('data-nights') || '30', 10);

      const subPriceEl = document.getElementById('SomnaSubPrice');
      const oneTimePriceEl = document.getElementById('SomnaOneTimePrice');
      const strikePriceEl = document.getElementById('SomnaStrikePrice');
      const perNightEl = document.getElementById('SomnaPerNightPrice');
      const savePillEl = document.getElementById('SomnaSavePill');

      if (subPriceEl && subFormatted) subPriceEl.textContent = subFormatted;
      if (oneTimePriceEl && onetimeFormatted) oneTimePriceEl.textContent = onetimeFormatted;
      if (strikePriceEl && onetimeFormatted) strikePriceEl.textContent = onetimeFormatted;

      // Calculate Per Night
      if (perNightEl && nights > 0 && subNumeric > 0) {
        const perNight = (subNumeric / nights).toFixed(2);
        perNightEl.textContent = `$${perNight} Per Night`;
      }

      // Calculate Exact Savings ($)
      if (savePillEl && onetimeNumeric > subNumeric) {
        const savedAmount = Math.round(onetimeNumeric - subNumeric);
        savePillEl.textContent = `SAVE $${savedAmount}`;
      }
    }

    updateFormSellingPlan();
    syncSubscriptionPrices();

    purchaseBoxes.forEach(box => {
      box.addEventListener('click', () => {
        purchaseBoxes.forEach(b => b.classList.remove('active'));
        box.classList.add('active');
        const radio = box.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
        updateFormSellingPlan();
      });
    });

    if (sellingPlanSelect) {
      sellingPlanSelect.addEventListener('change', () => {
        updateFormSellingPlan();
      });
    }

    document.querySelectorAll('label.variant-option__button-label--card').forEach(card => {
      card.addEventListener('click', () => {
        setTimeout(syncSubscriptionPrices, 50);
      });
    });
  });
</script>

<style>
  /* Custom card and subscription box styling matching exact layout */
  .variant-option__button-label--card {
    position: relative;
    border: 1.5px solid #cbd3d8;
    border-radius: 12px;
    padding: 12px 6px;
    text-align: center;
    background: #fff;
    cursor: pointer;
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .variant-option__button-label--card.selected,
  .variant-option__button-label--card:has(input:checked) {
    border-color: #1354c4;
    background-color: #fdfaf5;
  }

  .variant-card__badge.popular { background: #1354c4; }
  .variant-card__badge.free-bag { background: #0a1a4a; }

  .variant-card__title {
    font-weight: 700;
    font-size: 0.95rem;
    color: #0a1a4a;
  }
  .variant-card__sub-title {
    font-size: 0.52rem;
    color: #4e5875;
    margin-bottom: 6px;
    display: block;
  }
  .variant-card__img-wrap {
    height: 38px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .variant-card__img {
    height: 36px;
    object-fit: contain;
  }
  .variant-card__gift {
    font-size: 0.58rem;
    font-weight: 600;
    margin-top: 4px;
    color: #0a1a4a;
    display: block;
  }
  .variant-card__bottom-save-pill {
    position: absolute;
    bottom: -8px;
    left: 50%;
    transform: translateX(-50%);
    background: #1354c4;
    color: #fff;
    font-size: 7.5px;
    font-weight: 700;
    padding: 2px 6px;
    border-radius: 10px;
    white-space: nowrap;
  }

  /* Subscription Box Styles */
  .somna-custom-subscription-container {
    background-color: #dbeafe;
    border-radius: 16px;
    padding: 14px;
    font-family: var(--font-body--family);
    color: #0a1a4a;
    display: flex;
    flex-direction: column;
    gap: 10px;
    width: 100%;
    margin-top: 12px;
    box-sizing: border-box;
  }
  .somna-purchase-box {
    background: #fffdf9;
    border: 1.5px solid #cbd3d8;
    border-radius: 12px;
    overflow: hidden;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .somna-purchase-box.active {
    border-color: #1354c4;
    box-shadow: 0 0 0 1px #1354c4;
  }
  .somna-box-banner {
    background: #1354c4;
    color: #fff;
    font-size: 0.65rem;
    font-weight: 700;
    text-align: center;
    padding: 4px;
    letter-spacing: 0.05em;
  }
  .somna-box-inner {
    padding: 12px;
    position: relative;
  }
  .somna-box-top-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .somna-radio-label {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }
  .somna-radio-label input {
    position: absolute;
    opacity: 0;
  }
  .somna-radio-bullet {
    width: 16px;
    height: 16px;
    border: 2px solid #1354c4;
    border-radius: 50%;
    display: inline-block;
    position: relative;
  }
  .somna-purchase-box.active .somna-radio-bullet::after {
    content: '';
    position: absolute;
    top: 3px;
    left: 3px;
    width: 6px;
    height: 6px;
    background: #1354c4;
    border-radius: 50%;
  }
  .somna-title-stack {
    display: flex;
    flex-direction: column;
  }
  .somna-box-title {
