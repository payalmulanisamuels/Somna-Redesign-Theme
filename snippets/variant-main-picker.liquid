{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  # Custom styling applies to:
  #   - dropdowns + buttons when variant_style_class == 'custom' (unselected colors)
  #   - buttons only when selected_variant_style_class == 'custom' (selected colors)
  # The 'buttons' label is kept for backwards-compat of the class name.
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
          {%- liquid
  # Target the variant object for this option value
  assign current_variant = product_option_value.variant

  # Check if current option is Size / Quantity / Set
  assign option_name_downcase = product_option.name | downcase
  assign is_size_option = false
  if option_name_downcase contains 'size' or option_name_downcase contains 'quantity' or option_name_downcase contains 'set'
    assign is_size_option = true
  endif

  if is_size_option
    # Subscription / Selling Plan pricing
    assign has_selling_plan = false
    assign sub_price = current_variant.price
    assign one_time_price = current_variant.price

    for alloc in current_variant.selling_plan_allocations
      assign has_selling_plan = true
      assign sub_price = alloc.price
      assign one_time_price = alloc.compare_at_price | default: current_variant.price
      break
    endfor

    # Metafield fallbacks
    if current_variant.metafields.custom.subscription_price != blank
      assign sub_price = current_variant.metafields.custom.subscription_price.value
    endif
    if current_variant.metafields.custom.one_time_price != blank
      assign one_time_price = current_variant.metafields.custom.one_time_price.value
    endif
    assign duration_text = current_variant.metafields.custom.duration.value | default: current_variant.metafields.custom.subtitle.value
  endif
-%}

{%- if is_size_option -%}
  {% comment %} =========================================================
    SIZE / QUANTITY CARDS ONLY (with subscription and duration prices)
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label variant-option__button-label--card {% if product_option_value.name contains '2' %}most_popular{% endif %} {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
  >
    {% comment %} Badge {% endcomment %}
    {% if current_variant.metafields.custom.badge != blank %}
      <span class="variant-card__badge">{{ current_variant.metafields.custom.badge.value }}</span>
    {% elsif product_option_value.name contains '2' %}
      <span class="variant-card__badge">MOST POPULAR</span>
    {% endif %}

    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    <div class="variant-card__inner">
      {%- assign var_img = current_variant.metafields.custom.variant_image.value -%}
      {%- if var_img != blank -%}
        <div class="variant-card__image-wrapper">
          {{ var_img | image_url: width: 200 | image_tag: loading: 'lazy', class: 'variant-card__img' }}
        </div>
      {%- endif -%}
      <span class="variant-card__title">{{- product_option_value | escape -}}</span>
      <span class="variant-card__sub-price">{{ sub_price | money_without_trailing_zeros }}</span>
      <span class="variant-card__onetime-price">
      <span class="variant-card__onetime-price-inner">
        {{ one_time_price | money_without_trailing_zeros }} one-time
      </span>
  <span class="variant-card__duration">
        {% if duration_text != blank %}
          {{ duration_text }}
        {% else %}
          {% if forloop.index == 1 %}1 month{% elsif forloop.index == 2 %}2 months{% elsif forloop.index == 3 %}4 months{% endif %}
        {% endif %}
      </span>

      </span>
    
    </div>

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>

{%- else -%}
  {% comment %} =========================================================
    ALL OTHER OPTIONS (Color, Style, etc. remain standard)
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
  >
    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    {% if variant_style == 'swatch' %}
      {% liquid
        assign featured_media = product_option_value.variant.featured_media
        if featured_media == blank and product_option_value.product_url
          assign featured_media = product_option_value.variant.product.featured_media
        endif
      %}
      {% render 'swatch',
        swatch: product_option_value.swatch,
        variant_image: featured_media,
        mode: 'unscaled'
      %}
    {% else %}
      {% if product_option_value.available == true %}
        <span class="variant-option__button-label__pill" data-key="variant-option-pill"></span>
      {% endif %}
      <span class="variant-option__button-label__text" data-key="variant-option-text">
        {{- product_option_value  -}}
      </span>
    {% endif %}

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>
{%- endif -%}
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.5 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {%
            # There is an opportunity to build a custom select component that will allow us to style the select element further (animation for dropdown, swatches shown in the dropdown options, etc)
            # It's too bad as it mean rebuilding baked in behaviours but I think we've already done that for the locale selectors
            # in dawn. So it might mean more time spent in setting it up but worth it for future updates/styling.
          %}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              # (original width / original height) x new height (20px at the moment) = new width
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}



{% doc %}
  Renders a combined "Autoship & Save" / "One-time purchase" subscription widget,
  matching the merged size-card + subscription-box design.

  Replaces the app's "Subscription widget" block. Place this snippet directly
  below {% render 'variant-picker', ... %} inside the same product form.

  Assumptions (adjust to match your actual buy-buttons/product-form file):
    - The surrounding <form> has an id equal to `product_form_id` (Horizon default:
      "product-form-{{ section.id }}"). If yours differs, change the `form`
      attribute value on the hidden input near the bottom of this file.
    - The selling plan groups on this product are native Shopify selling plans
      (i.e. product.selling_plan_groups is populated) — true for the Shopify
      "Subscriptions" app.
    - The FIRST selling plan group returned is the one you want to offer here
      (e.g. "Subscribe & Save"). If you run multiple groups, filter/select
      accordingly below.

  @param {object} product_resource - The product object.
  @param {object} section - The section object.
  @param {string} [product_form_id] - The id of the surrounding <form>. Defaults
    to "product-form-{{ section.id }}" (Horizon convention).

  @example
  {% render 'variant-picker', product_resource: product, section: section, block: block, product: product %}
  {% render 'custom-subscription-box', product_resource: product, section: section %}
{% enddoc %}

{% liquid
  assign form_id = product_form_id | default: 'product-form-' | append: section.id
  assign current_variant = product_resource.selected_or_first_available_variant
  assign selling_plan_group = product_resource.selling_plan_groups.first
%}

{% if selling_plan_group %}
  <subscription-box
    class="subscription-box"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-form-id="{{ form_id }}"
  >
    {%- comment -%} ---- 10% off banner ---- {%- endcomment -%}
    <div class="subscription-box__banner">
      10% off your first order
    </div>

    <div class="subscription-box__options">

      {%- comment -%} ---- Autoship & Save ---- {%- endcomment -%}
      <label class="subscription-box__option subscription-box__option--subscribe" data-testid="subscription-option-subscribe">
        <input
          type="radio"
          name="subscription-purchase-type-{{ section.id }}"
          value="subscribe"
          checked
          ref="subscribeRadio"
        >
        <div class="subscription-box__option-content">
          <div class="subscription-box__option-row">
            <span class="subscription-box__option-title">Autoship &amp; Save</span>
            <span class="subscription-box__price" data-testid="subscription-price">
              {%- for selling_plan in selling_plan_group.selling_plans -%}
                {%- assign allocation = current_variant.selling_plan_allocations
                  | where: 'selling_plan.id', selling_plan.id
                  | first
                -%}
                {%- if allocation -%}
                  <span
                    class="subscription-box__price-value{% unless forloop.first %} hidden{% endunless %}"
                    data-selling-plan-id="{{ selling_plan.id }}"
                  >
                    {%- if allocation.compare_at_price and allocation.compare_at_price > allocation.price -%}
                      <s class="subscription-box__compare-price">{{ allocation.compare_at_price | money }}</s>
                    {%- endif -%}
                    {{ allocation.price | money }}
                  </span>
                {%- endif -%}
              {%- endfor -%}
            </span>
          </div>

          <ul class="subscription-box__benefits">
            <li>Same price, it never goes up</li>
            <li>Free shipping</li>
            <li>Free gifts included in every delivery</li>
            <li>Skip, pause, or cancel anytime</li>
          </ul>

          <div class="subscription-box__select-wrapper">
            <select
              class="subscription-box__frequency-select"
              ref="frequencySelect"
              aria-label="Delivery frequency"
            >
              {%- for selling_plan in selling_plan_group.selling_plans -%}
                <option value="{{ selling_plan.id }}">
                  {{ selling_plan.name }}
                </option>
              {%- endfor -%}
            </select>
            <svg aria-hidden="true" focusable="false" class="icon icon-caret" viewBox="0 0 10 6">
              {%- render 'icon', icon: 'caret' -%}
            </svg>
          </div>
        </div>
      </label>

      {%- comment -%} ---- One-time purchase ---- {%- endcomment -%}
      <label class="subscription-box__option subscription-box__option--onetime" data-testid="subscription-option-onetime">
        <input
          type="radio"
          name="subscription-purchase-type-{{ section.id }}"
          value="onetime"
          ref="onetimeRadio"
        >
        <div class="subscription-box__option-content subscription-box__option-content--row">
          <span class="subscription-box__option-title">One-time purchase</span>
          <span class="subscription-box__price" data-testid="onetime-price">
            {{ current_variant.price | money }}
          </span>
        </div>
      </label>

    </div>
  </subscription-box>

  {%- comment -%}
    Hidden input submitted with the add-to-cart form. `form` attribute binds it
    to the surrounding form even though this snippet renders outside it in the DOM.
  {%- endcomment -%}
  <input
    type="hidden"
    name="selling_plan"
    id="SellingPlan-{{ section.id }}"
    form="{{ form_id }}"
    value="{{ selling_plan_group.selling_plans.first.id }}"
  >

  <script>
    (function () {
      class SubscriptionBox extends HTMLElement {
        connectedCallback() {
          this.sellingPlanInput = document.getElementById(
            'SellingPlan-' + this.dataset.sectionId
          );
          this.subscribeRadio = this.querySelector('[ref="subscribeRadio"]');
          this.onetimeRadio = this.querySelector('[ref="onetimeRadio"]');
          this.frequencySelect = this.querySelector('[ref="frequencySelect"]');
          this.priceValues = this.querySelectorAll('.subscription-box__price-value');

          this.subscribeRadio.addEventListener('change', () => this.handlePurchaseTypeChange());
          this.onetimeRadio.addEventListener('change', () => this.handlePurchaseTypeChange());
          this.frequencySelect.addEventListener('change', () => this.handleFrequencyChange());

          // Keep the displayed subscription price in sync if the variant
          // picker swaps variants (listens for Horizon's variant change event;
          // rename to match your theme's actual event if different).
          document.addEventListener('variant:change', (event) => {
            if (event.detail && event.detail.productId == this.dataset.productId) {
              this.updatePriceForVariant(event.detail.variant);
            }
          });

          this.handlePurchaseTypeChange();
        }

        handlePurchaseTypeChange() {
          if (this.subscribeRadio.checked) {
            this.sellingPlanInput.value = this.frequencySelect.value;
          } else {
            this.sellingPlanInput.value = '';
          }
        }

        handleFrequencyChange() {
          const selectedId = this.frequencySelect.value;

          this.priceValues.forEach((el) => {
            el.classList.toggle('hidden', el.dataset.sellingPlanId !== selectedId);
          });

          if (this.subscribeRadio.checked) {
            this.sellingPlanInput.value = selectedId;
          }
        }

        updatePriceForVariant(variant) {
          // Optional: re-fetch/update allocation prices when the variant
          // changes. Left as a hook — wire up a fetch to
          // `${this.dataset.productUrl}?variant=${variant.id}` if your
          // subscription prices differ per variant and you need them
          // refreshed client-side without a full page reload.
        }
      }

      if (!customElements.get('subscription-box')) {
        customElements.define('subscription-box', SubscriptionBox);
      }
    })();
  </script>

  {% style %}
    .subscription-box {
      display: block;
      border: 1px solid rgb(var(--color-border));
      border-radius: var(--style-border-radius-outset, 8px);
      overflow: hidden;
      margin-block-start: 1rem;
    }

    .subscription-box__banner {
      background: rgb(var(--color-foreground));
      color: rgb(var(--color-background));
      text-align: center;
      font-weight: 600;
      font-size: 1.3rem;
      letter-spacing: 0.02em;
      padding: 0.8rem 1rem;
      text-transform: uppercase;
    }

    .subscription-box__options {
      display: flex;
      flex-direction: column;
    }

    .subscription-box__option {
      display: flex;
      align-items: flex-start;
      gap: 1rem;
      padding: 1.4rem;
      cursor: pointer;
      border-top: 1px solid rgb(var(--color-border));
    }

    .subscription-box__option:first-child {
      border-top: none;
    }

    .subscription-box__option input[type='radio'] {
      margin-top: 0.2rem;
      flex-shrink: 0;
    }

    .subscription-box__option-content {
      flex: 1;
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }

    .subscription-box__option-content--row {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .subscription-box__option-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.8rem;
    }

    .subscription-box__option-title {
      font-weight: 600;
    }

    .subscription-box__price {
      font-weight: 600;
      white-space: nowrap;
    }

    .subscription-box__price-value.hidden {
      display: none;
    }

    .subscription-box__compare-price {
      opacity: var(--opacity-subdued-text, 0.6);
      margin-inline-end: 0.4rem;
      font-weight: 400;
    }

    .subscription-box__benefits {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
      font-size: 1.3rem;
    }

    .subscription-box__benefits li {
      display: flex;
      align-items: center;
      gap: 0.6rem;
    }

    .subscription-box__benefits li::before {
      content: '✓';
      font-weight: 700;
      color: rgb(var(--color-foreground));
    }

    .subscription-box__select-wrapper {
      position: relative;
      display: flex;
      align-items: center;
    }

    .subscription-box__frequency-select {
      width: 100%;
      appearance: none;
      padding: 1rem 3rem 1rem 1.2rem;
      border: 1px solid rgb(var(--color-border));
      border-radius: var(--style-border-radius-inset, 6px);
      background: rgb(var(--color-background));
      font-size: 1.4rem;
    }

    .subscription-box__select-wrapper .icon-caret {
      position: absolute;
      right: 1.2rem;
      width: 1rem;
      pointer-events: none;
    }
  {% endstyle %}
{% endif %}
