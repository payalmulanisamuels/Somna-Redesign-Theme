{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{%- comment -%}
  Somna buybox (Figma "Purchase panel" 2707-3118 mobile / 2707-3220 desktop)
  - Review card: rating + count come from the custom.custom_review_rating_review_count
    product metafield (e.g. "4.6 <svg…> (248)"); the quote is set per product below.
  - Bundle card: shown for single-variant products (The Color Set, Season Bundle).
  Styles: assets/somna-buybox.css.
{%- endcomment -%}
{%- liquid
  assign somna_review_raw = product_resource.metafields.custom.custom_review_rating_review_count.value | default: '' | strip
  assign somna_rating = ''
  assign somna_review_count = ''
  if somna_review_raw != blank
    assign somna_rating = somna_review_raw | split: ' ' | first | strip
    if somna_review_raw contains '('
      assign somna_review_count = somna_review_raw | split: '(' | last | split: ')' | first | strip
    endif
  endif

  assign somna_quote = ''
  assign somna_bundle_title = ''
  assign somna_bundle_sub = ''
  case product_resource.handle
    when 'nasal-strips', 'mouth-tape'
      assign somna_quote = 'Comfortable all night and they actually stay put. — Jessica M.'
    when 'sleep-bundle'
      assign somna_quote = 'Love having both in one order — the blue looks so clean. — Ashley K.'
    when 'the-colour-set'
      assign somna_quote = 'Fun to switch colors depending on my mood. — Brittany L.'
      assign somna_bundle_title = '3 Bags · 90 nights'
      assign somna_bundle_sub = 'All three colors · Nasal Strips only'
    when 'season-bundle'
      assign somna_quote = 'Fun to switch colors depending on my mood. — Brittany L.'
      assign somna_bundle_title = '3 Months · 90 nights'
      assign somna_bundle_sub = '3 Black Strips + 3 Black Tape'
  endcase

  # The review card sits under the colour row when the first option is a colour (Sleep Bundle)
  assign somna_first_option = product_resource.options_with_values.first.name | downcase
  assign somna_review_after_color = false
  unless product_resource.has_only_default_variant
    if somna_first_option contains 'color' or somna_first_option contains 'colour'
      assign somna_review_after_color = true
    endif
  endunless
-%}
{%- capture somna_review_card -%}
  {%- if somna_rating != blank -%}
    <div class="somna-buybox-review">
      <div class="somna-buybox-review__top">
        <span class="somna-buybox-review__stars" aria-hidden="true">
          {%- for i in (1..5) -%}
            {%- liquid
              assign star_fill = somna_rating | times: 1.0 | minus: forloop.index0
              if star_fill >= 1
                assign star_pct = 100
              elsif star_fill <= 0
                assign star_pct = 0
              else
                assign star_pct = star_fill | times: 100 | round
              endif
            -%}
            <span class="somna-star" style="--fill: {{ star_pct }}%;">★</span>
          {%- endfor -%}
        </span>
        <span class="visually-hidden">Rated {{ somna_rating }} out of 5</span>
        <span class="somna-buybox-review__rating">{{ somna_rating }}</span>
        {%- if somna_review_count != blank -%}
          <span class="somna-buybox-review__count">· {{ somna_review_count }} reviews</span>
        {%- endif -%}
      </div>
      {%- if somna_quote != blank -%}
        <p class="somna-buybox-review__quote">{{ somna_quote }}</p>
      {%- endif -%}
    </div>
  {%- endif -%}
{%- endcapture -%}

{% unless product_resource.has_only_default_variant %}
  {% unless somna_review_after_color %}{{ somna_review_card }}{% endunless %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker somna-buybox-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
        --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
        --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
      {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif

          # Somna: Color / Colour option renders as round color swatches
          assign option_name_check = product_option.name | downcase
          assign is_color_option = false
          if option_name_check contains 'color' or option_name_check contains 'colour'
            assign is_color_option = true
          endif
        -%}

        {%- if is_color_option -%}
          {% comment %} =========================================================
            SOMNA COLOR SWATCHES  ("Color: Blue"  ● ● ●)
          ========================================================= {% endcomment %}
          <fieldset
            class="variant-option somna-color-option"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
          >
            <legend class="visually-hidden">{{ product_option.name | escape }}</legend>
            <div class="somna-color-option__label" aria-hidden="true">
              {{ product_option.name | escape }}: <strong>{{ product_option.selected_value | escape }}</strong>
            </div>
            <div class="somna-color-option__swatches">
              {%- for product_option_value in product_option.values -%}
                {%- liquid
                  assign swatch_value_name = product_option_value.name | downcase
                  assign swatch_bg = ''
                  if product_option_value.swatch.image
                    assign swatch_bg = product_option_value.swatch.image | image_url: width: 80 | prepend: 'url(' | append: ') center / cover'
                  elsif product_option_value.swatch.color
                    assign swatch_bg = 'rgb(' | append: product_option_value.swatch.color.rgb | append: ')'
                  elsif swatch_value_name contains 'blue'
                    assign swatch_bg = '#306ff9'
                  elsif swatch_value_name contains 'red'
                    assign swatch_bg = '#ff0a0a'
                  elsif swatch_value_name contains 'black'
                    assign swatch_bg = '#242424'
                  endif
                -%}
                <label
                  class="somna-color-swatch{% if product_option_value.available == false %} somna-color-swatch--unavailable{% endif %}"
                  title="{{ product_option_value.name | escape }}"
                  style="{% if swatch_bg != blank %}--somna-swatch: {{ swatch_bg }};{% endif %}"
                >
                  <input
                    type="radio"
                    name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
                    value="{{ product_option_value | escape }}"
                    aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
                    {% if product_option_value.available == false %}
                      aria-disabled="true"
                    {% endif %}
                    data-previous-checked="false"
                    data-fieldset-index="{{ fieldset_index }}"
                    data-input-index="{{ forloop.index0 }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-option-available="{{ product_option_value.available }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.variant.id %}
                      data-variant-id="{{ product_option_value.variant.id }}"
                    {% endif %}
                    {% if product_option_value.selected %}
                      data-current-checked="true"
                      checked
                    {% else %}
                      data-current-checked="false"
                    {% endif %}
                  >
                  <span class="somna-color-swatch__dot" aria-hidden="true">
                    <svg class="somna-color-swatch__check" viewBox="0 0 14 11" fill="none">
                      <path d="M1.5 5.5L5.25 9.25L12.5 1.75" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </span>
                </label>
              {%- endfor -%}
            </div>
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
          {%- if somna_review_after_color and forloop.first -%}{{ somna_review_card }}{%- endif -%}
        {%- elsif product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
          {%- liquid
  # Target the variant object for this option value
  assign current_variant = product_option_value.variant

  # Check if current option is Size / Quantity / Set
  assign option_name_downcase = product_option.name | downcase
  assign is_size_option = false
  if option_name_downcase contains 'size' or option_name_downcase contains 'quantity' or option_name_downcase contains 'set'
    assign is_size_option = true
  endif

  if is_size_option
    # Subscription / Selling Plan pricing
    assign has_selling_plan = false
    assign sub_price = current_variant.price
    assign one_time_price = current_variant.price

    for alloc in current_variant.selling_plan_allocations
      assign has_selling_plan = true
      assign sub_price = alloc.price
      assign one_time_price = alloc.compare_at_price | default: current_variant.price
      break
    endfor

    # Metafield fallbacks
    if current_variant.metafields.custom.subscription_price != blank
      assign sub_price = current_variant.metafields.custom.subscription_price.value
    endif
    if current_variant.metafields.custom.one_time_price != blank
      assign one_time_price = current_variant.metafields.custom.one_time_price.value
    endif
    assign duration_text = current_variant.metafields.custom.duration.value | default: current_variant.metafields.custom.subtitle.value

    # Nights calculation for per-night dynamic pricing
    assign nights_count = 30
    if forloop.index == 2
      assign nights_count = 60
    elsif forloop.index >= 3
      assign nights_count = 120
    endif

    # Somna: "2 Bags" is the default on page load, unless the URL already picks a variant (?variant=).
    assign is_default_size = false
    assign value_start = product_option_value.name | downcase | strip | slice: 0, 5
    if value_start == '2 bag' and product.selected_variant == blank and product.id == product_resource.id and product_option_value.selected == false and product_option_value.available
      assign is_default_size = true
    endif
  endif
-%}

{%- if is_size_option -%}
  {% comment %} =========================================================
    SIZE / QUANTITY CARDS (DYNAMIC DATA ATTRIBUTES ENABLED)
  ========================================================= {% endcomment %}
  {%- liquid
    # Somna buybox: price per night (Autoship price vs one-time price), savings and badge wording
    assign somna_night_price = sub_price | times: 1.0 | divided_by: nights_count | round
    assign somna_night_regular = one_time_price | times: 1.0 | divided_by: nights_count | round
    assign somna_save_pct = 0
    if one_time_price > sub_price
      assign somna_save_pct = one_time_price | minus: sub_price | times: 100.0 | divided_by: one_time_price | round
    endif
    assign somna_unit = 'bag'
    assign somna_value_lc = product_option_value.name | downcase
    if somna_value_lc contains 'set'
      assign somna_unit = 'set'
    endif
  -%}
  <label
    class="variant-option__button-label variant-option__button-label--card somna-tier {% if forloop.index == 2 %}most_popular{% endif %} {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
    data-sub-formatted="{{ sub_price | money_without_trailing_zeros }}"
    data-onetime-formatted="{{ one_time_price | money_without_trailing_zeros }}"
    data-sub-numeric="{{ sub_price | divided_by: 100.0 }}"
    data-onetime-numeric="{{ one_time_price | divided_by: 100.0 }}"
    data-nights="{{ nights_count }}"
  >
    {% comment %} Top badges (Figma: Try it / Most popular / Best value) {% endcomment %}
    {% if forloop.index == 1 %}
      <span class="variant-card__badge somna-tier__badge">Try it</span>
    {% elsif forloop.index == 2 %}
      <span class="variant-card__badge popular somna-tier__badge somna-tier__badge--popular">Most popular</span>
    {% else %}
      <span class="variant-card__badge free-bag somna-tier__badge">Best value</span>
    {% endif %}

    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if is_default_size %}
        data-somna-default-size
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    <div class="variant-card__inner">
      <span class="variant-card__title">{{- product_option_value | escape -}}</span>
      <span class="variant-card__sub-title">{{ nights_count }} nights</span>
      <div class="variant-card__img-wrap">
        {%- assign var_img = current_variant.metafields.custom.variant_image.value | default: product.featured_image -%}
        {%- if var_img != blank -%}
          {{ var_img | image_url: width: 200 | image_tag: loading: 'lazy', class: 'variant-card__img' }}
        {%- endif -%}
      </div>

      <span class="somna-tier__price">
        <span class="somna-tier__night">{{ somna_night_price | money }}/night</span>
        {%- if somna_night_regular > somna_night_price -%}
          <s class="somna-tier__was">{{ somna_night_regular | money }}</s>
        {%- endif -%}
      </span>

      {% if forloop.index == 1 %}
        <span class="variant-card__gift somna-tier__perk somna-tier__perk--muted"><svg class="somna-tier__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M2 6.5h11.5v9.5H2z"/><path d="M13.5 9.5h4l3 3.2V16h-7"/><circle cx="6" cy="17.3" r="1.7"/><circle cx="17" cy="17.3" r="1.7"/></g></svg>Free shipping</span>
      {% else %}
        <span class="variant-card__gift somna-tier__perk"><svg class="somna-tier__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="currentColor" stroke="none"><path d="M20 7h-2.18A3 3 0 0 0 12 3.76 3 3 0 0 0 6.18 7H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h7.25V7h1.5v5H20a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1ZM9 7a1.25 1.25 0 1 1 1.25-1.25V7H9Zm6 0h-1.25V5.75A1.25 1.25 0 1 1 15 7ZM4 13.5V20a1 1 0 0 0 1 1h6.25v-7.5H4Zm8.75 7.5H19a1 1 0 0 0 1-1v-6.5h-7.25V21Z"/></g></svg>+3 free gifts</span>
      {% endif %}
    </div>

    {% comment %} Bottom pills (Figma: SAVE 33% / 4th bag free) {% endcomment %}
    {% if forloop.index == 2 and somna_save_pct > 0 %}
      <span class="variant-card__bottom-save-pill somna-tier__pill">SAVE {{ somna_save_pct }}%</span>
    {% elsif forloop.index >= 3 %}
      <span class="variant-card__bottom-save-pill somna-tier__pill">4th {{ somna_unit }} free</span>
    {% endif %}

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>

{%- else -%}
  {% comment %} =========================================================
    ALL OTHER OPTIONS (Color, Style, etc.)
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
  >
    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    {% if variant_style == 'swatch' %}
      {% liquid
        assign featured_media = product_option_value.variant.featured_media
        if featured_media == blank and product_option_value.product_url
          assign featured_media = product_option_value.variant.product.featured_media
        endif
      %}
      {% render 'swatch',
        swatch: product_option_value.swatch,
        variant_image: featured_media,
        mode: 'unscaled'
      %}
    {% else %}
      {% if product_option_value.available == true %}
        <span class="variant-option__button-label__pill" data-key="variant-option-pill"></span>
      {% endif %}
      <span class="variant-option__button-label__text" data-key="variant-option-text">
        {{- product_option_value  -}}
      </span>
    {% endif %}

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>
{%- endif -%}
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.5 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          {% liquid
            assign property_being_updated = false
            if settings.variant_swatch_width != settings.variant_swatch_height
              assign property_being_updated = true
              assign new_width = settings.variant_swatch_width | times: 1.0 | divided_by: settings.variant_swatch_height | times: 20
            endif
          %}

          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div
              class="variant-option__select-wrapper"
              style="
                {%- if property_being_updated  -%}
                  --variant-picker-swatch-width: clamp(10px,{{ new_width }}px, 50px);
                {%- endif -%}
              "
            >
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {% if product_option_value.available == false %}
                      {{ product_option_value | escape }} - {{ 'content.unavailable' | t }}
                    {% else %}
                      {{ product_option_value | escape }}
                    {% endif %}
                  </option>
                {%- endfor -%}
              </select>
              <svg
                aria-hidden="true"
                focusable="false"
                class="icon icon-caret"
                viewBox="0 0 10 6"
              >
                {%- render 'icon', icon: 'caret' -%}
              </svg>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}

      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{%- if product_resource.has_only_default_variant -%}
  {%- liquid
    assign somna_bundle_variant = product_resource.selected_or_first_available_variant
    assign somna_bundle_nights = product_resource.metafields.custom.nights.value | default: 30 | plus: 0
    if somna_bundle_variant.metafields.custom.nights != blank
      assign somna_bundle_nights = somna_bundle_variant.metafields.custom.nights.value | plus: 0
    endif
    assign somna_bundle_sub_price = somna_bundle_variant.price
    assign somna_bundle_regular = somna_bundle_variant.price
    for alloc in somna_bundle_variant.selling_plan_allocations
      assign somna_bundle_sub_price = alloc.price
      assign somna_bundle_regular = alloc.compare_at_price | default: somna_bundle_variant.price
      break
    endfor
    assign somna_bundle_night = somna_bundle_sub_price | times: 1.0 | divided_by: somna_bundle_nights | round
    assign somna_bundle_night_regular = somna_bundle_regular | times: 1.0 | divided_by: somna_bundle_nights | round
    if somna_bundle_title == blank
      assign somna_bundle_title = somna_bundle_nights | append: ' nights'
    endif
    assign somna_bundle_image = somna_bundle_variant.metafields.custom.variant_image.value | default: product_resource.featured_image
  -%}
  {{ somna_review_card }}
  <div class="somna-bundle-card">
    {%- if somna_bundle_image != blank -%}
      <div class="somna-bundle-card__media">
        {{ somna_bundle_image | image_url: width: 300 | image_tag: loading: 'lazy', class: 'somna-bundle-card__img', alt: product_resource.title }}
      </div>
    {%- endif -%}
    <div class="somna-bundle-card__body">
      <p class="somna-bundle-card__title">{{ somna_bundle_title }}</p>
      {%- if somna_bundle_sub != blank -%}
        <p class="somna-bundle-card__sub">{{ somna_bundle_sub }}</p>
      {%- endif -%}
      <p class="somna-tier__price">
        <span class="somna-tier__night">{{ somna_bundle_night | money }}/night</span>
        {%- if somna_bundle_night_regular > somna_bundle_night -%}
          <s class="somna-tier__was">{{ somna_bundle_night_regular | money }}</s>
        {%- endif -%}
      </p>
      <p class="somna-tier__perk"><svg class="somna-tier__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="currentColor" stroke="none"><path d="M20 7h-2.18A3 3 0 0 0 12 3.76 3 3 0 0 0 6.18 7H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h7.25V7h1.5v5H20a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1ZM9 7a1.25 1.25 0 1 1 1.25-1.25V7H9Zm6 0h-1.25V5.75A1.25 1.25 0 1 1 15 7ZM4 13.5V20a1 1 0 0 0 1 1h6.25v-7.5H4Zm8.75 7.5H19a1 1 0 0 0 1-1v-6.5h-7.25V21Z"/></g></svg>+3 free gifts</p>
    </div>
  </div>
{%- endif -%}

{% render 'somna-subscription-widget', product_resource: product_resource, section: section %}

{%- comment -%}
  Somna: select "2 Bags" once on page load (only when the URL has no ?variant=).
  Clicking the real radio runs the normal variant change, so prices, the subscription
  widget, the sticky bar and the URL all update. The customer can change it afterwards.
  Placed after the widget so its listeners are set up before the click.
{%- endcomment -%}
{%- unless product_resource.has_only_default_variant -%}
  <script>
    (() => {
      const selectDefaultSize = () => {
        const input = document.querySelector(
          'variant-picker[data-section-id="{{ section.id }}"][data-block-id="{{ block.id }}"] input[data-somna-default-size]'
        );
        if (!input || input.checked || input.dataset.somnaDefaultDone) return;
        input.dataset.somnaDefaultDone = 'true';
        input.click();
      };
      const run = () => customElements.whenDefined('variant-picker').then(selectDefaultSize);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    })();
  </script>
{%- endunless -%}
 

