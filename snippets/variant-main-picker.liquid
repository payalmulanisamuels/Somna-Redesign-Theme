{%- doc -%}
  Renders a default variant picker, used to display the variant picker in the variants block.

  @param {object} product_resource - The product object.
  @param {object} [block] - The block object
  @param {object} section - The section object.
  @param {object} product - The current product object (used to determine selected variant state).
{%- enddoc -%}

{% assign block_settings = block.settings %}

{% liquid
  assign has_custom_variant_buttons = false
  if block_settings.variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  if block_settings.variant_style == 'buttons' and block_settings.selected_variant_style_class == 'custom'
    assign has_custom_variant_buttons = true
  endif
  assign fieldset_index = 0
%}

{% unless product_resource.has_only_default_variant %}
  {% if has_custom_variant_buttons %}
    {% render 'variant-button-custom-styles', block_settings: block_settings, block_id: block.id %}
  {% endif %}
  <variant-picker
    class="variant-picker spacing-style variant-picker--{{ block_settings.alignment }}{% if has_custom_variant_buttons %} variant-picker--custom-{{ block.id }}{% endif %}"
    style="
      {% render 'spacing-style', settings: block_settings %}
       {% if block_settings.option_label_text_color != blank %}
         --variant-option-label-color: rgba({{ block_settings.option_label_text_color.rgba }});
         --variant-option-label-color-subdued: rgba({{ block_settings.option_label_text_color.rgb }} / var(--opacity-subdued-text));
       {% endif %}
    "
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-handle="{{ product_resource.handle }}"
    data-product-title="{{ product_resource.title | escape }}"
    data-block-id="{{ block.id }}"
    data-product-url="{{ product_resource.url }}"
    ref="mainVariantPicker"
    {% if product.id == product_resource.id %}
      data-template-product-match="true"
    {% endif %}
    {{ block.shopify_attributes }}
    {% if request.visual_preview_mode %}
      data-shopify-visual-preview
    {% endif %}
  >
    <form class="variant-picker__form">
      {%- for product_option in product_resource.options_with_values -%}
        {%- liquid
          assign swatch_count = product_option.values | map: 'swatch' | compact | size
          assign variant_style = block_settings.variant_style

          if swatch_count > 0 and block_settings.show_swatches
            if block_settings.variant_style == 'dropdown'
              assign variant_style = 'swatch_dropdown'
            else
              assign variant_style = 'swatch'
            endif
          endif

          if variant_style == 'buttons' and settings.variant_button_width == 'equal-width-buttons'
            assign fieldset_id = section.id | append: '-' | append: product_resource.id | append: '-' | append: product_option.name | handleize
            assign option_id_attribute = 'data-option-id="' | append: fieldset_id | append: '"'
            assign longest_value = 0
          endif
        -%}

        {%- if product_option.values.size == 1 and variant_style != 'swatch' -%}
          <div
            class="variant-option"
            data-testid="variant-option-single"
          >
            {{- product_option.name | escape -}}
            <span
              class="variant-option__swatch-value"
              data-testid="variant-option-single-value"
            >
              {{- product_option.selected_value -}}
            </span>
          </div>
        {%- elsif variant_style == 'swatch' or block_settings.variant_style == 'buttons' -%}
          <fieldset
            class="variant-option variant-option--buttons{% if variant_style == 'swatch' %} variant-option--swatches{% else %} variant-option--{{ settings.variant_button_width }}{% endif %}"
            data-fieldset-index="{{ fieldset_index }}"
            ref="fieldsets[]"
            {{ option_id_attribute }}
          >
            <legend>
              {{ product_option.name | escape -}}
              {%- if variant_style == 'swatch' -%}
                <span class="variant-option__swatch-value">{{ product_option.selected_value }}</span>
              {%- endif %}
            </legend>
            {%- for product_option_value in product_option.values -%}
              {% if product_option_value.size > longest_value and option_id_attribute %}
                {% assign longest_value = product_option_value.size %}
              {% endif %}
          {%- liquid
  # Target the variant object for this option value
  assign current_variant = product_option_value.variant

  # Check if current option is Size / Quantity / Set
  assign option_name_downcase = product_option.name | downcase
  assign is_size_option = false
  if option_name_downcase contains 'size' or option_name_downcase contains 'quantity' or option_name_downcase contains 'set'
    assign is_size_option = true
  endif

  if is_size_option
    # Subscription / Selling Plan pricing
    assign has_selling_plan = false
    assign sub_price = current_variant.price
    assign one_time_price = current_variant.price

    for alloc in current_variant.selling_plan_allocations
      assign has_selling_plan = true
      assign sub_price = alloc.price
      assign one_time_price = alloc.compare_at_price | default: current_variant.price
      break
    endfor

    # Metafield fallbacks
    if current_variant.metafields.custom.subscription_price != blank
      assign sub_price = current_variant.metafields.custom.subscription_price.value
    endif
    if current_variant.metafields.custom.one_time_price != blank
      assign one_time_price = current_variant.metafields.custom.one_time_price.value
    endif
    assign duration_text = current_variant.metafields.custom.duration.value | default: current_variant.metafields.custom.subtitle.value
  endif
-%}

{%- if is_size_option -%}
  {% comment %} =========================================================
    SIZE / QUANTITY CARDS ONLY
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label variant-option__button-label--card {% if product_option_value.name contains '2' %}most_popular{% endif %} {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
  >
    {% if current_variant.metafields.custom.badge != blank %}
      <span class="variant-card__badge">{{ current_variant.metafields.custom.badge.value }}</span>
    {% elsif product_option_value.name contains '2' %}
      <span class="variant-card__badge">MOST POPULAR</span>
    {% endif %}

    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    <div class="variant-card__inner">
      {%- assign var_img = current_variant.metafields.custom.variant_image.value -%}
      {%- if var_img != blank -%}
        <div class="variant-card__image-wrapper">
          {{ var_img | image_url: width: 200 | image_tag: loading: 'lazy', class: 'variant-card__img' }}
        </div>
      {%- endif -%}
      <span class="variant-card__title">{{- product_option_value | escape -}}</span>
      <span class="variant-card__sub-price">{{ sub_price | money_without_trailing_zeros }}</span>
      <span class="variant-card__onetime-price">
      <span class="variant-card__onetime-price-inner">
        {{ one_time_price | money_without_trailing_zeros }} one-time
      </span>
      <span class="variant-card__duration">
        {% if duration_text != blank %}
          {{ duration_text }}
        {% else %}
          {% if forloop.index == 1 %}1 month{% elsif forloop.index == 2 %}2 months{% elsif forloop.index == 3 %}4 months{% endif %}
        {% endif %}
      </span>
      </span>
    </div>
    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>

{%- else -%}
  {% comment %} =========================================================
    ALL OTHER OPTIONS (Color, Style, etc.)
  ========================================================= {% endcomment %}
  <label
    class="variant-option__button-label {% if variant_style == 'swatch' %} variant-option__button-label--has-swatch{% endif %}"
  >
    <input
      type="radio"
      name="{{ product_option.name | escape }}-{{ block.id }}-{{ product_resource.id }}"
      value="{{ product_option_value | escape }}"
      aria-label="{{ product_option_value.name | escape }}{% if product_option_value.available == false %} - {{ 'products.product.sold_out' | t }}{% endif %}"
      {% if product_option_value.available == false %}
        aria-disabled="true"
      {% endif %}
      data-previous-checked="false"
      data-fieldset-index="{{ fieldset_index }}"
      data-input-index="{{ forloop.index0 }}"
      data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
      data-option-name="{{ product_option.name | escape }}"
      data-option-value-id="{{ product_option_value.id }}"
      data-option-available="{{ product_option_value.available }}"
      data-connected-product-url="{{ product_option_value.product_url }}"
      {% if product_option_value.variant.id %}
        data-variant-id="{{ product_option_value.variant.id }}"
      {% endif %}
      {% if product_option_value.selected %}
        data-current-checked="true"
        checked
      {% else %}
        data-current-checked="false"
      {% endif %}
    >

    {% if variant_style == 'swatch' %}
      {% liquid
        assign featured_media = product_option_value.variant.featured_media
        if featured_media == blank and product_option_value.product_url
          assign featured_media = product_option_value.variant.product.featured_media
        endif
      %}
      {% render 'swatch',
        swatch: product_option_value.swatch,
        variant_image: featured_media,
        mode: 'unscaled'
      %}
    {% else %}
      {% if product_option_value.available == true %}
        <span class="variant-option__button-label__pill" data-key="variant-option-pill"></span>
      {% endif %}
      <span class="variant-option__button-label__text" data-key="variant-option-text">
        {{- product_option_value  -}}
      </span>
    {% endif %}

    {% render 'strikethrough-variant', product_option: product_option_value %}
  </label>
{%- endif -%}
            {%- endfor -%}
            {% if option_id_attribute %}
              {% style %}
                [data-option-id="{{ fieldset_id }}"] {
                  --variant-ch: {{ longest_value | times: 0.5 }}em;
                }
              {% endstyle %}
            {% endif %}
          </fieldset>
          {%- assign fieldset_index = fieldset_index | plus: 1 -%}
        {%- elsif block_settings.variant_style == 'dropdowns' -%}
          <div class="variant-option variant-option--dropdowns">
            <label for="Option-{{ block.id }}-{{ forloop.index0 }}">{{ product_option.name | escape }}</label>
            <div class="variant-option__select-wrapper">
              <select
                id="Option-{{ block.id }}-{{ forloop.index0 }}"
                name="options[{{ product_option.name | escape }}]"
                class="variant-option__select"
              >
                {%- for product_option_value in product_option.values -%}
                  <option
                    value="{{ product_option_value | escape }}"
                    data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
                    data-option-name="{{ product_option.name | escape }}"
                    data-option-value-id="{{ product_option_value.id }}"
                    data-variant-id="{{ product_option_value.variant.id }}"
                    data-connected-product-url="{{ product_option_value.product_url }}"
                    {% if product_option_value.selected %}
                      selected="selected"
                    {% endif %}
                  >
                    {{ product_option_value | escape }}
                  </option>
                {%- endfor -%}
              </select>
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
      <script type="application/json">
        {{ product_resource.selected_or_first_available_variant | json }}
      </script>
    </form>
  </variant-picker>
{% endunless %}

{% comment %} =========================================================
  CUSTOM SUBSCRIPTION & SAVE / ONE-TIME BOXES (SEPARATE CONTAINER)
========================================================= {% endcomment %}
<div class="custom-subscription-container">
  <!-- Subscribe and Save Box -->
  <div class="cs-purchase-box active" data-purchase-card="subscribe">
    <div class="cs-box-header">
      <strong>Subscribe and save</strong>
    </div>
    <div class="cs-radio-group">
      <label class="cs-radio-row">
        <input type="radio" name="purchase_type_selection" value="sub_monthly" checked>
        <span class="cs-label-text">Deliver every month, 10% off</span>
        <span class="cs-price-text">$135.00 USD</span>
      </label>
      <label class="cs-radio-row">
        <input type="radio" name="purchase_type_selection" value="sub_2months">
        <span class="cs-label-text">Deliver every 2 months, 10% off</span>
        <span class="cs-price-text">$135.00 USD</span>
      </label>
      <label class="cs-radio-row">
        <input type="radio" name="purchase_type_selection" value="sub_4months">
        <span class="cs-label-text">Deliver every 4 months, 10% off</span>
        <span class="cs-price-text">$135.00 USD</span>
      </label>
    </div>
  </div>

  <!-- One-Time Purchase Box -->
  <div class="cs-purchase-box" data-purchase-card="onetime">
    <label class="cs-radio-row cs-onetime-row">
      <input type="radio" name="purchase_type_selection" value="onetime">
      <span class="cs-label-text"><strong>One-time purchase</strong></span>
      <span class="cs-price-text">$150.00 USD</span>
    </label>
  </div>

  <div class="cs-footer-note">
    Auto-renews, skip or cancel anytime.
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const purchaseBoxes = document.querySelectorAll('.cs-purchase-box');
    purchaseBoxes.forEach(box => {
      box.addEventListener('click', () => {
        purchaseBoxes.forEach(b => b.classList.remove('active'));
        box.classList.add('active');
        const radio = box.querySelector('input[type="radio"]');
        if (radio) radio.checked = true;
      });
    });
  });
</script>

<style>
  .custom-subscription-container {
    font-family: var(--font-body--family);
    color: #0a1a4a;
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: 100%;
    margin-top: 16px;
  }
  .cs-purchase-box {
    border: 1.5px solid #cbd3d8;
    border-radius: 12px;
    padding: 14px;
    background: #fff;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .cs-purchase-box.active {
    border-color: #071a4b;
    box-shadow: 0 0 0 1px #071a4b;
  }
  .cs-box-header {
    font-size: 0.9rem;
    margin-bottom: 10px;
  }
  .cs-radio-group {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .cs-radio-row {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.82rem;
    cursor: pointer;
  }
  .cs-onetime-row {
    margin: 0;
  }
  .cs-label-text {
    flex: 1;
    font-weight: 500;
  }
  .cs-price-text {
    font-weight: 600;
  }
  .cs-footer-note {
    font-size: 0.75rem;
    color: #4e5875;
    margin-top: 4px;
  }
</style>

{% render 'swatch-styles' %}
{% render 'variant-picker-styles' %}