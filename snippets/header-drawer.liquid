{%- doc -%}
  Renders a header drawer menu triggered by the top details element.

-   @param {object} linklist The linklist to render
-   @param {string} [class] Additional classes to add to the drawer
-   @param {string} [data_header_drawer_type] The type of header drawer to render
-   @param {object} [block] The block that can be used to provide settings
-   @param {object} [section] The section that can be used to provide settings

  @example
  {% render 'header-drawer', linklist: section.settings.menu, class: 'header-drawer--mobile' %}
{%- enddoc -%}

{% render 'summary-icon-styles' %}

{% liquid
  assign block_settings = block.settings
  assign max_featured_items = 4
  assign image_border_radius = block_settings.image_border_radius

  if block_settings.menu_style == 'featured_collections'
    assign ratio = block_settings.featured_collections_aspect_ratio
  elsif block_settings.menu_style == 'featured_products'
    assign ratio = block_settings.featured_products_aspect_ratio
  endif

  assign eager_loading = false
  if section.index == blank
    assign eager_loading = true
  endif

  if block_settings.background_color != blank or block_settings.text_color != blank
    render 'contrast-override', background_color: block_settings.background_color, text_color: block_settings.text_color, section_id: block.id
  endif
%}

<script
  src="{{ 'header-drawer.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

<header-drawer
  class="header-drawer {{ class }}"
  style="--menu-image-border-radius: {{ image_border_radius }}px; --resource-card-corner-radius: {{ image_border_radius }}px;"
>
  <details
    id="Details-menu-drawer-container"
    data-skip-node-update="true"
    class="menu-drawer-container"
    ref="details"
    scroll-lock
  >
    <summary
      class="header__icon header__icon--menu header__icon--summary"
      aria-label="{{ 'accessibility.menu' | t }}"
      on:click="/toggle"
    >
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--open">
        {{- 'icon-menu.svg' | inline_asset_content -}}
      </span>
      <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
        {{- 'icon-close-menu.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div
      ref="menuDrawer"
      class="
        menu-drawer
        {% if block_settings.background_color != blank or block_settings.text_color != blank %}
          color-custom-{{ block.id }}
        {% endif %}
      "
    >
      <button
        class="button close-button menu-drawer__close-button focus-inset"
        type="button"
        aria-label="{{ 'actions.close' | t }}"
        on:click="/close"
      >
        <span class="svg-wrapper header-drawer-icon header-drawer-icon--close">
          {{- 'icon-close-menu.svg' | inline_asset_content -}}
        </span>
      </button>

      <!-- CUSTOM TOP BANNER: BESTSELLERS -->
      {%- if block_settings.bestseller_heading != blank -%}
        <div class="menu-drawer__bestsellers-header">
          <h2 class="menu-drawer__section-title">{{ block_settings.bestseller_heading }}</h2>
          {%- if block_settings.bestseller_link != blank -%}
            <a href="{{ block_settings.bestseller_link }}" class="menu-drawer__view-all">View all</a>
          {%- endif -%}
        </div>
      {%- endif -%}

      <nav
        class="menu-drawer__navigation"
        style="
          {%- render 'menu-font-styles', settings: block_settings, menu_type: 'drawer' %}
          {%- render 'submenu-font-styles', settings: block_settings %}
        "
        aria-label="{{ 'accessibility.header_navigation_label' | t }}"
      >
        <ul
          class="menu-drawer__menu has-submenu"
          role="list"
        >
          {%- for link in linklist.links -%}
            <li class="menu-drawer__list-item {% if block_settings.drawer_dividers %} menu-drawer__list-item--divider{% endif %}">
              <a
                href="{{ link.url }}"
                class="menu-drawer__menu-item menu-drawer__menu-item--mainlist"
              >
                <span class="menu-drawer__menu-item-text wrap-text">{{ link.title | escape }}</span>
                <span class="svg-wrapper icon-caret icon-caret--forward">
                  {{- 'icon-caret.svg' | inline_asset_content -}}
                </span>
              </a>
            </li>
          {%- endfor -%}
        </ul>
      </nav>

      <!-- CUSTOM MIDDLE BANNER: FIND YOUR BUNDLE -->
      {%- if block_settings.show_bundle_section -%}
        <div class="menu-drawer__bundle-banner">
          <h3 class="menu-drawer__bundle-title">{{ block_settings.bundle_title }}</h3>
          <!-- Insert bundle grid layout here matching screenshot product cards -->
        </div>
      {%- endif -%}

      <!-- FOOTER ACCOUNT & MEMBERSHIP -->
      <div class="menu-drawer__utility-links">
        <a href="{{ routes.account_register_url }}" class="menu-drawer__account-button">
          <span class="svg-wrapper">{%- render 'icon-account.svg' -%}</span>
          <span>{{ block_settings.account_text }} &rarr;</span>
        </a>
        <div class="menu-drawer__signin-text">
          {{ block_settings.signin_subtext }} <a href="{{ routes.account_login_url }}">Sign in</a>
        </div>
      </div>

    </div>
    <div
      class="menu-drawer__backdrop"
      on:click="header-drawer/close"
    ></div>
  </details>
</header-drawer>

{% stylesheet %}
  /* Custom Drawer Layout Improvements matching Screenshot style */
  .menu-drawer {
    background-color: #FBF7EE; /* Warm cream background from screenshot */
  }
  .menu-drawer__bestsellers-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: var(--padding-md) var(--padding-xl);
  }
  .menu-drawer__section-title {
    font-size: 1.8rem;
    font-weight: 600;
    color: #1D2A44;
  }
  .menu-drawer__view-all {
    font-size: 1.4rem;
    color: #1D2A44;
    text-decoration: underline;
  }
  .menu-drawer__bundle-banner {
    background: linear-gradient(180deg, rgba(214,228,247,0.4) 0%, rgba(245,231,195,0.4) 100%);
    padding: var(--padding-lg) var(--padding-xl);
    margin: var(--margin-md) 0;
  }
  .menu-drawer__bundle-title {
    font-family: serif;
    font-size: 2rem;
    font-style: italic;
    color: #1D2A44;
    margin-bottom: var(--margin-sm);
  }
  .menu-drawer__utility-links {
    text-align: center;
    padding: var(--padding-xl);
    background-color: #F4E2A7; /* Yellow bottom wrapper background */
    margin-top: auto;
  }
  .menu-drawer__account-button {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
    color: #1D2A44;
    text-decoration: none;
    margin-bottom: 8px;
  }
  .menu-drawer__signin-text {
    font-size: 1.3rem;
    color: #4A5568;
  }
  .menu-drawer__signin-text a {
    text-decoration: underline;
    color: #1D2A44;
    font-weight: 500;
  }
{% endstylesheet %}