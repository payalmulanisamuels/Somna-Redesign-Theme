{%- liquid
  assign has_strips = false
  assign has_tape = false
  assign matched_upsell_product = blank
  assign matched_tag = 'Complete the ritual'
  assign matched_desc = 'Pairs perfectly with your current items for even better results.'

  for item in cart.items
    # 1. Check exact trigger product setting match if configured
    if settings.upsell_pair_tape_trigger != blank and item.product.id == settings.upsell_pair_tape_trigger.id
      assign has_tape = true
    endif
    if settings.upsell_pair_strips_trigger != blank and item.product.id == settings.upsell_pair_strips_trigger.id
      assign has_strips = true
    endif

    # 2. Fallback title check
    assign title_clean = item.product.title | downcase
    if title_clean contains 'nasal strips'
      assign has_strips = true
    endif
    if title_clean contains 'mouth tape'
      assign has_tape = true
    endif
  endfor

  # 3. Apply rule engine based on state
  if has_tape and has_strips and has_bundle == false
    # Both in cart -> Next tier or matching Bundle
    assign matched_upsell_product = settings.upsell_pair_upgrade_recommend | default: all_products['sleep-bundle']
    assign matched_tag = 'Best Value Upgrade'
    assign matched_desc = 'Upgrade to the complete sleep bundle system.'
  elsif has_tape and has_strips == false
    # Tape in cart -> Recommend matching Strips
    assign matched_upsell_product = settings.upsell_pair_tape_recommend | default: all_products['nasal-strips']
    assign matched_tag = 'Complete the ritual'
    assign matched_desc = 'Pair your mouth tape with nasal strips for unobstructed airflow.'
  elsif has_strips and has_tape == false
    # Strips in cart -> Recommend matching Tape
    assign matched_upsell_product = settings.upsell_pair_strips_recommend | default: all_products['mouth-tape']
    assign matched_tag = 'Complete the ritual'
    assign matched_desc = 'Seal your mouth and protect nasal breathing alignment.'
  else
    assign matched_upsell_product = settings.upsell_pair_upgrade_recommend | default: all_products['sleep-bundle']
  endif

  if matched_upsell_product == blank
    assign matched_upsell_product = all_products['mouth-tape']
  endif
-%}

{%- if matched_upsell_product != blank and matched_upsell_product.available -%}
  {%- assign upsell_variant = matched_upsell_product.selected_or_first_available_variant -%}
  <div class="hz-minicart-upsell">
    <div class="hz-minicart-upsell__card">
      <div class="hz-minicart-upsell__media">
        {%- if matched_upsell_product.featured_image != blank -%}
          {{ matched_upsell_product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'hz-upsell-img' }}
        {%- endif -%}
      </div>
      
      <div class="hz-minicart-upsell__content">
        <span class="hz-minicart-upsell__tag">{{ matched_tag }}</span>
        <h4 class="hz-minicart-upsell__title">{{ matched_upsell_product.title }}</h4>
        <p class="hz-minicart-upsell__desc">{{ matched_desc }}</p>

        <div class="hz-minicart-upsell__bottom">
          <div class="hz-minicart-upsell__price-wrap">
            <span class="hz-minicart-upsell__price">{{ upsell_variant.price | money }}</span>
            {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
              <s class="hz-minicart-upsell__compare">{{ upsell_variant.compare_at_price | money }}</s>
            {%- endif -%}
          </div>

          <form action="{{ routes.cart_add_url }}" method="post" class="hz-upsell-form">
            <input type="hidden" name="id" value="{{ upsell_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="hz-upsell-add-btn">
              Add to Cart
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

<style>
  .hz-minicart-upsell {
    padding: 12px var(--cart-drawer-padding, 20px);
    width: 100%;
    box-sizing: border-box;
  }
  .hz-minicart-upsell__card {
    background-color: #E7F5FF;
    border-radius: 12px;
    padding: 14px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .hz-minicart-upsell__media {
    width: 90px;
    height: 90px;
    flex-shrink: 0;
    border-radius: 12px;
    overflow: hidden;
    background: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hz-upsell-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hz-minicart-upsell__content {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .hz-minicart-upsell__tag {
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: #475569;
  }
  .hz-minicart-upsell__title {
    font-size: 15px;
    font-family: serif;
    font-weight: 600;
    color: #0b1a30;
    margin: 0;
  }
  .hz-minicart-upsell__desc {
    font-size: 12px;
    color: #334155;
    margin: 0 0 8px 0;
    line-height: 1.35;
  }
  .hz-minicart-upsell__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
  }
  .hz-minicart-upsell__price-wrap {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .hz-minicart-upsell__price {
    font-size: 15px;
    font-weight: 800;
    color: #0b1a30;
  }
  .hz-minicart-upsell__compare {
    font-size: 12px;
    color: #64748b;
  }
  .hz-upsell-add-btn {
    background-color: #0b1a30;
    color: #ffffff;
    font-size: 12px;
    font-weight: 700;
    border: none;
    border-radius: 999px;
    padding: 7px 14px;
    cursor: pointer;
    white-space: nowrap;
    transition: opacity 0.2s ease;
  }
  .hz-upsell-add-btn:hover {
    opacity: 0.9;
  }
</style>