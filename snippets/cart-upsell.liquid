{%- liquid
  assign has_strips = false
  assign has_tape = false
  assign matched_upsell_product = blank

  for item in cart.items
    # 1. Check exact trigger product setting match if configured
    if settings.upsell_pair_tape_trigger != blank and item.product.id == settings.upsell_pair_tape_trigger.id
      assign has_tape = true
    endif
    if settings.upsell_pair_strips_trigger != blank and item.product.id == settings.upsell_pair_strips_trigger.id
      assign has_strips = true
    endif

    # 2. Fallback title check
    assign title_clean = item.product.title | downcase
    if title_clean contains 'nasal strips'
      assign has_strips = true
    endif
    if title_clean contains 'mouth tape'
      assign has_tape = true
    endif
  endfor

  # 3. Apply rule engine based on state
  if has_tape and has_strips and has_bundle == false
    # Both in cart -> Next tier or matching Bundle
    assign matched_upsell_product = settings.upsell_pair_upgrade_recommend 
  elsif has_tape and has_strips == false
    # Tape in cart -> Recommend matching Strips
    assign matched_upsell_product = settings.upsell_pair_tape_recommend 
  elsif has_strips and has_tape == false
    # Strips in cart -> Recommend matching Tape
    assign matched_upsell_product = settings.upsell_pair_strips_recommend
  else
    assign matched_upsell_product = settings.upsell_pair_upgrade_recommend
  endif

  if matched_upsell_product == blank
    assign matched_upsell_product = all_products['mouth-tape']
  endif
-%}


{%- if matched_upsell_product != blank and matched_upsell_product.available -%}
  {%- assign upsell_variant = matched_upsell_product.selected_or_first_available_variant -%}
  <div class="hz-minicart-upsell">
    <h2 class="upsell_heading">Complete your sleep system</h2>
    <div class="hz-minicart-upsell__card">
      <div class="hz-minicart-upsell__media">
        {%- if matched_upsell_product.featured_image != blank -%}
          {{ matched_upsell_product.featured_image | image_url: width: 200 | image_tag: loading: 'lazy', class: 'hz-upsell-img' }}
        {%- endif -%}
      </div>
      
      <div class="hz-minicart-upsell__content">
        <svg xmlns="http://www.w3.org/2000/svg" width="67" height="11" viewBox="0 0 67 11" fill="none"> <path d="M6.2207 4.11719L6.58887 4.92871L7.47754 4.99316L7.73438 5.01172L7.6416 5.08496L6.86914 5.69141L7.11621 6.64258L7.18848 6.9209L6.73242 6.66602L6 6.25586L5.26758 6.66602L4.81055 6.9209L4.88379 6.64258L5.13086 5.69141L4.3584 5.08496L4.26465 5.01172L4.52246 4.99316L5.41113 4.92871L5.7793 4.11719L6 3.62988L6.2207 4.11719Z" fill="#F1C644" stroke="#F1C644" stroke-width="3"/> <path d="M20.2207 4.11719L20.5889 4.92871L21.4775 4.99316L21.7344 5.01172L21.6416 5.08496L20.8691 5.69141L21.1162 6.64258L21.1885 6.9209L20.7324 6.66602L20 6.25586L19.2676 6.66602L18.8105 6.9209L18.8838 6.64258L19.1309 5.69141L18.3584 5.08496L18.2646 5.01172L18.5225 4.99316L19.4111 4.92871L19.7793 4.11719L20 3.62988L20.2207 4.11719Z" fill="#F1C644" stroke="#F1C644" stroke-width="3"/> <path d="M33.5693 4.07324L33.9219 4.91992L34.835 4.99316L35.0156 5.00684L34.8779 5.12598L34.1826 5.72168L34.3945 6.61328L34.4365 6.78906L34.2822 6.69531L33.5 6.21777L32.7178 6.69531L32.5625 6.78906L32.6055 6.61328L32.8174 5.72168L32.1221 5.12598L31.9834 5.00684L32.165 4.99316L33.0781 4.91992L33.4307 4.07324L33.5 3.90625L33.5693 4.07324Z" fill="#F1C644" stroke="#F1C644" stroke-width="3"/> <path d="M47.2207 4.11719L47.5889 4.92871L48.4775 4.99316L48.7344 5.01172L48.6416 5.08496L47.8691 5.69141L48.1162 6.64258L48.1885 6.9209L47.7324 6.66602L47 6.25586L46.2676 6.66602L45.8105 6.9209L45.8838 6.64258L46.1309 5.69141L45.3584 5.08496L45.2646 5.01172L45.5225 4.99316L46.4111 4.92871L46.7793 4.11719L47 3.62988L47.2207 4.11719Z" fill="#F1C644" stroke="#F1C644" stroke-width="3"/> <path d="M61 0L62.587 3.49768L66.7063 3.80041L63.5679 6.26482L64.5267 9.94959L61 7.975L57.4733 9.94959L58.4321 6.26482L55.2937 3.80041L59.413 3.49768L61 0Z" fill="#D4D4D4"/> <path d="M61 0L62.587 3.49768L66.7063 3.80041L63.5679 6.26482L64.5267 9.94959L61 7.975L57.4733 9.94959L58.4321 6.26482L55.2937 3.80041L59.413 3.49768L61 0Z" fill="url(#paint0_linear_1337_2060)"/> <defs> <linearGradient id="paint0_linear_1337_2060" x1="55" y1="5.5" x2="67" y2="5.5" gradientUnits="userSpaceOnUse"> <stop stop-color="#F1C644"/> <stop offset="0.7" stop-color="#F1C644"/> <stop offset="0.7" stop-color="#F1C644" stop-opacity="0"/> <stop offset="1" stop-color="#F1C644" stop-opacity="0"/> </linearGradient> </defs> </svg>
        <h4 class="hz-minicart-upsell__title">{{ matched_upsell_product.title }}</h4>
        <div class="hz-minicart-upsell__bottom">
          <div class="hz-minicart-upsell__price-wrap">
            <span class="hz-minicart-upsell__price">{{ upsell_variant.price | money }}</span>
            {%- if upsell_variant.compare_at_price > upsell_variant.price -%}
              <s class="hz-minicart-upsell__compare">{{ upsell_variant.compare_at_price | money }}</s>
            {%- endif -%}
          </div>

          <form action="{{ routes.cart_add_url }}" method="post" class="hz-upsell-form" data-ajax-form>
            <input type="hidden" name="id" value="{{ upsell_variant.id }}">
            <input type="hidden" name="quantity" value="1">
            <button type="submit" class="hz-upsell-add-btn">
              Add to Cart
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}
 