{%- comment -%} SOMNA quiz v2 logic — only rendered by sections/somna-quiz.liquid {%- endcomment -%}
<script>
(function () {
  var root = document.getElementById('sq-{{ sid }}');
  if (!root || root.dataset.sqReady) return;              // never initialise twice
  root.dataset.sqReady = '1';

  var $ = function (s) { return root.querySelector(s); };
  var $$ = function (s, el) { return [].slice.call((el || root).querySelectorAll(s)); };
  var cfg = {};
  try { cfg = JSON.parse(root.parentNode.querySelector('[data-sq-config]').textContent); } catch (e) {}

  var screens = $$('.sq-s');
  var qScreens = screens.filter(function (s) { return s.hasAttribute('data-q'); });
  var top = $('[data-sq-top]'), back = $('[data-sq-back]'), progf = $('[data-sq-progf]'), prog = $('[data-sq-prog]');
  var step = $('[data-sq-step]'), live = $('[data-sq-live]'), foot = $('[data-sq-foot]'), nextBtn = $('[data-sq-next]');
  var cont = $('[data-sq-continue]'), form = $('[data-sq-form]'), emailIn = $('[data-sq-email]'), err = $('[data-sq-err]');
  var sendBtn = $('[data-sq-send]'), triedEl = $('[data-sq-tried]'), goBtn = $('[data-sq-go]');
  var TOTAL = 5;

  // ---- state: answers by question number (1-4 = option index, 5 = list of option indexes) ----
  var i = 0, answers = {}, busy = false, timer = null, sending = false;

  // ---- scoring (SOMNA_Quiz_v2: S = snoring/nose, T = mouth breathing) ----
  function score() {
    var S = 0, T = 0, who = 'self', tried = [];
    for (var q = 1; q <= 4; q++) {
      if (answers[q] == null) continue;
      var o = qScreens[q - 1].querySelectorAll('.sq-opt')[answers[q]];
      S += parseInt(o.getAttribute('data-s') || '0', 10);
      T += parseInt(o.getAttribute('data-t') || '0', 10);
      if (q === 1) who = o.getAttribute('data-tag');
    }
    (answers[5] || []).forEach(function (k) { tried.push(qScreens[4].querySelectorAll('.sq-opt')[k].getAttribute('data-tried')); });
    // Check in order, stop at first match. Nasal Strips is the default (ties, low scores).
    var result = (S >= 3 && T >= 3) ? 'bundle' : (T > S ? 'tape' : 'strips');
    return { S: S, T: T, who: who, tried: tried, result: result };
  }

  // Q1 "My partner" switches you/your to they/their. "Me" and "Both of us" keep the self wording.
  function applyWording() {
    var partner = score().who === 'partner';
    $$('[data-self][data-partner]').forEach(function (el) { el.textContent = el.getAttribute(partner ? 'data-partner' : 'data-self'); });
  }

  function show(n, focus) {
    clearTimeout(timer); busy = false; i = n;
    screens.forEach(function (s, k) { s.classList.toggle('is-on', k === n); });
    var sc = screens[n], ty = sc.getAttribute('data-type'), q = +sc.getAttribute('data-q') || 0;
    applyWording();
    top.hidden = (ty === 'result');
    back.hidden = (n === 0 || ty === 'result');
    if (q) {
      progf.style.width = (q / TOTAL * 100) + '%';
      prog.setAttribute('aria-valuenow', q);
      step.textContent = q + ' of ' + TOTAL; step.hidden = false;
      live.textContent = 'Question ' + q + ' of ' + TOTAL;
    } else { progf.style.width = '100%'; step.hidden = true; live.textContent = ''; }
    if (ty === 'q') {
      var a = answers[q];
      $$('.sq-opt', sc).forEach(function (o, k) { o.setAttribute('aria-pressed', a === k ? 'true' : 'false'); });
      foot.hidden = (a == null);                         // Next appears only for an answered question (after Back)
    } else { foot.hidden = true; }
    if (ty === 'multi') {
      var picked = answers[5] || [];
      $$('.sq-opt', sc).forEach(function (o, k) { o.setAttribute('aria-pressed', picked.indexOf(k) > -1 ? 'true' : 'false'); });
      cont.disabled = picked.length === 0;
    }
    if (ty === 'email') { err.hidden = true; }
    if (ty === 'result') renderResult();
    var h = sc.querySelector('[tabindex="-1"]');
    if (ty === 'result') h = sc.querySelector('.sq-res:not([hidden]) [tabindex="-1"]') || h;
    if (focus && h) { try { h.focus({ preventScroll: true }); } catch (e) { h.focus(); } }
    var r = root.getBoundingClientRect();
    if (r.top < 0) { try { root.scrollIntoView({ behavior: 'smooth', block: 'start' }); } catch (e) { root.scrollIntoView(); } }
  }
  function go(n) { show(n, true); }
  function idx(type) { for (var k = 0; k < screens.length; k++) if (screens[k].getAttribute('data-type') === type) return k; return -1; }

  // ---- single-select questions (Q1-Q4): one tap answers and moves on; repeat taps ignored ----
  qScreens.slice(0, 4).forEach(function (sc, qi) {
    $$('.sq-opt', sc).forEach(function (o, k) {
      o.addEventListener('click', function () {
        if (busy || screens[i] !== sc) return;
        busy = true;
        answers[qi + 1] = k;
        $$('.sq-opt', sc).forEach(function (x) { x.setAttribute('aria-pressed', x === o ? 'true' : 'false'); });
        timer = setTimeout(function () { go(i + 1); }, 220);
      });
    });
  });
  nextBtn.addEventListener('click', function () { var q = +screens[i].getAttribute('data-q'); if (!busy && answers[q] != null) { busy = true; go(i + 1); } });

  // ---- Q5 multi-select: "Nothing yet" clears the others and the others clear it ----
  var q5 = qScreens[4], q5opts = $$('.sq-opt', q5), NOTHING = 3;
  q5opts.forEach(function (o, k) {
    o.addEventListener('click', function () {
      var picked = (answers[5] || []).slice(), at = picked.indexOf(k);
      if (at > -1) picked.splice(at, 1);
      else if (k === NOTHING) picked = [NOTHING];
      else { picked = picked.filter(function (x) { return x !== NOTHING; }); picked.push(k); }
      picked.sort();
      answers[5] = picked;
      q5opts.forEach(function (x, j) { x.setAttribute('aria-pressed', picked.indexOf(j) > -1 ? 'true' : 'false'); });
      cont.disabled = picked.length === 0;
    });
  });
  cont.addEventListener('click', function () { if (!busy && (answers[5] || []).length) { busy = true; go(i + 1); } });

  back.addEventListener('click', function () { if (i > 0) go(i - 1); });
  $$('[data-sq-retake]').forEach(function (b) { b.addEventListener('click', function () { answers = {}; emailIn.value = ''; go(0); }); });

  // ---- result ----
  function renderResult() {
    var s = score();
    $$('.sq-res').forEach(function (el) { el.hidden = el.getAttribute('data-res') !== s.result; });
    // Q5 line: strips line wins when both strips and pills are picked
    var line = s.tried.indexOf('tried_strips') > -1 ? cfg.triedStrips : (s.tried.indexOf('tried_pills') > -1 ? cfg.triedPills : '');
    triedEl.textContent = line || ''; triedEl.hidden = !line;
    var el = $('.sq-res[data-res="' + s.result + '"]'), base = el ? el.getAttribute('data-url') : '';
    var tried = s.tried.map(function (t) { return t.replace('tried_', ''); }).join(',');
    var url = base ? base + '&quiz=' + s.result + '&for=' + s.who + (tried ? '&tried=' + encodeURIComponent(tried) : '') : '#';
    goBtn.setAttribute('href', url);
  }

  // ---- optional email step → Klaviyo (subscribe to list + quiz properties on the profile) ----
  var EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;
  function showErr(m) { err.textContent = m; err.hidden = !m; }
  function post(path, body) {
    var ctrl = 'AbortController' in window ? new AbortController() : null;
    var t = ctrl ? setTimeout(function () { ctrl.abort(); }, 8000) : null;
    return fetch('https://a.klaviyo.com/client/' + path + '/?company_id=' + encodeURIComponent(cfg.klaviyoCompanyId), {
      method: 'POST',
      headers: { Accept: 'application/vnd.api+json', 'Content-Type': 'application/vnd.api+json', Revision: '2026-01-15' },
      body: JSON.stringify(body), signal: ctrl ? ctrl.signal : undefined
    }).then(function (r) { if (t) clearTimeout(t); return r; }, function (e) { if (t) clearTimeout(t); throw e; });
  }
  form.addEventListener('submit', function (ev) {
    ev.preventDefault();
    if (sending) return;                                  // ignore repeat clicks / Enter
    var email = emailIn.value.trim();
    if (!EMAIL_RE.test(email)) { showErr('Enter a valid email address.'); emailIn.focus(); return; }
    if (!cfg.klaviyoCompanyId || !cfg.klaviyoListId) { showErr('Sign-up is unavailable right now. You can skip to your result.'); return; }
    var s = score(), props = {
      quiz_result: s.result,
      quiz_sleep_type: ($('.sq-res[data-res="' + s.result + '"] .sq-res-name') || {}).textContent || '',
      quiz_for: s.who,
      quiz_tried: s.tried,
      quiz_completed_at: new Date().toISOString()
    };
    sending = true; sendBtn.disabled = true; sendBtn.setAttribute('aria-busy', 'true'); showErr('');
    var sub = { data: { type: 'subscription', attributes: { custom_source: 'SOMNA Quiz', profile: { data: { type: 'profile', attributes: {
      email: email, subscriptions: { email: { marketing: { consent: 'SUBSCRIBED' } } } } } } },
      relationships: { list: { data: { type: 'list', id: cfg.klaviyoListId } } } } };
    var prof = { data: { type: 'profile', attributes: { email: email, properties: props } } };
    post('subscriptions', sub).then(function (r) {
      if (!r.ok) throw r;
      return post('profiles', prof).catch(function () {});  // properties are a bonus; never block the result
    }).then(function () {
      try { if (window.fbq) fbq('track', 'Lead', { content_name: 'SOMNA Quiz', content_category: s.result }); } catch (e) {}
      go(idx('result'));
    }).catch(function (r) {
      var m = (r && r.status === 400) ? 'Please check your email address and try again.' : "We couldn't save your email just now. Try again, or skip to see your result.";
      showErr(m);
    }).then(function () { sending = false; sendBtn.disabled = false; sendBtn.removeAttribute('aria-busy'); });
  });
  $('[data-sq-skip]').addEventListener('click', function () { if (!sending) go(idx('result')); });

  show(0, false);
})();
</script>