{%- style -%}
  /* --- 1. Section & Container Wrappers --- */
.bundle-section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color }};
  overflow-x: clip; /* Prevents mobile horizontal scroll */
  width: 100%;
}
/* --- 2. Grid Layout --- */
.bundle-section__grid {
  display: grid;
  /* Use minmax(0, 1fr) so contents can shrink inside columns */
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
  width: 100%;
  box-sizing: border-box;
}

/* --- 3. Standard Cards --- */
.bundle-card {
  display: flex;
  flex-direction: column;
  min-width: 0;
  width: 100%;
  box-shadow: 0px 0px 4px 0px #00000040;
  box-sizing: border-box;
  padding: 5px;
  border-radius: 10px;
}
.bundle-card__image-wrapper {
  position: relative;
  border-radius: 7px;
  overflow: hidden;
  aspect-ratio: 16 / 9;
  background: #f4f4f4;
}
.bundle-card__image {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
  transition: transform 0.3s ease;
}

.bundle-card:hover .bundle-card__image {
  transform: scale(1.03);
}

.bundle-card__content {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 5px;
  flex-wrap: wrap;
}

.bundle-card__info {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.bundle-card__title {
  font-size: 12px;
  font-weight: 600;
  color: var(--color-text);
  line-height: 1.2;
  margin:0;
}

.bundle-card__price {
  font-size: 11px;
  font-weight: 800;
  color: var(--color-text);
  margin: 0 0 2px 0;
}
.bundle-card__content-wrapper {
  display: flex;
  align-items: flex-end;
}
.bundle-card__subtext {
  font-size: 9px;
  color: var(--color-text);
  margin: 0;
  line-height: 1;
}

.bundle-card__button {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 6px;
  background-color: var(--color-text);
  color: #ffffff !important;
  text-decoration: none;
  padding: 4px 9px;
  border-radius: 9999px;
  font-size: 8px;
  font-weight: 600;
  line-height: 1;
  transition: background-color 0.2s ease;
}

.bundle-card__button:hover {
  background-color: var(--color-text);
}

.bundle-card__button svg {
  width: 12px;
  height: 12px;
  flex-shrink: 0;
}

/* --- 4. Featured Large Card --- */
.bundle-card--featured {
  grid-column: span 2;
  background-color: #ffffff;
  display: grid;
  grid-template-columns: 1.2fr 1fr;
  gap: 20px;
  align-items: center;
}

.bundle-card--featured .bundle-card__image-wrapper {
  aspect-ratio: 15 / 10;
  height: 100%;
}
.bundle-card--featured .bundle-card__title {
  font-size: 14px;
}
.bundle-card--featured .bundle-card__content-wrapper {
    flex-wrap: wrap;
}
.bundle-card--featured .bundle-card__price {
  font-size: 14px;
}

.bundle-card--featured .bundle-card__button {
  padding: 7px 13px;
  margin-top: 8px;
}

{%- endstyle -%}

<section class="bundle-section-{{ section.id }}">
  <div class="section section--page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-header">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="bundle-section__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign title = block.settings.custom_title | default: product.title
          assign image = block.settings.custom_image | default: product.featured_image
          assign price = product.price | money
          assign link = product.url | default: '#'
        -%}

        <div class="bundle-card {% if block.settings.is_featured %}bundle-card--featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="bundle-card__image-wrapper">
            {%- if image != blank -%}
              <img
                src="{{ image | image_url: width: 1000 }}"
                alt="{{ title | escape }}"
                loading="lazy"
                class="bundle-card__image"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'bundle-card__image' }}
            {%- endif -%}
          </div>

          <div class="bundle-card__content">
            {%- if title != blank -%}
                <h3 class="bundle-card__title">{{ title }}</h3>
              {%- endif -%}


          <div class="bundle-card__content-wrapper">

            <div class="bundle-card__info">
            
              {%- if product != blank -%}
                <p class="bundle-card__price">{{ price }}</p>
              {%- endif -%}

              {%- if block.settings.subtext != blank -%}
                <p class="bundle-card__subtext">{{ block.settings.subtext }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.button_label != blank -%}
              <a href="{{ link }}" class="bundle-card__button">
                <span>{{ block.settings.button_label }}</span>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            {%- endif -%}
          </div>


          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Bundle Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Bundle Block"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfaf3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 10,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Make Center Full-Width Card",
          "default": false
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Overrides Product Title)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Overrides Product Image)"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Subscribe & Save"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop the Bundle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Bundle Grid",
      "blocks": [
        { "type": "bundle" },
        { "type": "bundle" },
        { "type": "bundle", "settings": { "is_featured": true } },
        { "type": "bundle" },
        { "type": "bundle" }
      ]
    }
  ]
}
{% endschema %}