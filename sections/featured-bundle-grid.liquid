{%- style -%}
  /* --- 1. Section & Container Wrappers --- */
.bundle-section-{{ section.id }} {
  padding-top: {{ section.settings.padding_top }}px;
  padding-bottom: {{ section.settings.padding_bottom }}px;
  background-color: {{ section.settings.bg_color }};
  overflow-x: clip; /* Prevents mobile horizontal scroll */
  width: 100%;
}
{%- endstyle -%}

<section class="bundle-section-{{ section.id }}">
  <div class="section section--page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="custom-header">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="bundle-section__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign title = product.title
          assign subtitle = block.settings.custom_title 
          assign image = block.settings.custom_image | default: product.featured_image
          assign link = product.url | default: '#'

          # Calculate Subscription Price dynamically
          assign base_price = product.price | default: 0
          if product.compare_at_price > product.price
            assign base_price = product.compare_at_price
          endif

          assign auto_discount_percent = 0
          if product != blank
            for group in product.selling_plan_groups
              for plan in group.selling_plans
                for adjustment in plan.price_adjustments
                  if adjustment.value_type == 'percentage'
                    assign auto_discount_percent = adjustment.value
                    break
                  endif
                endfor
                if auto_discount_percent > 0
                  break
                endif
              endfor
              if auto_discount_percent > 0
                break
              endif
            endfor
          endif

          if auto_discount_percent > 0
            assign discount_multiplier = 100 | minus: auto_discount_percent
            assign calculated_price = base_price | times: discount_multiplier | divided_by: 100
            assign price = calculated_price | money
          else
            assign price = product.price | money
          endif
        -%}

        <div class="bundle-card {% if block.settings.is_featured %}bundle-card--featured{% endif %}" {{ block.shopify_attributes }}>
          <div class="bundle-card__image-wrapper">
            {%- if image != blank -%}
              <img
                src="{{ image | image_url: width: 1000 }}"
                alt="{{ title | escape }}"
                loading="lazy"
                class="bundle-card__image"
                width="{{ image.width }}"
                height="{{ image.height }}"
              >
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'bundle-card__image' }}
            {%- endif -%}
          </div>

          <div class="bundle-card__content">
            {%- if title != blank or subtitle != blank -%}
              <div class="brand-card-wrap">
                  <h3 class="bundle-card__title">{{ title }}</h3>
                {%- if subtitle != blank -%}
                  <div class="bundle-subtext">
                    {{ subtitle }}
                  </div>
                {% endif %}
              </div>
            {%- endif -%}


          <div class="bundle-card__content-wrapper">

            <div class="bundle-card__info">

              {%- if product != blank -%}
                <p class="bundle-card__price">{{ price }}</p>
              {%- endif -%}

              {%- if block.settings.subtext != blank -%}
                <p class="bundle-card__subtext">{{ block.settings.subtext }}</p>
              {%- endif -%}
            </div>

            {%- if block.settings.button_label != blank -%}
              <a href="{{ link }}" class="bundle-card__button">
                <span>{{ block.settings.button_label }}</span>
              </a>
            {%- endif -%}
          </div>


          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Bundle Grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Bundle Block"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdfaf3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Top",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "bundle",
      "name": "Bundle Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Select Product"
        },
        {
          "type": "checkbox",
          "id": "is_featured",
          "label": "Make Center Full-Width Card",
          "default": false
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Sub Title"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Image (Overrides Product Image)"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Subtext",
          "default": "Subscribe & Save"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button Label",
          "default": "Shop the Bundle"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Featured Bundle Grid",
      "blocks": [
        { "type": "bundle" },
        { "type": "bundle" },
        { "type": "bundle", "settings": { "is_featured": true } },
        { "type": "bundle" },
        { "type": "bundle" }
      ]
    }
  ]
}
{% endschema %}