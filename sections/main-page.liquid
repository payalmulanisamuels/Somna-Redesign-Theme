

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}
{% comment %} Top Wave Divider {% endcomment %}
    {% if section.settings.top_wave_image != blank %}
  <div class="wave-container top" style="background-image: url({{ section.settings.top_wave_image | image_url: width: 1440 }})">
  </div>
  {% endif %}
{% comment %} Bottom Wave Divider {% endcomment %}
  {% if section.settings.bottom_wave_image != blank %}
  <div class="wave-container bottom" style="background-image: url({{ section.settings.bottom_wave_image | image_url: width: 1440 }})">
  </div>
  {% endif %}
<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div class="section page-width-content{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}">
  <div
    class="
      spacing-style
      layout-panel-flex
      layout-panel-flex--column
      section-content-wrapper
      mobile-column
    "
    style="
      {% render 'layout-panel-style', settings: section.settings %}
      {% render 'spacing-style', settings: section.settings %}
    "
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% stylesheet %}
  /* Shipping Policy page only (2026-10-16): sections alternate peach #fff2e3 and coral #f9b38d. Every
     section after the title rises into the one above with the footer's own wave (Footer_Curved_edge.svg,
     the file the footer uses), drawn in that section's colour at the footer's sizes: 25px on phones,
     79px from 750px, scaled to the page width and anchored to the top like the footer's. The last
     section hangs the same wave, flipped, over the newsletter image. Text and blocks are unchanged. */
  #MainContent[data-template='page.shipping-policy'] {
    --sp-wave-h: 25px;
    --sp-wave: url('/cdn/shop/files/Footer_Curved_edge.svg');
    --sp-gap-top: 32px;
    --sp-gap-bottom: 36px;
  }

  @media screen and (min-width: 750px) {
    #MainContent[data-template='page.shipping-policy'] {
      --sp-wave-h: 79px;
      --sp-gap-top: 44px;
      --sp-gap-bottom: 56px;
    }
  }

  #MainContent[data-template='page.shipping-policy'] > .shopify-section:is(
      [id$='__main'], [id$='__section_iYG7xV'], [id$='__section_xXDyC9']) {
    --sp-bg: #fff2e3;
  }

  #MainContent[data-template='page.shipping-policy'] > .shopify-section:is(
      [id$='__section_nCrU7b'], [id$='__section_63n6Lm'], [id$='__section_B46NBr']) {
    --sp-bg: #f9b38d;
  }

  #MainContent[data-template='page.shipping-policy'] > .shopify-section:is([id$='__main'], [id*='__section_']) > .section-background {
    background-color: var(--sp-bg);
  }

  /* The old image waves were drawn in the old section colours, so they are hidden on this page */
  #MainContent[data-template='page.shipping-policy'] > .shopify-section:is([id$='__main'], [id*='__section_']) > .wave-container {
    display: none;
  }

  /* Even spacing. Each wave sits in the bottom padding of the section above it, so that padding is the
     wave height plus a gap, and no text is ever under a wave. */
  #MainContent[data-template='page.shipping-policy'] > .shopify-section[id*='__section_'] .section > .custom-section-content > .section-content-wrapper.spacing-style {
    padding-block-start: var(--sp-gap-top);
    padding-block-end: calc(var(--sp-wave-h) + var(--sp-gap-bottom));
  }

  #MainContent[data-template='page.shipping-policy'] > .shopify-section[id$='__main'] .section > .section-content-wrapper.spacing-style {
    padding-block-end: calc(var(--sp-wave-h) + var(--sp-gap-bottom));
  }

  #MainContent[data-template='page.shipping-policy'] > .shopify-section[id$='__section_B46NBr'] .section > .custom-section-content > .section-content-wrapper.spacing-style {
    padding-block-end: var(--sp-gap-bottom);
  }

  /* The wave, exactly as the footer draws its own: this section's colour, shaped by the footer's SVG,
     full width, rising from 1px inside this section over the bottom of the section above */
  #MainContent[data-template='page.shipping-policy'] > .shopify-section[id*='__section_']::before {
    content: '';
    position: absolute;
    top: calc(1px - var(--sp-wave-h));
    right: 0;
    left: 0;
    z-index: 3;
    height: var(--sp-wave-h);
    background-color: var(--sp-bg);
    -webkit-mask: var(--sp-wave) top / cover no-repeat;
    mask: var(--sp-wave) top / cover no-repeat;
    pointer-events: none;
  }

  /* Last section: the same wave turned upside down, in coral, over the top of the newsletter image */
  #MainContent[data-template='page.shipping-policy'] > .shopify-section[id$='__section_B46NBr']::after {
    content: '';
    position: absolute;
    top: calc(100% - 1px);
    right: 0;
    left: 0;
    z-index: 3;
    height: var(--sp-wave-h);
    background-color: var(--sp-bg);
    -webkit-mask: var(--sp-wave) top / cover no-repeat;
    mask: var(--sp-wave) top / cover no-repeat;
    transform: scaleY(-1);
    pointer-events: none;
  }

  /* Phones: move the newsletter text down by the wave height so the wave never covers it
     (from 750px the footer already has more room than that) */
  @media screen and (max-width: 749px) {
    #MainContent[data-template='page.shipping-policy'] > .shopify-section[id$='__footer_m9NzUG'] > .section {
      padding-top: var(--sp-wave-h);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.page",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
      {
      "type": "header",
      "content": "Wave Dividers"
    },
    {
      "type": "image_picker",
      "id": "top_wave_image",
      "label": "Top SVG Wave Image",
      "info": "Upload your custom top wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "bottom_wave_image",
      "label": "Bottom SVG Wave Image",
      "info": "Upload your custom bottom wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "select",
      "id": "content_direction",
      "label": "t:settings.direction",
      "options": [
        {
          "value": "column",
          "label": "t:options.vertical"
        }
      ],
      "default": "column",
      "visible_if": "{{ section.settings.gap < 0 }}"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
