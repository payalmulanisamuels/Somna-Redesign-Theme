{%- liquid
  assign bundle_product = section.settings.product
  if bundle_product == blank and request.visual_preview_mode
    assign bundle_product = collections.all.products.first
  endif

  if bundle_product != blank
    # Colour option: first option named Color/Colour, otherwise the first option
    assign color_option = bundle_product.options_with_values.first
    for option in bundle_product.options_with_values
      assign option_name_check = option.name | downcase
      if option_name_check contains 'color' or option_name_check contains 'colour'
        assign color_option = option
        break
      endif
    endfor

    # "From" price: lowest subscription price across variants, else lowest price
    assign from_price = bundle_product.price_min
    for variant in bundle_product.variants
      assign variant_price = variant.price
      for allocation in variant.selling_plan_allocations
        if allocation.price < variant_price
          assign variant_price = allocation.price
        endif
      endfor
      if variant_price < from_price
        assign from_price = variant_price
      endif
    endfor

    assign bundle_title = section.settings.title | default: bundle_product.title
    assign bundle_image = section.settings.image | default: bundle_product.featured_image

    assign rating = bundle_product.metafields.reviews.rating.value
    assign rating_count = bundle_product.metafields.reviews.rating_count.value | default: 0
    if rating != blank
      assign rating_percent = rating.rating | times: 100.0 | divided_by: rating.scale_max
    endif

    # Button link: specific variant chosen by name (e.g. "Breathe") or variant ID, else the product
    assign bundle_url = bundle_product.url
    assign button_variant_setting = section.settings.button_variant | strip
    if button_variant_setting != blank
      assign button_variant_check = button_variant_setting | downcase
      for variant in bundle_product.variants
        assign variant_id_string = variant.id | append: ''
        assign variant_title_check = variant.title | downcase
        if variant_id_string == button_variant_setting or variant_title_check contains button_variant_check
          assign bundle_url = variant.url
          break
        endif
      endfor
    endif
  endif
-%}

{% if bundle_product != blank %}
  {%- comment -%} Halloween 2026 (homepage only): the Figma spiderwebs draw themselves in and the spider
     drops on its thread (animation: assets/somna-motion.css, section 15). They replace the still web
     pictures custom.css shows on .somna-sleep-bundle::before / ::after. {%- endcomment -%}
  {%- liquid
    assign sb_halloween = false
    if template.name == 'index'
      assign sb_halloween = true
    endif
  -%}
  <div
    class="somna-sleep-bundle section-{{ section.id }}{% if sb_halloween %} somna-sb--halloween{% endif %}"
    style="
      --ssb-section-bg: {{ section.settings.section_bg }};
      --ssb-card-bg: {{ section.settings.card_bg }};
      --ssb-border: {{ section.settings.border_color }};
      --ssb-accent: {{ section.settings.accent_color }};
      --ssb-text: {{ section.settings.text_color }};
      --ssb-muted: {{ section.settings.muted_color }};
      --ssb-btn-bg: {{ section.settings.button_bg }};
      --ssb-btn-text: {{ section.settings.button_text_color }};
      --ssb-pt: {{ section.settings.padding_top }}px;
      --ssb-pb: {{ section.settings.padding_bottom }}px;
    "
  >
    {%- if sb_halloween -%}
      <span class="somna-ess__web somna-ess__web--left" aria-hidden="true">
        {%- comment -%} The Figma web image, drawn in by an SVG mask (animation: assets/somna-motion.css, section 15) {%- endcomment -%}
        <svg class="somna-ess__web-svg" viewBox="0 0 439 268" width="439" height="268" focusable="false">
          <defs>
            <mask id="somna-sbweb-{{ section.id }}" maskUnits="userSpaceOnUse" x="-20" y="-20" width="480" height="310">
              <path class="hw-m hw-m--frame" pathLength="1" d="M0 2 L300 2"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.15s" d="M65 70 L55.9 -4.0"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.21s" d="M65 70 L-3.0 8.8"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.27s" d="M65 70 L-4.0 62.8"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.33s" d="M65 70 L120.2 -3.2"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.39s" d="M65 70 L189.7 -2.0"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.45s" d="M65 70 L284.2 -1.2"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.51s" d="M65 70 L-2.2 173.4"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.57s" d="M65 70 L-0.6 271.8"/>
              <path class="hw-m hw-m--ring" pathLength="1" style="--t:0.5s;--d:0.5s" d="M62.9 81.8 A12 12 0 1 1 76.8 67.9 L102.4 63.4 A38 38 0 1 0 58.4 107.4 L53.9 133.0 A64 64 0 1 1 128.0 58.9 L153.6 54.4 A90 90 0 1 0 49.4 158.6 L44.9 184.2 A116 116 0 1 1 179.2 49.9"/>
              <path class="hw-m hw-m--ring" pathLength="1" style="--t:0.95s;--d:0.5s" d="M204.8 45.3 A142 142 0 1 0 40.3 209.8 L35.8 235.4 A168 168 0 1 1 230.4 40.8 L256.1 36.3 A194 194 0 1 0 31.3 261.1 L26.8 286.7 A220 220 0 1 1 281.7 31.8 L307.3 27.3 A246 246 0 1 0 22.3 312.3"/>
              <rect class="hw-m--all" x="-20" y="-20" width="480" height="310" fill="#fff"/>
            </mask>
          </defs>
          <image href="{{ 'somna-hw-web.png' | asset_url }}" width="439" height="268" mask="url(#somna-sbweb-{{ section.id }})"/>
        </svg>
        <span class="somna-spider">
          <i class="somna-spider__thread"></i>
          <img class="somna-spider__body" src="{{ 'somna-hw-spider.png' | asset_url }}" alt="" width="90" height="100" loading="lazy" decoding="async">
        </span>
      </span>
      {%- comment -%} Right web: the Figma right-hand web (no spider), drawn in the same way {%- endcomment -%}
      <span class="somna-ess__web somna-ess__web--right" aria-hidden="true">
        <svg class="somna-ess__web-svg" viewBox="0 0 333 178" width="333" height="178" focusable="false">
          <defs>
            <mask id="somna-sbweb-r-{{ section.id }}" maskUnits="userSpaceOnUse" x="-20" y="-20" width="380" height="220">
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.35s" d="M286 62 L308.7 -3.8"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.43s" d="M286 62 L336.4 31.7"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.51s" d="M286 62 L218.9 -2.8"/>
              <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.59s" d="M286 62 L336.6 86.7"/>
              <path class="hw-m hw-m--ring" pathLength="1" style="--t:0.6s;--d:0.5s" d="M296.0 62.0 A10 10 0 0 1 281.0 70.7 A10 10 0 0 1 281.0 53.3 A10 10 0 0 1 296.0 62.0 M322.0 61.9 A36 36 0 0 0 268.0 30.8 A36 36 0 0 0 268.0 93.2 A36 36 0 0 0 322.0 62.0 M345.0 81.2 A62 62 0 0 1 224.0 62.0 A62 62 0 0 1 345.0 42.8 M238.1 -11.8 A88 88 0 0 0 216.2 115.6 A88 88 0 0 0 344.9 127.4 M344.7 159.7 A114 114 0 0 1 198.7 -11.3"/>
              <path class="hw-m hw-m--ring" pathLength="1" style="--t:1.05s;--d:0.55s" d="M166.0 -10.1 A140 140 0 0 0 229.1 189.9 M179.3 189.2 A166 166 0 0 1 136.8 -10.8 M108.0 -9.9 A192 192 0 0 0 141.1 188.0 M107.4 187.0 A218 218 0 0 1 79.9 -9.0 M52.7 -9.3 A244 244 0 0 0 76.9 187.7 M47.6 188.8 A270 270 0 0 1 25.2 -7.9 M-1.2 -9.6 A296 296 0 0 0 17.7 187.1 M-10.4 187.8 A322 322 0 0 0 -10.4 187.8"/>
              <rect class="hw-m--all" x="-20" y="-20" width="380" height="220" fill="#fff"/>
            </mask>
          </defs>
          <image href="{{ 'somna-hw-web-right.png' | asset_url }}" width="333" height="178" mask="url(#somna-sbweb-r-{{ section.id }})"/>
        </svg>
      </span>
      <script>
        /* Sleep Bundle webs and spider: play when the left web is a quarter of the way up the screen,
           and again each time the section comes back into view. Without this script they simply show still. */
        (function () {
          function setup(s) {
            if (!s || s.getAttribute('data-hw-init')) return;
            s.setAttribute('data-hw-init', '1');
            if (!('IntersectionObserver' in window)) return;
            var target = s.querySelector('.somna-ess__web--left') || s;
            s.classList.add('hw-ready');
            new IntersectionObserver(function (entries) {
              if (entries[0].isIntersecting) s.classList.add('is-in');
            }, { rootMargin: '0px 0px -25% 0px' }).observe(target);
            new IntersectionObserver(function (entries) {
              if (!entries[0].isIntersecting) s.classList.remove('is-in');
            }).observe(s);
          }
          function scan() {
            document.querySelectorAll('.somna-sb--halloween').forEach(setup);
          }
          scan();
          if (!window.somnaSbHwBound) {
            window.somnaSbHwBound = true;
            document.addEventListener('DOMContentLoaded', scan);
            document.addEventListener('shopify:section:load', scan);
          }
        })();
      </script>
    {%- endif -%}
    <div class="somna-sleep-bundle__card">
      {%- if section.settings.badge_text != blank -%}
        <span class="somna-sleep-bundle__badge">
          {%- if section.settings.show_badge_icon -%}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              <path d="M20 7h-2.18A3 3 0 0 0 12 3.76 3 3 0 0 0 6.18 7H4a1 1 0 0 0-1 1v3a1 1 0 0 0 1 1h7V7h2v5h7a1 1 0 0 0 1-1V8a1 1 0 0 0-1-1ZM9 7a1 1 0 1 1 1-1v1H9Zm6 0h-1V6a1 1 0 1 1 1 1ZM4 14v6a1 1 0 0 0 1 1h6v-7H4Zm9 7h6a1 1 0 0 0 1-1v-6h-7v7Z"/>
            </svg>
          {%- endif -%}
          {{ section.settings.badge_text | escape }}
        </span>
      {%- endif -%}

      <div class="somna-sleep-bundle__top">
        <a href="{{ bundle_url }}" class="somna-sleep-bundle__media" tabindex="-1" aria-hidden="true">
          {%- if bundle_image != blank -%}
            {{
              bundle_image
              | image_url: width: 400
              | image_tag:
                loading: 'lazy',
                widths: '200, 300, 400',
                sizes: '(min-width: 750px) 200px, 120px',
                alt: bundle_title,
                class: 'somna-sleep-bundle__image'
            }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'somna-sleep-bundle__image' }}
          {%- endif -%}
        </a>

        <div class="somna-sleep-bundle__info">
              {% if bundle_product.metafields.custom.custom_review_rating_review_count.value %}
              {%  assign review_count_rating = bundle_product.metafields.custom.custom_review_rating_review_count.value   %}
              <div class="review_content">
              {{ review_count_rating }} 
              </div>
              {% endif %}

          <h2 class="somna-sleep-bundle__title">{{ bundle_title | escape }}</h2>

          {%- if section.settings.subtitle != blank -%}
            <p class="somna-sleep-bundle__subtitle">{{ section.settings.subtitle }}</p>
          {%- endif -%}

          <p class="somna-sleep-bundle__price">
            <strong>
              {%- if section.settings.price_prefix != blank %}{{ section.settings.price_prefix }} {% endif -%}
              {%- if section.settings.price_override != blank -%}
                {{- section.settings.price_override -}}
              {%- else -%}
                {{- from_price | money_without_trailing_zeros -}}
              {%- endif -%}
            </strong>
            {%- if section.settings.price_label != blank %} <span>{{ section.settings.price_label }}</span>{% endif -%}
          </p>

          {%- if section.settings.per_night_text != blank -%}
            <p class="somna-sleep-bundle__per-night">{{ section.settings.per_night_text }}</p>
          {%- endif -%}
        </div>
      </div>

      {%- if color_option.values.size > 1 -%}
        <ul class="somna-sleep-bundle__colors" aria-label="{{ color_option.name | escape }}">
          {%- for value in color_option.values -%}
            {%- liquid
              assign value_label = value.name | split: ' (' | first
              assign value_check = value.name | downcase
              assign dot_color = ''

              for block in section.blocks
                assign block_value = block.settings.option_value | strip | downcase
                if block_value != blank and value_check contains block_value
                  assign dot_color = block.settings.color
                  break
                endif
              endfor

              if dot_color == blank
                if value.swatch.color
                  assign dot_color = 'rgb(' | append: value.swatch.color.rgb | append: ')'
                elsif value_check contains 'blue' or value_check contains 'breathe'
                  assign dot_color = '#0b57e3'
                elsif value_check contains 'red' or value_check contains 'bold'
                  assign dot_color = '#e3121e'
                elsif value_check contains 'black' or value_check contains 'night'
                  assign dot_color = '#000000'
                else
                  assign dot_color = '#d9d9d9'
                endif
              endif
            -%}
            <li class="somna-sleep-bundle__color">
              <span class="somna-sleep-bundle__dot" style="background: {{ dot_color }};" aria-hidden="true"></span>
              {{ value_label | escape }}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.button_label != blank -%}
        <a href="{{ bundle_url }}" class="somna-sleep-bundle__button">
          <span>{{ section.settings.button_label | escape }}</span>
          <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <path d="M4 10h12m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      {%- endif -%}
    </div>
  </div>
{% endif %}

{% stylesheet %}
  .somna-sleep-bundle {
    background: var(--ssb-section-bg);
    padding: var(--ssb-pt) 16px var(--ssb-pb);
  }

  .somna-sleep-bundle__card {
    position: relative;
    display: block;
    max-width: 640px;
    margin: 18px auto 0;
    padding: 28px 15px 20px;
    background: var(--ssb-card-bg);
    border: 2px solid var(--ssb-border);
    border-radius: 18px;
    color: var(--ssb-text);
  }

  .somna-sleep-bundle__badge {
    position: absolute;
    top: -15px;
    left: 14px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 14px;
    border-radius: 999px;
    background: var(--ssb-accent);
    color: #fff;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .somna-sleep-bundle__top {
    display: grid;
    grid-template-columns: 100px 1fr;
    gap: 14px;
    align-items: center;
  }

  .somna-sleep-bundle__media {
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border-radius: 12px;
  }

  .somna-sleep-bundle__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-sleep-bundle__info > * {
    margin: 0;
  }

  .somna-sleep-bundle__title {
    margin-top: 2px !important;
    font-family: var(--headfont, var(--font-heading--family));
    font-size: 18px;
    font-weight: 700;
    line-height: 1.15;
    color: var(--ssb-text);
  }

  .somna-sleep-bundle__subtitle {
    margin-top: 6px !important;
    font-size: 10px;
    line-height: 1.3;
    color: var(--ssb-muted);
  }

  .somna-sleep-bundle__price {
    margin-top: 6px !important;
    font-size: 13px;
    line-height: 1.3;
    color: var(--ssb-muted);
    margin-bottom: 5px;
  }

  .somna-sleep-bundle__price strong {
    color: var(--ssb-accent);
    font-weight: 700;
  }

  .somna-sleep-bundle__per-night {
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    color: var(--ssb-text);
  }

  .somna-sleep-bundle__colors {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 10px 0 0;
    padding: 0;
    list-style: none;
  }

  .somna-sleep-bundle__color {
        display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-width: 69px;
    padding: 4px 12px;
    background: #fff;
    border: 1px solid #c1c0b6;
    border-radius: 999px;
    color: #000;
    font-size: 9px;
    font-weight: 500;
    line-height: 1.2;
  }

  .somna-sleep-bundle__dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex-shrink: 0;
  }

  .somna-sleep-bundle__button {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-top: 7px;
    padding: 12px 20px;
    border-radius: 999px;
    background: var(--ssb-btn-bg);
    color: var(--ssb-btn-text);
    font-size: 14px;
    font-weight: 600;
    text-decoration: none;
    box-shadow: 0 8px 20px rgb(11 87 227 / 0.15);
    transition: opacity 0.2s ease;
  }

  .somna-sleep-bundle__button:hover {
    opacity: 0.9;
  }

  .somna-sleep-bundle__button[aria-busy='true'] {
    opacity: 0.6;
    pointer-events: none;
    cursor: progress;
  }

  .somna-sleep-bundle__error {
    margin: 8px 0 0;
    font-size: 13px;
    text-align: center;
    color: #c8102e;
  }

  @media screen and (min-width: 750px) {
    .somna-sleep-bundle__card {
      padding: 40px 36px 32px;
      border-radius: 24px;
    }

    .somna-sleep-bundle__badge {
      top: -18px;
      left: 24px;
      padding: 7px 18px;
      font-size: 15px;
    }

    .somna-sleep-bundle__top {
      grid-template-columns: 200px 1fr;
      gap: 24px;
    }

    .somna-sleep-bundle__media {
      border-radius: 16px;
    }

    .somna-sleep-bundle__rating {
      font-size: 13px;
    }

    .somna-sleep-bundle__stars {
      font-size: 15px;
    }

    .somna-sleep-bundle__title {
      font-size: 32px;
    }

    .somna-sleep-bundle__subtitle {
      font-size: 16px;
    }

    .somna-sleep-bundle__price {
      font-size: 22px;
    }

    .somna-sleep-bundle__per-night {
      font-size: 18px;
    }

    .somna-sleep-bundle__colors {
      gap: 12px;
      margin-top: 20px;
    }

    .somna-sleep-bundle__color {
      min-width: 110px;
      padding: 8px 20px;
      font-size: 15px;
    }

    .somna-sleep-bundle__button {
      margin-top: 16px;
      padding: 18px 24px;
      font-size: 20px;
    }
  }

  /* Halloween (homepage): the spider hangs in front of the card on phones and desktop, so the card
     no longer hides its legs; the web itself stays behind the card as before. */
  #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-ess__web--left {
    z-index: auto !important;
  }

  #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-ess__web--left .somna-spider {
    z-index: 2;
  }

  /* Halloween (homepage), phones: webs and spider placed as in the Figma mobile design (3297:6613).
     Only the webs are lifted above the "It's simple." photo before this section (so they are not
     hidden by it); the section itself stays below, so the photo keeps its wavy bottom curve.
     Order, back to front: photo, webs, card, spider. Left web just under the photo's curve with its
     spider on the card's left border beside the product picture; right web in the top-right corner.
     Tablet and desktop are unchanged. */
  @media screen and (max-width: 749px) {
    #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-sleep-bundle__card {
      z-index: 3;
    }

    #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-ess__web--left .somna-ess__web-svg {
      position: relative;
      z-index: 2;
    }

    #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-ess__web--left .somna-spider {
      z-index: 4;
    }

    #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-ess__web--left {
      top: 5px !important;
      --hang: 280;
    }

    #MainContent .somna-sleep-bundle.somna-sb--halloween > .somna-ess__web.somna-ess__web--right {
      top: 4px !important;
      z-index: 2 !important;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "The Sleep Bundle",
  "tag": "section",
  "class": "section-sleep-bundle",
  "settings": [
    {
      "type": "header",
      "content": "Product"
    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "header",
      "content": "Badge"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "3 Colors"
    },
    {
      "type": "checkbox",
      "id": "show_badge_icon",
      "label": "Show gift icon",
      "default": true
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the product image"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show star rating",
      "default": true,
      "info": "Uses the product's review metafields (Judge.me)"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Title",
      "default": "The Sleep Bundle",
      "info": "Leave empty to use the product title"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Strips + Tape in all three colors"
    },
    {
      "type": "text",
      "id": "price_prefix",
      "label": "Price prefix",
      "default": "From"
    },
    {
      "type": "text",
      "id": "price_override",
      "label": "Price override",
      "info": "Leave empty to show the lowest subscription price automatically"
    },
    {
      "type": "text",
      "id": "price_label",
      "label": "Price label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "per_night_text",
      "label": "Offer text",
      "default": "3+1 sets. $1.46/night"
    },
    {
      "type": "text",
