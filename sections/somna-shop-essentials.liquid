{%- comment -%}
  Somna: "Shop the essentials"
  Two product cards (Nasal Strips / Mouth Tape) built from the Figma mobile homepage (node 301:916).
  Mobile follows the Figma frame (393px) exactly; tablet and desktop scale the same design up.
  Self-contained: every class starts with .somna-ess, so no other section is affected.
  Price uses the same "subscribe & save" calculation as the other homepage product cards.
{%- endcomment -%}

{%- style -%}
  #shopify-section-{{ section.id }} .somna-ess {
    --ess-ink: #0a1a4a;
    --ess-bg: {{ section.settings.bg_color | default: '#ffffff' }};
    position: relative;
    overflow-x: clip;
    background: var(--ess-bg);
    --ess-pad-top: {{ section.settings.padding_top_mobile }}px;
    --ess-pad-bottom: {{ section.settings.padding_bottom_mobile }}px;
    padding-block: var(--ess-pad-top) var(--ess-pad-bottom);
  }

  #shopify-section-{{ section.id }} .somna-ess__deco--tape {
    background-image: url('{{ 'somna-ess-tape.webp' | asset_url }}');
  }

  #shopify-section-{{ section.id }} .somna-ess__deco--dots-left,
  #shopify-section-{{ section.id }} .somna-ess__deco--dots-right {
    background-image: url('{{ 'somna-ess-dots.svg' | asset_url }}');
  }

  #shopify-section-{{ section.id }} .somna-ess__deco--strips {
    background-image: url('{{ 'somna-ess-strips.webp' | asset_url }}');
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .somna-ess {
      --ess-pad-top: {{ section.settings.padding_top }}px;
      --ess-pad-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="somna-ess">
  {%- comment -%} The tape and strips are cut off on one side, so they sit on the screen edges {%- endcomment -%}
  <span class="somna-ess__deco somna-ess__deco--tape" aria-hidden="true"></span>
  <span class="somna-ess__deco somna-ess__deco--strips" aria-hidden="true"></span>
  <div class="somna-ess__inner">
    <span class="somna-ess__deco somna-ess__deco--dots-left" aria-hidden="true"></span>
    <span class="somna-ess__deco somna-ess__deco--dots-right" aria-hidden="true"></span>

    {%- if section.settings.heading != blank -%}
      <h2 class="somna-ess__title">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="somna-ess__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign product = block.settings.product
          assign card_title = block.settings.title | default: product.title
          assign card_image = block.settings.image | default: product.featured_image
          assign card_link = block.settings.link | default: product.url | default: '#'

          assign card_price = ''
          if product != blank
            assign base_price = product.price | default: 0
            if product.compare_at_price > product.price
              assign base_price = product.compare_at_price
            endif
            assign discount_percent = 0
            for group in product.selling_plan_groups
              for plan in group.selling_plans
                for adjustment in plan.price_adjustments
                  if adjustment.value_type == 'percentage'
                    assign discount_percent = adjustment.value
                    break
                  endif
                endfor
                if discount_percent > 0
                  break
                endif
              endfor
              if discount_percent > 0
                break
              endif
            endfor
            if discount_percent > 0
              assign multiplier = 100 | minus: discount_percent
              assign card_price = base_price | times: multiplier | divided_by: 100 | money
            else
              assign card_price = product.price | money
            endif
          endif
        -%}
        <a href="{{ card_link }}" class="somna-ess__card" {{ block.shopify_attributes }}>
          <div class="somna-ess__media">
            {%- if card_image != blank -%}
              {{
                card_image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '360, 520, 720, 960, 1200',
                  sizes: '(min-width: 990px) 470px, (min-width: 750px) 45vw, 46vw',
                  alt: card_title,
                  class: 'somna-ess__image'
              }}
            {%- else -%}
              {{ 'product-1' | placeholder_svg_tag: 'somna-ess__image somna-ess__image--placeholder' }}
            {%- endif -%}
          </div>
          <div class="somna-ess__info">
            {%- if card_title != blank -%}
              <h3 class="somna-ess__name">{{ card_title }}</h3>
            {%- endif -%}
            {%- if card_price != blank -%}
              <p class="somna-ess__price">{{ block.settings.price_prefix }} {{ card_price }}</p>
            {%- endif -%}
            {%- if block.settings.subtext != blank -%}
              <p class="somna-ess__subtext">{{ block.settings.subtext }}</p>
            {%- endif -%}
            {%- if block.settings.button_label != blank -%}
              <span class="somna-ess__button">{{ block.settings.button_label }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .somna-ess {
    color: #0a1a4a;
  }

  /* ---------- Mobile (Figma frame, 393px wide) ---------- */
  .somna-ess__inner {
    position: relative;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    padding-inline: 17px;
  }

  .somna-ess__title {
    margin: 0 0 17px;
    font-family: var(--headfont, var(--font-heading--family));
    font-size: 18px;
    font-weight: 500;
    line-height: 0.98;
    letter-spacing: normal;
    text-align: center;
    text-transform: none;
    color: #0a1a4a;
  }

  .somna-ess__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .somna-ess__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    box-sizing: border-box;
    padding: 5px 5px 7px;
    border-radius: 10px;
    background: #ffffff;
    box-shadow: 0 0 4px 0 rgb(0 0 0 / 0.25);
    color: #0a1a4a;
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
  }

  .somna-ess__media {
    position: relative;
    overflow: hidden;
    aspect-ratio: 163 / 95;
    border-radius: 7px;
    background: #efe7d6;
  }

  .somna-ess__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .somna-ess__image--placeholder {
    opacity: 0.3;
  }

  .somna-ess__info {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 5px 3px 0;
    font-family: var(--font-body--family);
  }

  .somna-ess__name,
  .somna-ess__price,
  .somna-ess__subtext {
    margin: 0;
    color: #0a1a4a;
    line-height: normal;
    letter-spacing: normal;
    text-transform: none;
  }

  .somna-ess__name {
    font-family: var(--font-body--family);
    font-size: 9px;
    font-weight: 600;
  }

  .somna-ess__price {
    margin-top: 2px;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
  }

  .somna-ess__subtext {
    margin-top: 2px;
    font-size: 8px;
    font-weight: 400;
  }

  .somna-ess__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    min-width: 62px;
    height: 23px;
    margin-top: 5px;
    padding: 0 12px;
    border-radius: 20px;
    background: #0a1a4a;
    color: #ffffff;
    font-family: var(--font-body--family);
    font-size: 8px;
    font-weight: 400;
    line-height: 1;
    white-space: nowrap;
    transition: background-color 0.28s ease, translate 0.28s ease, box-shadow 0.28s ease;
  }

  .somna-ess__card:focus-visible {
    outline: 2px solid #0a1a4a;
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .somna-ess__card:hover .somna-ess__button {
      background: #1b2c66;
      translate: 0 -2px;
      box-shadow: 0 10px 22px -12px rgb(10 26 74 / 0.45);
    }
  }

  /* Decorations from the Figma frame: blue tape (left edge), yellow dots, red/blue strips (right edge).
     Out of the layout flow and can't be tapped. */
  .somna-ess__deco {
    position: absolute;
    z-index: 2;
    display: block;
    background-repeat: no-repeat;
    background-size: 100% 100%;
    pointer-events: none;
  }

  .somna-ess__deco--tape {
    top: calc(var(--ess-pad-top) - 5px);
    left: 0;
    width: 33px;
    height: 49px;
  }

  .somna-ess__deco--dots-left,
  .somna-ess__deco--dots-right {
    width: 14px;
    height: 10px;
  }

  .somna-ess__deco--dots-left {
    top: -15px;
    left: 42px;
  }

  .somna-ess__deco--dots-right {
    top: 28px;
    right: 9px;
  }

  .somna-ess__deco--strips {
    top: calc(var(--ess-pad-top) + 179px);
    right: 0;
    width: 39px;
    height: 73px;
  }

  /* ---------- Tablet ---------- */
  @media screen and (min-width: 750px) {
    .somna-ess__inner {
      max-width: 860px;
      padding-inline: 40px;
    }

    .somna-ess__title {
      margin-bottom: 28px;
      font-size: 30px;
    }

    .somna-ess__grid {
      gap: 20px;
    }

    .somna-ess__card {
      padding: 8px 8px 14px;
      border-radius: 14px;
    }

    .somna-ess__media {
      border-radius: 10px;
    }

    .somna-ess__info {
      padding: 12px 8px 0;
    }

    .somna-ess__name {
      font-size: 15px;
    }

    .somna-ess__price {
      margin-top: 4px;
      font-size: 20px;
    }

    .somna-ess__subtext {
      margin-top: 3px;
      font-size: 13px;
    }

    .somna-ess__button {
      min-width: 110px;
      height: 38px;
      margin-top: 12px;
      padding: 0 22px;
      border-radius: 30px;
      font-size: 13px;
    }

    .somna-ess__deco--tape {
      top: calc(var(--ess-pad-top) - 10px);
      width: 50px;
      height: 74px;
    }

    .somna-ess__deco--dots-left,
    .somna-ess__deco--dots-right {
      width: 21px;
      height: 15px;
    }

    .somna-ess__deco--dots-left {
      top: -24px;
      left: 72px;
    }

    .somna-ess__deco--dots-right {
      top: 46px;
      right: 14px;
    }

    .somna-ess__deco--strips {
      top: auto;
      bottom: calc(var(--ess-pad-bottom) - 40px);
      width: 58px;
      height: 109px;
    }
  }

  /* ---------- Desktop ---------- */
  @media screen and (min-width: 990px) {
    .somna-ess__inner {
      max-width: 1080px;
      padding-inline: 60px;
    }

    .somna-ess__title {
      margin-bottom: 36px;
      font-size: 40px;
    }

    .somna-ess__grid {
      gap: 28px;
    }

    .somna-ess__card {
      padding: 10px 10px 20px;
      border-radius: 18px;
    }

    .somna-ess__media {
      border-radius: 12px;
    }

    .somna-ess__info {
      padding: 16px 12px 0;
    }

    .somna-ess__name {
      font-size: 18px;
    }

    .somna-ess__price {
      margin-top: 6px;
      font-size: 26px;
    }

    .somna-ess__subtext {
      margin-top: 4px;
      font-size: 15px;
    }

    .somna-ess__button {
      min-width: 132px;
      height: 44px;
      margin-top: 16px;
      padding: 0 28px;
      border-radius: 40px;
      font-size: 15px;
    }

    .somna-ess__deco--tape {
      top: calc(var(--ess-pad-top) - 14px);
      width: 62px;
      height: 92px;
    }

    .somna-ess__deco--dots-left,
    .somna-ess__deco--dots-right {
      width: 28px;
      height: 20px;
    }

    .somna-ess__deco--dots-left {
      top: -30px;
      left: 110px;
    }

    .somna-ess__deco--dots-right {
      top: 60px;
      right: 20px;
    }

    .somna-ess__deco--strips {
      bottom: calc(var(--ess-pad-bottom) - 56px);
      width: 74px;
      height: 138px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop the essentials",
  "class": "somna-ess-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop the essentials"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 80,
      "step": 1,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (tablet and desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (tablet and desktop)",
      "min": 0,
      "max": 120,
      "step": 2,
      "unit": "px",
      "default": 40
    }
  ],
  "blocks": [
    {
      "type": "product_card",
      "name": "Product card",
      "limit": 4,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product",
          "info": "Price and link come from this product."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Leave empty to use the product's main image."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Leave empty to use the product title."
        },
        {
          "type": "text",
          "id": "price_prefix",
          "label": "Price prefix",
          "default": "From"
        },
        {
          "type": "text",
          "id": "subtext",
          "label": "Text under the price",
          "default": "Subscribe & Save"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Shop now"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link",
          "info": "Leave empty to link to the product."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the essentials",
      "blocks": [
        { "type": "product_card" },
        { "type": "product_card" }
      ]
    }
  ]
}
{% endschema %}
