{%- comment -%}
  Somna sale product (Halloween Sale page, Figma 3316:8669 desktop / 3316:11976 mobile).
  One product per section: image, rating, eyebrow, headline, description, the same buy box as the
  product page (variant-picker + buy-buttons theme blocks, i.e. snippets/variant-main-picker and
  snippets/somna-subscription-widget) and a "See full details" link.
  All product data (prices, plans, variants, rating) comes from the chosen product; nothing is hardcoded.
  It works like Horizon's "Featured product information" section: the <featured-product-information>
  wrapper makes variant changes re-render this section from the product's URL.
  Two of these placed one after the other sit side by side from 750px (custom.css / somna-home-desktop.css,
  "SOMNA SALE PRODUCT"). Optional Halloween spiderweb (+ spider on the left web) reuses the homepage
  animation in assets/somna-motion.css, section 15.
{%- endcomment -%}
{%- liquid
  assign sp_product = section.settings.product
  if request.visual_preview_mode and sp_product == blank
    assign sp_product = collections.all.products.first
  endif

  assign sp_anchor = section.settings.anchor_id | handleize
  assign sp_web = section.settings.web

  assign sp_image = section.settings.image
  if sp_image == blank and sp_product != blank
    assign sp_image = sp_product.featured_media.preview_image
  endif

  assign sp_rating = ''
  assign sp_count = ''
  if sp_product != blank
    assign sp_review_raw = sp_product.metafields.custom.custom_review_rating_review_count.value | default: '' | strip_html | strip
    if sp_review_raw != blank
      assign sp_rating = sp_review_raw | split: ' ' | first | strip
      if sp_review_raw contains '('
        assign sp_count = sp_review_raw | split: '(' | last | split: ')' | first | strip
      endif
    endif
  endif
  assign sp_rating_num = sp_rating | plus: 0
  assign sp_rating_pct = sp_rating_num | times: 20

  assign sp_eyebrow = section.settings.eyebrow | default: sp_product.title
  assign sp_details_link = section.settings.details_link | default: sp_product.url
-%}

{%- if sp_product != blank -%}
<featured-product-information
  id="{{ section.id }}"
  class="somna-sp somna-sp--web-{{ sp_web }}{% if sp_web != 'none' %} somna-sp--halloween{% endif %}"
  style="--sp-bg: {{ section.settings.background_color }};"
>
  {%- if sp_web == 'left' -%}
    <span class="somna-ess__web somna-ess__web--left" aria-hidden="true">
      <svg class="somna-ess__web-svg" viewBox="0 0 439 268" width="439" height="268" focusable="false">
        <defs>
          <mask id="somna-spweb-{{ section.id }}" maskUnits="userSpaceOnUse" x="-20" y="-20" width="480" height="310">
            <path class="hw-m hw-m--frame" pathLength="1" d="M0 2 L300 2"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.15s" d="M65 70 L55.9 -4.0"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.21s" d="M65 70 L-3.0 8.8"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.27s" d="M65 70 L-4.0 62.8"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.33s" d="M65 70 L120.2 -3.2"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.39s" d="M65 70 L189.7 -2.0"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.45s" d="M65 70 L284.2 -1.2"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.51s" d="M65 70 L-2.2 173.4"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.57s" d="M65 70 L-0.6 271.8"/>
            <path class="hw-m hw-m--ring" pathLength="1" style="--t:0.5s;--d:0.5s" d="M62.9 81.8 A12 12 0 1 1 76.8 67.9 L102.4 63.4 A38 38 0 1 0 58.4 107.4 L53.9 133.0 A64 64 0 1 1 128.0 58.9 L153.6 54.4 A90 90 0 1 0 49.4 158.6 L44.9 184.2 A116 116 0 1 1 179.2 49.9"/>
            <path class="hw-m hw-m--ring" pathLength="1" style="--t:0.95s;--d:0.5s" d="M204.8 45.3 A142 142 0 1 0 40.3 209.8 L35.8 235.4 A168 168 0 1 1 230.4 40.8 L256.1 36.3 A194 194 0 1 0 31.3 261.1 L26.8 286.7 A220 220 0 1 1 281.7 31.8 L307.3 27.3 A246 246 0 1 0 22.3 312.3"/>
            <rect class="hw-m--all" x="-20" y="-20" width="480" height="310" fill="#fff"/>
          </mask>
        </defs>
        <image href="{{ 'somna-hw-web.png' | asset_url }}" width="439" height="268" mask="url(#somna-spweb-{{ section.id }})"/>
      </svg>
      <span class="somna-spider">
        <i class="somna-spider__thread"></i>
        <img class="somna-spider__body" src="{{ 'somna-hw-spider.png' | asset_url }}" alt="" width="90" height="100" loading="lazy" decoding="async">
      </span>
    </span>
  {%- elsif sp_web == 'right' -%}
    <span class="somna-ess__web somna-ess__web--right" aria-hidden="true">
      <svg class="somna-ess__web-svg" viewBox="0 0 333 178" width="333" height="178" focusable="false">
        <defs>
          <mask id="somna-spweb-r-{{ section.id }}" maskUnits="userSpaceOnUse" x="-20" y="-20" width="380" height="220">
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.35s" d="M286 62 L308.7 -3.8"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.43s" d="M286 62 L336.4 31.7"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.51s" d="M286 62 L218.9 -2.8"/>
            <path class="hw-m hw-m--spoke" pathLength="1" style="--t:0.59s" d="M286 62 L336.6 86.7"/>
            <path class="hw-m hw-m--ring" pathLength="1" style="--t:0.6s;--d:0.5s" d="M296.0 62.0 A10 10 0 0 1 281.0 70.7 A10 10 0 0 1 281.0 53.3 A10 10 0 0 1 296.0 62.0 M322.0 61.9 A36 36 0 0 0 268.0 30.8 A36 36 0 0 0 268.0 93.2 A36 36 0 0 0 322.0 62.0 M345.0 81.2 A62 62 0 0 1 224.0 62.0 A62 62 0 0 1 345.0 42.8 M238.1 -11.8 A88 88 0 0 0 216.2 115.6 A88 88 0 0 0 344.9 127.4 M344.7 159.7 A114 114 0 0 1 198.7 -11.3"/>
            <path class="hw-m hw-m--ring" pathLength="1" style="--t:1.05s;--d:0.55s" d="M166.0 -10.1 A140 140 0 0 0 229.1 189.9 M179.3 189.2 A166 166 0 0 1 136.8 -10.8 M108.0 -9.9 A192 192 0 0 0 141.1 188.0 M107.4 187.0 A218 218 0 0 1 79.9 -9.0 M52.7 -9.3 A244 244 0 0 0 76.9 187.7 M47.6 188.8 A270 270 0 0 1 25.2 -7.9 M-1.2 -9.6 A296 296 0 0 0 17.7 187.1 M-10.4 187.8 A322 322 0 0 0 -10.4 187.8"/>
            <rect class="hw-m--all" x="-20" y="-20" width="380" height="220" fill="#fff"/>
          </mask>
        </defs>
        <image href="{{ 'somna-hw-web-right.png' | asset_url }}" width="333" height="178" mask="url(#somna-spweb-r-{{ section.id }})"/>
      </svg>
    </span>
  {%- endif -%}

  <div class="somna-sp__inner"{% if sp_anchor != blank %} id="{{ sp_anchor }}"{% endif %}>
    <div class="somna-sp__media">
      {%- if sp_image != blank -%}
        <a href="{{ sp_product.url }}" class="somna-sp__image-link" tabindex="-1" aria-hidden="true">
          {{
            sp_image
            | image_url: width: 1200
            | image_tag:
              loading: 'lazy',
              class: 'somna-sp__image',
              widths: '400, 600, 800, 1000, 1200',
              sizes: '(min-width: 750px) min(45vw, 600px), calc(100vw - 32px)',
              alt: sp_product.title
          }}
        </a>
      {%- endif -%}
    </div>

    <div class="somna-sp__intro">
      {%- if section.settings.show_rating and sp_rating != blank -%}
        <p class="somna-sp__rating">
          <span class="somna-sp__rating-value">{{ sp_rating }}</span>
          <span class="somna-sp__stars" style="--sp-rating: {{ sp_rating_pct }}%;" role="img" aria-label="{{ sp_rating }} out of 5 stars">★★★★★</span>
          {%- if sp_count != blank -%}
            <span class="somna-sp__rating-count">({{ sp_count }})</span>
          {%- endif -%}
        </p>
      {%- endif -%}
      {%- if sp_eyebrow != blank -%}
        <p class="somna-sp__eyebrow">{{ sp_eyebrow | escape }}</p>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="somna-sp__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <div class="somna-sp__text">{{ section.settings.description }}</div>
      {%- endif -%}
    </div>

    <div class="somna-sp__panel">
      {% content_for 'block', type: 'variant-picker', id: 'variant-picker' %}
      {% content_for 'block', type: 'buy-buttons', id: 'buy-buttons' %}
      {%- if section.settings.flex_text != blank -%}
        <p class="somna-buybox-flex">
          <svg class="somna-buybox-flex__icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><g fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 12a8 8 0 1 1-2.34-5.66"/><path d="M20 4v5h-5"/></g></svg>
          {{ section.settings.flex_text | escape }}
        </p>
      {%- endif -%}
      {%- if section.settings.show_delivery -%}
        <p class="somna-buybox-delivery">
          Order today · arrives <strong data-somna-arrival>in 7–9 business days</strong>{% if section.settings.delivery_suffix != blank %} {{ section.settings.delivery_suffix | escape }}{% endif %}
        </p>
      {%- endif -%}
      {% content_for 'blocks' %}
    </div>

    {%- if section.settings.details_label != blank -%}
      <a class="somna-sp__details" href="{{ sp_details_link }}">{{ section.settings.details_label | escape }}</a>
    {%- endif -%}
  </div>
</featured-product-information>

<script>
  (() => {
    const root = document.getElementById({{ section.id | json }});
    if (!root || root.dataset.spInit) return;
    root.dataset.spInit = '1';

    /* Delivery window = today + 7 to 9 business days (Mon–Fri), e.g. "Oct 22–26" — same as the product page. */
    const addBusinessDays = (from, count) => {
      const date = new Date(from);
      let added = 0;
      while (added < count) {
        date.setDate(date.getDate() + 1);
        const day = date.getDay();
        if (day !== 0 && day !== 6) added += 1;
      }
      return date;
    };
    const first = addBusinessDays(new Date(), 7);
    const last = addBusinessDays(new Date(), 9);
    const month = (date) => date.toLocaleString('en-US', { month: 'short' });
    const arrival =
      month(first) === month(last)
        ? `${month(first)} ${first.getDate()}–${last.getDate()}`
        : `${month(first)} ${first.getDate()}–${month(last)} ${last.getDate()}`;
    root.querySelectorAll('[data-somna-arrival]').forEach((el) => {
      el.textContent = arrival;
    });

    /* Preselect the size set in the theme editor ("2 Bags"), like the product page does.
       Clicking the real option runs the normal variant change (prices, plans, cart form). */
    const wanted = {{ section.settings.default_option | downcase | strip | json }};
    if (wanted) {
      const selectDefault = () => {
        const inputs = root.querySelectorAll('variant-picker input[type="radio"]');
        const input = Array.from(inputs).find((el) => el.value.toLowerCase().trim().startsWith(wanted));
        if (input && !input.checked && input.getAttribute('aria-disabled') !== 'true') input.click();
      };
      const run = () => customElements.whenDefined('variant-picker').then(selectDefault);
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', run);
      } else {
        run();
      }
    }

    /* Halloween web / spider: same trigger as the homepage (assets/somna-motion.css, section 15).
       Starts when the web is a quarter of the way up the screen and replays each time the section
       comes back into view. Without this script (or with reduced motion) everything shows still. */
    if (root.classList.contains('somna-sp--halloween') && 'IntersectionObserver' in window) {
      const target = root.querySelector('.somna-ess__web') || root;
      root.classList.add('hw-ready');
      new IntersectionObserver(
        (entries) => {
          if (entries[0].isIntersecting) root.classList.add('is-in');
        },
        { rootMargin: '0px 0px -25% 0px' }
      ).observe(target);
      new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) root.classList.remove('is-in');
      }).observe(root);
    }
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Somna sale product",
  "class": "somna-sp-section",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave empty to use the product's main image"
    },
    {
      "type": "text",
      "id": "anchor_id",
      "label": "Anchor ID",
      "info": "Lets a button jump here, e.g. link #hw-nasal-strips"
    },
    {
      "type": "header",
      "content": "Text"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show rating",
      "info": "From the product's review metafield (custom.custom_review_rating_review_count)",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "info": "Leave empty to use the product title"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "text",
      "id": "details_label",
      "label": "Details link label",
      "default": "See full product details"
    },
    {
      "type": "url",
      "id": "details_link",
      "label": "Details link",
      "info": "Leave empty to link to the product page"
    },
    {
      "type": "header",
      "content": "Buy box"
    },
    {
      "type": "text",
      "id": "default_option",
      "label": "Preselected size",
      "info": "Size picked on page load, matched by its start (e.g. 2 Bags). Leave empty to keep the first available.",
      "default": "2 Bags"
    },
    {
      "type": "text",
      "id": "flex_text",
      "label": "Text under the button",
      "default": "Skip, pause or cancel anytime · no commitment"
    },
    {
      "type": "checkbox",
      "id": "show_delivery",
      "label": "Show delivery date",
      "default": true
    },
    {
      "type": "text",
      "id": "delivery_suffix",
      "label": "Text after the delivery date",
      "default": "· 30-Night guarantee"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "web",
      "label": "Halloween spiderweb",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "left",
          "label": "Top left, with spider"
        },
        {
          "value": "right",
          "label": "Top right"
        }
      ],
      "default": "none"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#ffffff"
    }
  ],
  "presets": [
    {
      "name": "Somna sale product",
      "category": "t:categories.products",
      "blocks": {
        "variant-picker": {
          "type": "variant-picker",
          "static": true,
          "settings": {
            "variant_style": "buttons",
            "option_label_text_color": "#0a1a4a"
          }
        },
        "buy-buttons": {
          "type": "buy-buttons",
          "static": true,
          "settings": {
            "stacking": true,
            "show_pickup_availability": false
          },
          "blocks": {
            "quantity": {
              "type": "quantity",
              "static": true
            },
            "add-to-cart": {
              "type": "add-to-cart",
              "static": true
            },
            "accelerated-checkout": {
              "type": "accelerated-checkout",
              "static": true
            }
          }
        }
      }
    }
  ]
}
{% endschema %}