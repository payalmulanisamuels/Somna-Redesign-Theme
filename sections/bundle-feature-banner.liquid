{%- liquid
  assign selected_product = section.settings.product
  
  # Title fallback
  assign section_title = section.settings.title
  if section_title == blank and selected_product != blank
    assign section_title = selected_product.title
  endif

 # Base one-time price
  assign base_price = selected_product.price
  if selected_product.compare_at_price > selected_product.price
    assign base_price = selected_product.compare_at_price
  endif

  # 1. Detect dynamic discount from Selling Plans
  assign auto_discount_percent = 0
  for group in selected_product.selling_plan_groups
    for plan in group.selling_plans
      for adjustment in plan.price_adjustments
        if adjustment.value_type == 'percentage'
          assign auto_discount_percent = adjustment.value
          break
        endif
      endfor
      if auto_discount_percent > 0
        break
      endif
    endfor
    if auto_discount_percent > 0
      break
    endif
  endfor

  # 2. Fallback to schema setting if product has no selling plan discount
  assign final_discount = auto_discount_percent
  if final_discount == 0
    assign final_discount = section.settings.subscription_discount
  endif

  # 3. Calculate Subscription Price
  assign sub_price = section.settings.sub_price_override
  if sub_price == blank and selected_product != blank
    if final_discount > 0
      assign discount_multiplier = 100 | minus: final_discount
      assign calculated_price = base_price | times: discount_multiplier | divided_by: 100
      assign sub_price = calculated_price | money_without_trailing_zeros
    else
      assign sub_price = selected_product.price | money_without_trailing_zeros
    endif
  endif

  # 4. One-Time Price
  assign onetime_price = section.settings.onetime_price_override
  if onetime_price == blank and selected_product != blank
    assign onetime_price = base_price | money_without_trailing_zeros
  endif

  # Dynamic URL
  if  selected_product != blank
    assign button_link = selected_product.url
  endif

  # Dynamic Image
  assign banner_image = section.settings.image
  if banner_image == blank and selected_product != blank and selected_product.featured_image != blank
    assign banner_image = selected_product.featured_image
  endif
-%}

<div class="hz-bundle-section" id="hz-bundle-{{ section.id }}" style="background-color: {{ section.settings.bg_color }};">
   {% comment %} Top Wave Divider {% endcomment %}

    {% if section.settings.top_wave_image != blank %}
    <div class="wave-container top">

    <img 
        src="{{ section.settings.top_wave_image | image_url: width: 1440 }}" 
        alt="top_wave_image" 
        loading="lazy" 
        class="custom-wave-img"
        />
    </div>
    {% endif %}

    {% comment %} Bottom Wave Divider {% endcomment %}

    {% if section.settings.bottom_wave_image != blank %}
    <div class="wave-container bottom">
    <img 
        src="{{ section.settings.bottom_wave_image | image_url: width: 1440 }}" 
        alt="bottom_wave_image" 
        loading="lazy" 
        class="custom-wave-img"
        />
    </div>
    {% endif %}
  <div class="hz-bundle-container-main">
  <div class="hz-bundle-container">
    
    <!-- Left Media Column -->
    <div class="hz-bundle-media">
      {% if banner_image != blank %}
        <div class="hz-bundle-image-wrap">
          <img
            src="{{ banner_image | image_url: width: 900 }}"
            alt="{{ section_title | escape }}"
            loading="lazy"
            width="{{ banner_image.width }}"
            height="{{ banner_image.height }}"
          />
        </div>
      {% else %}
        <div class="hz-bundle-placeholder">
          {{ 'product-1' | placeholder_svg_tag: 'hz-placeholder' }}
        </div>
      {% endif %}
    </div>

    <!-- Right Content Column -->
    <div class="hz-bundle-content">
      {% if section_title != blank %}
        <h2 class="hz-bundle-title">{{ section_title }}</h2>
      {% endif %}

      {% if section.settings.subtitle != blank %}
        <p class="hz-bundle-subtitle">{{ section.settings.subtitle }}</p>
      {% endif %}

      <div class="hz-bundle-pricing-row">
        {% if sub_price != blank %}
          <div class="hz-bundle-sub-price">
            <span class="hz-price-large">{{ sub_price }}</span>
            <span class="hz-price-sub-label">{{ section.settings.sub_label }}</span>
          </div>
        {% endif %}

        {% if onetime_price != blank %}
          <div class="hz-bundle-divider" aria-hidden="true"></div>
          <div class="hz-bundle-onetime-price">
            <span class="hz-price-regular">{{ onetime_price }}</span>
            <span class="hz-price-onetime-label">{{ section.settings.onetime_label }}</span>
          </div>
        {% endif %}
      </div>

      {% if section.settings.button_label != blank %}
        <a href="{{ button_link }}" class="hz-bundle-btn">
          <span>{{ section.settings.button_label }}</span>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <line x1="5" y1="12" x2="19" y2="12"></line>
            <polyline points="12 5 19 12 12 19"></polyline>
          </svg>
        </a>
      {% endif %}
    </div>

  </div>
  </div>
</div>

<style>
    .bundle_feature_banner{
        display: block;
    }
  .hz-bundle-section {
    position: relative;
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
    overflow: hidden;
  }
  .hz-bundle-container-main{
    padding-right: 15px;
  }
  .hz-bundle-container {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }

  /* Left Side Image */
  .hz-bundle-media {
    flex: 0 0 48%;
    max-width: 48%;
    display: flex;
    justify-content: center;
    align-items: center;
  }
  .hz-bundle-image-wrap {
    width: 100%;
    max-width: 480px;
    line-height: 0;
    margin-bottom: -55px;
  }
  .hz-bundle-image-wrap img {
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }
  .hz-bundle-placeholder {
    width: 100%;
    max-width: 440px;
    height: 320px;
    background: #fdf5d6;
    border-radius: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hz-bundle-placeholder svg {
    width: 50%;
    height: 50%;
    opacity: 0.25;
  }

  /* Right Side Content */
  .hz-bundle-content {
    flex: 0 0 52%;
    max-width: 52%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .hz-bundle-title {
    font-size: 14px;
    font-family: var(--headfont);
    font-weight: 500;
    line-height: 1.15;
    color: var(--color-text);
    margin: 0 0 2px 0;
  }
  .hz-bundle-subtitle {
    font-size: 12px;
    line-height: 1;
    color: #0A1A4A;
    margin:0 0 4px 0;
    font-weight: 400;
  }
    .hz-bundle-btn svg {
        width: 10px;
        height: 10px;
    }
  /* Pricing Row */
  .hz-bundle-pricing-row {
    display: flex;
    align-items: center;
    gap: 5px;
    margin-bottom: 8px;
  }
  .hz-bundle-sub-price {
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }
  .hz-price-large {
    font-size: 16px;
    font-weight: 800;
    line-height: 1;
    color: #064BD8;
    letter-spacing: -0.02em;
  }
  .hz-price-sub-label {
    font-size: 8px;
    font-weight: 500;
    color: #064BD8;
  }
  .hz-bundle-divider {
    width: 1.5px;
    height: 32px;
    background-color: #d1d5db;
  }
  .hz-bundle-onetime-price {
    display: flex;
    align-items: flex-end;
    gap: 2px;
  }
  .hz-price-regular {
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
    color: #000;
  }
  .hz-price-onetime-label {
    font-size: 8px;
    color: #000;
    font-weight: 400;
  }

  /* Pill Button */
  .hz-bundle-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 7px 16px;
    border-radius: 99px;
    background-color: var(--color-text);
    color: #ffffff;
    text-decoration: none;
    font-size: 8px;
    margin-top: 8px;
  }
  .hz-bundle-btn:hover {
    background-color: #162f61;
    transform: translateY(-1px);
  }

  
</style>

{% schema %}
{
  "name": "Bundle Feature Banner",
  "tag": "section",
  "class": "section bundle_feature_banner",
  "settings": [
    {
      "type": "header",
      "content": "Wave Dividers"
    },
    {
      "type": "image_picker",
      "id": "top_wave_image",
      "label": "Top SVG Wave Image",
      "info": "Upload your custom top wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "bottom_wave_image",
      "label": "Bottom SVG Wave Image",
      "info": "Upload your custom bottom wave SVG file."
    },
    {
      "type": "product",
      "id": "product",
      "label": "Choose Bundle Product",
      "info": "Pulls dynamic price, title, image, and link automatically if left blank below."
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background Color",
      "default": "#faedd2"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Bundle Image",
      "info": "Overrides product featured image."
    },
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The Breathe Bundle"
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subheading",
      "default": "Blue Strips + Blue Tape, one month supply"
    },
    {
      "type": "header",
      "content": "Pricing Details"
    },
    {
      "type": "text",
      "id": "sub_price_override",
      "label": "Subscribe & Save Price",
      "info": "Defaults to product price (e.g., $59). You can override here."
    },
    {
      "type": "text",
      "id": "sub_label",
      "label": "Subscribe Label",
      "default": "Subscribe & Save"
    },
    {
      "type": "text",
      "id": "onetime_price_override",
      "label": "One-Time Price",
      "info": "Defaults to Compare-at price or product price. You can override here."
    },
    {
      "type": "text",
      "id": "onetime_label",
      "label": "One-Time Label",
      "default": "One-time"
    },
    {
      "type": "header",
      "content": "Call to Action"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button Label",
      "default": "Shop the Breathe Bundle"
    },
   
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Bundle Feature Banner"
    }
  ]
}
{% endschema %}