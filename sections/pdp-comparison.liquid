{%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.bottom_image != blank -%}
  <div 
    class="hz-simple-comp-section" 
    id="hz-comp-{{ section.id }}"
    style="{% if section.settings.background_image != blank %}background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}'); background-size: cover; background-position: center;{% else %}background-color: #fbf7ee;{% endif %}"
  >
    <div class="hz-simple-comp-container">
      {% if section.settings.heading != blank %}
        <h2 class="hz-simple-comp-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <p class="hz-simple-comp-subheading">{{ section.settings.subheading }}</p>
      {% endif %}

      {% if section.settings.bottom_image != blank %}
        <div class="hz-simple-comp-media">
          {{ section.settings.bottom_image | image_url: width: 1400 | image_tag: loading: 'lazy' }}
        </div>
      {% endif %}
    </div>
  </div>
{%- endif -%}

<style>
  .hz-simple-comp-section {
    position: relative;
    padding: 80px 20px 60px;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .hz-simple-comp-container {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .hz-simple-comp-heading {
    font-size: 42px;
    font-family: serif;
    font-weight: 500;
    color: #0b1a30;
    margin: 0 0 12px;
    line-height: 1.2;
  }

  .hz-simple-comp-subheading {
    font-size: 15px;
    color: #172437;
    margin: 0 auto 40px;
    max-width: 580px;
    line-height: 1.5;
  }

  .hz-simple-comp-media {
    width: 100%;
    display: flex;
    justify-content: center;
  }

  .hz-simple-comp-media img {
    max-width: 100%;
    height: auto;
    display: block;
    object-fit: contain;
  }

  @media (max-width: 768px) {
    .hz-simple-comp-section {
      padding: 50px 16px 40px;
    }
    .hz-simple-comp-heading {
      font-size: 32px;
    }
    .hz-simple-comp-subheading {
      font-size: 14px;
      margin-bottom: 25px;
    }
  }
</style>

{% schema %}
{
  "name": "Comparison Simple",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comparison"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Three individual 1-month Nasal Strips subscriptions would run $135 (3 × $45 Subscribe & Save)"
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Image"
    }
  ],
  "presets": [
    {
      "name": "Comparison Simple"
    }
  ]
}
{% endschema %}