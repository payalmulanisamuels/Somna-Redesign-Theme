{%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.bottom_image != blank -%}
  <div 
    class="hz-simple-comp-section" 
    id="hz-comp-{{ section.id }}"
    style="{% if section.settings.background_image != blank %}background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}'); background-size: cover; background-position: center;{% else %}background-color: #fbf7ee;{% endif %}"
  >
    <div class="section section--page-width">
      {% if section.settings.heading != blank %}
        <h2 class="hz-simple-comp-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="hz-simple-comp-subheading">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.bottom_image != blank %}
        <div class="hz-simple-comp-media">
          {{ section.settings.bottom_image | image_url: width: 1400 | image_tag: loading: 'lazy' }}
        </div>
      {% endif %}
    </div>
  </div>
{%- endif -%}

<style>
  .hz-simple-comp-section {
    position: relative;
    padding: 80px 0px 60px;
    width: 100%;
  }
  .hz-simple-comp-heading {
    font-size: 42px;
    font-family: serif;
    font-weight: 500;
    color: #0b1a30;
    margin: 0 0 12px;
    line-height: 1.2;
  }
  .hz-simple-comp-subheading {
    font-size: 10px;
    color: #0A1A4A;
    margin: 0 auto 40px;
    max-width: 580px;
    line-height: 1.5;
  }
  .hz-simple-comp-media {
    width: 100%;
    display: flex;
    justify-content: center;
  }
</style>

{% schema %}
{
  "name": "Comparison Simple",
  "settings": [
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comparison"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Image"
    }
  ],
  "presets": [
    {
      "name": "Comparison Simple"
    }
  ]
}
{% endschema %}