{%- if section.settings.heading != blank or section.settings.subheading != blank or section.settings.bottom_image != blank -%}
  <div 
    class="hz-simple-comp-section" 
    id="hz-comp-{{ section.id }}"
    style="{% if section.settings.background_image != blank %}background-image: url('{{ section.settings.background_image | image_url: width: 2000 }}'); background-size: cover; background-position: center;{% else %}background-color: #fbf7ee;{% endif %}"
  >
    
{% comment %} Top Wave Divider {% endcomment %}
    {% if section.settings.top_wave_image != blank %}
    <div class="wave-container top" style="background-image: url({{ section.settings.top_wave_image | image_url: width: 1440 }})">
    </div>
    {% endif %}
{% comment %} Bottom Wave Divider {% endcomment %}
{% if section.settings.bottom_wave_image != blank %}
<div class="wave-container bottom" style="background-image: url({{ section.settings.bottom_wave_image | image_url: width: 1440 }})">
</div>
{% endif %}


    <div class="section section--page-width">
    <div class="comp-container">
      {% if section.settings.heading != blank %}
        <h2 class="hz-simple-comp-heading">{{ section.settings.heading }}</h2>
      {% endif %}

      {% if section.settings.subheading != blank %}
        <div class="hz-simple-comp-subheading">{{ section.settings.subheading }}</div>
      {% endif %}

      {% if section.settings.bottom_image != blank %}
        <div class="hz-simple-comp-media">
          {{ section.settings.bottom_image | image_url: width: 1400 | image_tag: loading: 'lazy' }}
        </div>
      {% endif %}
    </div>
    </div>
  </div>
{%- endif -%}

<style>
  .comp-container{
    padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;
  }
  .hz-simple-comp-section {
    position: relative;
    padding: 20px 0px;
    width: 100%;
    background: #fff9ed;
  }
  .hz-simple-comp-heading {
    font-size: 18px;
    font-weight: 500;
    color: #0A1A4A;
    margin: 0 0 8px;
    line-height: 1.2;
    font-family: var(--headfont);
    text-align: center;
  }
  .hz-simple-comp-subheading {
    font-size: 10px;
    color: #0A1A4A;
    margin: 0 auto;
    max-width: 580px;
    line-height: 1.5;
    text-align: center;
  }
  .hz-simple-comp-media {
    width: 100%;
    display: flex;
    justify-content: center;
    margin-top: 21px;
    max-width: 800px;
    margin: 0 auto;
  }
</style>

{%- comment -%} Desktop settings (990px and up); empty = same as mobile {%- endcomment -%}
<style>
  @media screen and (min-width: 990px) {
    {% if section.settings.content_width_desktop != blank %}#shopify-section-{{ section.id }} { --page-content-width: {{ section.settings.content_width_desktop }}; --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2)); }{% endif %}
    {% if section.settings.min_height_desktop != blank %}
      #hz-comp-{{ section.id }} { display: flex; align-items: center; min-height: {{ section.settings.min_height_desktop }}vw; }
      #hz-comp-{{ section.id }} > .section { width: 100%; }
    {% endif %}
    {% if section.settings.padding_top_desktop != blank %}#hz-comp-{{ section.id }} .comp-container { padding-top: {{ section.settings.padding_top_desktop }}px; }{% endif %}
    {% if section.settings.padding_bottom_desktop != blank %}#hz-comp-{{ section.id }} .comp-container { padding-bottom: {{ section.settings.padding_bottom_desktop }}px; }{% endif %}
    {% if section.settings.heading_size_desktop != blank %}
      #hz-comp-{{ section.id }} .hz-simple-comp-heading { margin-bottom: 0.6em; font-size: {{ section.settings.heading_size_desktop }}px; line-height: 1.05; letter-spacing: -0.015em; }
    {% endif %}
    {% if section.settings.subheading_size_desktop != blank %}
      #hz-comp-{{ section.id }} .hz-simple-comp-subheading { font-size: {{ section.settings.subheading_size_desktop }}px; line-height: 1.5; }
    {% endif %}
    {% if section.settings.subheading_width_desktop != blank %}
      #hz-comp-{{ section.id }} .hz-simple-comp-subheading { max-width: {{ section.settings.subheading_width_desktop }}px; }
    {% endif %}
  }
</style>

{% schema %}
{
  "name": "Comparison Simple",
  "settings": [
      {
      "type": "header",
      "content": "Wave Dividers"
    },
    {
      "type": "image_picker",
      "id": "top_wave_image",
      "label": "Top SVG Wave Image",
      "info": "Upload your custom top wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "bottom_wave_image",
      "label": "Bottom SVG Wave Image",
      "info": "Upload your custom bottom wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background Image"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Comparison"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
    },
    {
      "type": "image_picker",
      "id": "bottom_image",
      "label": "Bottom Image"
    },
    
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 60
    },
    {
      "type": "header",
      "content": "Desktop (990px and up)",
      "info": "Leave empty to use the mobile value."
    },
    {
      "type": "select",
      "id": "content_width_desktop",
      "label": "Content width (desktop)",
      "options": [
        {
          "value": "",
          "label": "Same as mobile"
        },
        {
          "value": "65rem",
          "label": "Narrow (1040px)"
        },
        {
          "value": "80rem",
          "label": "Wide (1280px)"
        },
        {
          "value": "90rem",
          "label": "Extra wide (1440px)"
        }
      ],
      "default": ""
    },
    {
      "type": "number",
      "id": "min_height_desktop",
      "label": "Band height (desktop, % of screen width)"
    },
    {
      "type": "number",
      "id": "padding_top_desktop",
      "label": "Top padding (desktop, px)"
    },
    {
      "type": "number",
      "id": "padding_bottom_desktop",
      "label": "Bottom padding (desktop, px)"
    },
    {
      "type": "number",
      "id": "heading_size_desktop",
      "label": "Heading size (desktop, px)"
    },
    {
      "type": "number",
      "id": "subheading_size_desktop",
      "label": "Subheading size (desktop, px)"
    },
    {
      "type": "number",
      "id": "subheading_width_desktop",
      "label": "Subheading max width (desktop, px)"
    }
  ],
  "presets": [
    {
      "name": "Comparison Simple"
    }
  ]
}
{% endschema %}