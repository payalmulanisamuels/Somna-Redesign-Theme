    { "type": "text", "id": "assess_levellbl", "label": "Disruption meter label", "default": "Sleep disruption level" },
    { "type": "text", "id": "stat_pattern", "label": "Stat 1 label", "default": "Pattern" },
    { "type": "text", "id": "stat_primary", "label": "Stat 2 label", "default": "Primary driver" },
    { "type": "text", "id": "stat_secondary", "label": "Stat 3 label", "default": "Secondary driver" },
    { "type": "text", "id": "stat_impact", "label": "Stat 4 label", "default": "Daytime impact" },
    { "type": "header", "content": "Result: Heavy Sleeper" },
    { "type": "text", "id": "type_b_name", "label": "Name", "default": "The Heavy Sleeper" },
    { "type": "textarea", "id": "type_b_desc", "label": "Description", "default": "Sound alarms barely register for you — so you snooze and oversleep. You're not lazy; you're built like a deep sleeper, and that's exactly what Somna is designed for." },
    { "type": "text", "id": "type_b_note", "label": "Guarantee note", "default": "30-day money-back guarantee." },
    { "type": "header", "content": "Result: Mouth Breather" },
    { "type": "text", "id": "type_t_name", "label": "Name", "default": "The Mouth Breather" },
    { "type": "textarea", "id": "type_t_desc", "label": "Description", "default": "You sleep through the night but breathe wrong the whole time — which is why you wake dry, foggy and unrested. Tape. is designed to fix that." },
    { "type": "text", "id": "type_t_note", "label": "Guarantee note", "default": "30-day money-back guarantee." },
    { "type": "header", "content": "Result: Night Rumbler" },
    { "type": "text", "id": "type_s_name", "label": "Name", "default": "The Night Rumbler" },
    { "type": "textarea", "id": "type_s_desc", "label": "Description", "default": "When your nose can't move enough air lying down, you snore — and your partner pays for it. Strips. are designed to open the airway." },
    { "type": "text", "id": "type_s_note", "label": "Guarantee note", "default": "30-day money-back guarantee." },
    { "type": "header", "content": "Result: Full Reset" },
    { "type": "text", "id": "type_full_name", "label": "Name", "default": "The Full Reset" },
    { "type": "textarea", "id": "type_full_desc", "label": "Description", "default": "Your sleep is breaking down in more than one place — waking, breathing and snoring. Fixing one won't cut it. The full system targets all three." },
