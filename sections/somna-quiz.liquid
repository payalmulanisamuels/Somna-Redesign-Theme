    { "type": "text", "id": "offer_guar_emph", "label": "Guarantee — underlined phrase", "default": "we guarantee you'll wake up more rested" },
    { "type": "text", "id": "offer_guar_post", "label": "Guarantee — end", "default": " with your 90-night SOMNA plan." },
    { "type": "text", "id": "offer_refund", "label": "Offer refund line", "default": "If your mornings don't change, you don't pay — full refund, no questions asked." },
