  ],
  "blocks": [
    { "type": "cust", "name": "Customer card", "settings": [
      { "type": "image_picker", "id": "img", "label": "Customer photo" },
      { "type": "text", "id": "caption", "label": "Top caption (what they said)", "default": "Best sleep in years." },
      { "type": "text", "id": "age", "label": "Age line", "default": "Age: 34" }
    ] }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Somna quiz", "blocks": [ {"type":"cust"},{"type":"cust"},{"type":"cust"},{"type":"cust"} ] }]
