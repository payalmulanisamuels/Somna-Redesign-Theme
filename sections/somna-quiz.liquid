{%- comment -%}
  SOMNA quiz v2 (built from SOMNA_Quiz_v2.docx, 23 Oct 2026). Replaces the v1 quiz completely.
  5 questions + optional email step + 1 result screen. No branching; Q1 "My partner" switches
  the wording to they/their. Scoring and result rules live in snippets/somna-quiz-script.liquid.
  CSS and JS are snippets rendered only by this section, so they load only on the quiz page.
{%- endcomment -%}
{%- liquid
  assign sid = section.id
  assign size_label = section.settings.preselect_size | default: '2 Bags'
  # Fall back to the live product handles if a product setting is empty (e.g. template out of sync)
  assign p_strips = section.settings.product_strips | default: all_products['nasal-strips']
  assign p_tape = section.settings.product_tape | default: all_products['mouth-tape']
  assign p_bundle = section.settings.product_bundle | default: all_products['sleep-bundle']
-%}

<section class="sq" id="sq-{{ sid }}" data-sq aria-label="Sleep quiz">
  <div class="sq-wrap">
    <div class="sq-logo">som<span>na.</span></div>
    <div class="sq-card">

      <div class="sq-top" data-sq-top>
        <button type="button" class="sq-back" data-sq-back hidden>
          <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M10 3 5 8l5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>Back</span>
        </button>
        <div class="sq-prog" role="progressbar" aria-label="Quiz progress" aria-valuemin="1" aria-valuemax="5" aria-valuenow="1" data-sq-prog>
          <div class="sq-prog-f" data-sq-progf></div>
        </div>
        <p class="sq-step" data-sq-step>1 of 5</p>
      </div>
      <p class="sq-sr" aria-live="polite" data-sq-live></p>

      {% render 'somna-quiz-screens', qs: section.settings, sid: sid %}

      {%- comment -%} Screen 6: optional email {%- endcomment -%}
      <div class="sq-s sq-center" data-type="email">
        <h2 class="sq-q" tabindex="-1">{{ section.settings.email_heading }}</h2>
        {%- comment -%} Klaviyo embed form (default "Footer Signup - 10% Off"): Klaviyo's onsite script draws the form here and adds the email to its list, which starts the Welcome Series with the 10% code. The script moves on to the result after a successful sign-up. {%- endcomment -%}
        <div class="sq-kl" data-sq-kl>
          {%- if section.settings.klaviyo_form_id != blank -%}<div class="klaviyo-form-{{ section.settings.klaviyo_form_id }}"></div>{%- endif -%}
        </div>
        <p class="sq-err" role="alert" data-sq-err hidden></p>
        {%- if section.settings.email_consent != blank -%}<p class="sq-fine">{{ section.settings.email_consent }}</p>{%- endif -%}
        <button type="button" class="sq-skip" data-sq-skip>{{ section.settings.email_skip }}</button>
      </div>

      {%- comment -%} Screen 7: one result panel per product; the script shows the matching one {%- endcomment -%}
      <div class="sq-s" data-type="result">
        <p class="sq-problem" data-sq-problem hidden></p>
        {%- for r in (1..3) -%}
          {%- liquid
            case r
              when 1
                assign rk = 'strips'
                assign rp = p_strips
                assign rname = section.settings.strips_name
                assign rself = section.settings.strips_self
                assign rpartner = section.settings.strips_partner
              when 2
                assign rk = 'tape'
                assign rp = p_tape
                assign rname = section.settings.tape_name
                assign rself = section.settings.tape_self
                assign rpartner = section.settings.tape_partner
              when 3
                assign rk = 'bundle'
                assign rp = p_bundle
                assign rname = section.settings.bundle_name
                assign rself = section.settings.bundle_self
                assign rpartner = section.settings.bundle_partner
            endcase
            assign rv = nil
            if rp != blank
              assign rv = rp.selected_or_first_available_variant
              for v in rp.variants
                if v.available and v.title contains size_label
                  assign rv = v
                  break
                endif
              endfor
            endif
          -%}
          <div class="sq-res" data-res="{{ rk }}" hidden
            data-url="{% if rp != blank %}{{ rp.url }}?variant={{ rv.id }}{% endif %}">
            <p class="sq-res-lbl" data-self="Your sleep type" data-partner="Their sleep type">Your sleep type</p>
            <h2 class="sq-res-name" tabindex="-1">{{ rname }}</h2>
            <p class="sq-res-desc" data-self="{{ rself | escape }}" data-partner="{{ rpartner | escape }}">{{ rself }}</p>
            {%- if rp != blank -%}
              <div class="sq-res-prod">
                {%- assign rimg = rv.featured_image | default: rp.featured_image -%}
                {%- if rimg != blank -%}
                  {{ rimg | image_url: width: 640 | image_tag: widths: '320, 480, 640', sizes: '(min-width: 750px) 300px, 70vw', loading: 'lazy', alt: rp.title, class: 'sq-res-img' }}
                {%- endif -%}
                <p class="sq-res-ptitle">{{ rp.title }}</p>
              </div>
            {%- endif -%}
          </div>
        {%- endfor -%}
        <p class="sq-tried" data-sq-tried hidden></p>
        {%- if section.settings.guarantee != blank -%}<p class="sq-guar">✓ {{ section.settings.guarantee }}</p>{%- endif -%}
        {%- if section.settings.social_proof != blank -%}<p class="sq-proof sq-proof--c">{{ section.settings.social_proof }}</p>{%- endif -%}
        <a class="sq-cta sq-cta--link" href="#" data-sq-go>{{ section.settings.result_button }}</a>
        <button type="button" class="sq-retake" data-sq-retake>Retake quiz</button>
      </div>

      <div class="sq-foot" data-sq-foot hidden>
        <button type="button" class="sq-next" data-sq-next>Next →</button>
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-sq-config>
  {
    "triedStrips": {{ section.settings.tried_strips_line | json }},
    "triedPills": {{ section.settings.tried_pills_line | json }},
    "klaviyoForm": {{ section.settings.klaviyo_form_id | json }}
  }
</script>
{% render 'somna-quiz-styles' %}
{% render 'somna-quiz-script', sid: sid %}

{% schema %}
{
  "name": "SOMNA quiz v2",
  "class": "somna-quiz-section",
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "intro_heading", "label": "Heading", "default": "Snoring, stuffy nose or dry mouth? Find out what's ruining your sleep in 60 seconds." },
    { "type": "text", "id": "intro_sub", "label": "Subheading", "default": "Answer 5 quick questions and we'll match you to the right SOMNA fix." },
    { "type": "text", "id": "social_proof", "label": "Social proof line (intro + result)", "info": "Must be a provable customer count.", "default": "Join 1,000+ SOMNA sleepers." },
    { "type": "header", "content": "Email step (optional for shopper)" },
    { "type": "text", "id": "klaviyo_form_id", "label": "Klaviyo embed form ID", "info": "Default S7fEZF = Footer Signup - 10% Off. Its list starts the Welcome Series with the 10% code.", "default": "S7fEZF" },
    { "type": "text", "id": "email_heading", "label": "Heading", "default": "Where should we send your result + 10% off?" },
    { "type": "text", "id": "email_skip", "label": "Skip link", "default": "Skip" },
    { "type": "text", "id": "email_consent", "label": "Consent line", "default": "By signing up you agree to receive marketing emails from SOMNA. Unsubscribe anytime." },
    { "type": "header", "content": "Result screen" },
    { "type": "text", "id": "preselect_size", "label": "Size to pre-select on the product page", "default": "2 Bags" },
    { "type": "text", "id": "guarantee", "label": "Guarantee line", "default": "30-night money-back guarantee" },
    { "type": "text", "id": "result_button", "label": "Button", "default": "See my plan →" },
    { "type": "text", "id": "tried_strips_line", "label": "Q5 line: tried cheap strips", "default": "Cheap strips peel off by 2am. SOMNA Strips are structural, with an all-night adhesive." },
    { "type": "text", "id": "tried_pills_line", "label": "Q5 line: tried melatonin or pills", "default": "Drug-free – nothing to swallow." },
    { "type": "header", "content": "Result: problem line (from the Q2 answer)" },
    { "type": "text", "id": "problem_a_self", "label": "Q2 A – Snoring (me / both)", "default": "You told us snoring is the biggest problem at night." },
    { "type": "text", "id": "problem_a_partner", "label": "Q2 A – partner", "default": "You told us their snoring is the biggest problem at night." },
    { "type": "text", "id": "problem_b_self", "label": "Q2 B – Blocked or stuffy nose (me / both)", "default": "You told us a blocked or stuffy nose is keeping you up." },
    { "type": "text", "id": "problem_b_partner", "label": "Q2 B – partner", "default": "You told us their blocked or stuffy nose is the problem." },
    { "type": "text", "id": "problem_c_self", "label": "Q2 C – Dry mouth or sore throat (me / both)", "default": "You told us you wake up with a dry mouth or sore throat." },
    { "type": "text", "id": "problem_c_partner", "label": "Q2 C – partner", "default": "You told us they wake up with a dry mouth or sore throat." },
    { "type": "text", "id": "problem_d_self", "label": "Q2 D – Tired after 7–8 hours (me / both)", "default": "You told us you wake up tired, even after a full night." },
    { "type": "text", "id": "problem_d_partner", "label": "Q2 D – partner", "default": "You told us they wake up tired, even after a full night." },
    { "type": "header", "content": "Result: Nasal Strips" },
    { "type": "product", "id": "product_strips", "label": "Product" },
    { "type": "text", "id": "strips_name", "label": "Sleep type name", "default": "The Nose Breather" },
    { "type": "textarea", "id": "strips_self", "label": "Copy (me / both)", "default": "Your nose is the bottleneck. When airflow is restricted lying down, snoring and groggy mornings follow. SOMNA Strips are designed to hold your nose open all night." },
    { "type": "textarea", "id": "strips_partner", "label": "Copy (partner)", "default": "Their nose is the bottleneck. When airflow is restricted lying down, they snore – and you're the one losing sleep. SOMNA Strips are designed to hold their nose open all night." },
    { "type": "header", "content": "Result: Mouth Tape" },
    { "type": "product", "id": "product_tape", "label": "Product" },
    { "type": "text", "id": "tape_name", "label": "Sleep type name", "default": "The Mouth Breather" },
    { "type": "textarea", "id": "tape_self", "label": "Copy (me / both)", "default": "You're breathing through your mouth at night, which is why you wake up dry and groggy. SOMNA Tape is designed to keep your lips gently closed so you breathe through your nose." },
    { "type": "textarea", "id": "tape_partner", "label": "Copy (partner)", "default": "They're breathing through their mouth at night. SOMNA Tape is designed to keep their lips gently closed so they breathe through their nose." },
    { "type": "header", "content": "Result: Sleep Bundle" },
    { "type": "product", "id": "product_bundle", "label": "Product" },
    { "type": "text", "id": "bundle_name", "label": "Sleep type name", "default": "The Double Trouble" },
    { "type": "textarea", "id": "bundle_self", "label": "Copy (me / both)", "default": "It's your nose and your mouth. Strips open the airway; Tape keeps you breathing through it. Built to work together." },
    { "type": "textarea", "id": "bundle_partner", "label": "Copy (partner)", "default": "It's their nose and their mouth. Strips open the airway; Tape keeps them breathing through it. Built to work together." }
  ],
  "presets": [{ "name": "SOMNA quiz v2" }]
}
{% endschema %}