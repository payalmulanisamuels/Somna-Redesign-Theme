<div class="hz-not-sure-section" style="background-color: {{ section.settings.bg_color }};">
  {% comment %} Top Wave Divider {% endcomment %}
  {% if section.settings.top_wave_image != blank %}
    <div class="wave-container top" style="background-image: url({{ section.settings.top_wave_image | image_url: width: 1440 }})"></div>
  {% endif %}

  <div class="hz-not-sure-container">
    {% if section.settings.heading != blank %}
      <h2 class="hz-not-sure-heading" style="color: {{ section.settings.text_color }};">
        {{ section.settings.heading }}
      </h2>
    {% endif %}

    <div class="hz-not-sure-grid">
      {% for block in section.blocks %}
        {% assign target_product = block.settings.target_product %}
        <div class="hz-not-sure-card" {{ block.shopify_attributes }}>
          <div class="hz-not-sure-card-content">
            <h3 class="hz-not-sure-card-title">{{ block.settings.title }}</h3>
            <p class="hz-not-sure-card-desc">{{ block.settings.description }}</p>
          </div>
          <div class="hz-not-sure-card-media">
            {% if block.settings.custom_image != blank %}
              <img src="{{ block.settings.custom_image | image_url: width: 600 }}" alt="" class="hz-not-sure-img" loading="lazy" width="300" height="300">
            {% elsif target_product != blank and target_product.featured_image != blank %}
              <img src="{{ target_product.featured_image | image_url: width: 600 }}" alt="" class="hz-not-sure-img" loading="lazy" width="300" height="300">
            {% endif %}
          </div>
          {% if target_product != blank %}
            <a href="{{ target_product.url }}" class="hz-not-sure-link-overlay" aria-label="{{ block.settings.title }}"></a>
          {% endif %}
        </div>
    {% endfor %}
    </div>
  </div>

  {% comment %} Bottom Wave Divider {% endcomment %}
  {% if section.settings.bottom_wave_image != blank %}
    <div class="wave-container bottom" style="background-image: url({{ section.settings.bottom_wave_image | image_url: width: 1440 }})"></div>
  {% endif %}
</div>

<style>
  .hz-not-sure-section {
    position: relative;
    padding: 60px 20px;
    width: 100%;
    box-sizing: border-box;
    overflow: hidden;
  }

  .wave-container {
    width: 100%;
    height: 40px;
    background-size: cover;
    background-repeat: no-repeat;
    background-position: center;
  }
  .wave-container.top {
    margin-bottom: 24px;
  }
  .wave-container.bottom {
    margin-top: 24px;
  }

  .hz-not-sure-container {
    max-width: 1080px;
    margin: 0 auto;
  }

  .hz-not-sure-heading {
    text-align: center;
    font-size: 32px;
    font-family: serif;
    font-weight: 600;
    margin: 0 0 36px 0;
  }

  .hz-not-sure-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
    margin-bottom: 20px;
  }
  .hz-not-sure-grid > :nth-child(n+4) {
    grid-column: span 1.5;
    max-width: 500px;
    margin: 0 auto;
    width: 100%;
  }

  .hz-not-sure-card {
    position: relative;
    background-color: #ffffff;
    border: 1px solid rgba(11, 26, 48, 0.12);
    border-radius: 20px;
    padding: 24px;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .hz-not-sure-card:hover {
    box-shadow: 0 8px 24px rgba(11, 26, 48, 0.06);
  }

  .hz-not-sure-card-title {
    font-size: 19px;
    font-weight: 700;
    color: #0b1a30;
    margin: 0 0 8px 0;
  }

  .hz-not-sure-card-desc {
    font-size: 14px;
    color: #475569;
    margin: 0 0 20px 0;
    line-height: 1.4;
  }

  .hz-not-sure-card-media {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 160px;
  }

  .hz-not-sure-img {
    max-width: 100%;
    height: auto;
    object-fit: contain;
  }

  .hz-not-sure-link-overlay {
    position: absolute;
    inset: 0;
    z-index: 2;
  }

  @media (max-width: 900px) {
    .hz-not-sure-grid {
      grid-template-columns: 1fr;
    }
    .hz-not-sure-grid > :nth-child(n+4) {
      grid-column: span 1;
    }
  }
</style>

{% schema %}
{
  "name": "Not Sure Where to Start",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section Background",
      "default": "#fdf8ee"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Heading Text Color",
      "default": "#0b1a30"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Not sure where to start?"
    },
    {
      "type": "header",
      "content": "Wave Dividers"
    },
    {
      "type": "image_picker",
      "id": "top_wave_image",
      "label": "Top SVG Wave Image",
      "info": "Upload your custom top wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "bottom_wave_image",
      "label": "Bottom SVG Wave Image",
      "info": "Upload your custom bottom wave SVG file."
    }
  ],
  "blocks": [
    {
      "type": "guide_card",
      "name": "Guide Card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New to both?"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Start with the Sleep Bundle in Blue (Breathe)."
        },
        {
          "type": "product",
          "id": "target_product",
          "label": "Linked Product (Optional click link)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Override Image (Fallback to Product Image)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Not Sure Where to Start",
 
    }
  ]
}
{% endschema %}