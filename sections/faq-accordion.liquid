<div class="hz-faq-wrapper" style="background-color: {{ section.settings.bg_color }};">
  {% comment %} Top Wave Divider {% endcomment %}
  {% if section.settings.top_wave_image != blank %}
    <div class="hz-faq-wave hz-faq-wave--top">
      <img 
        src="{{ section.settings.top_wave_image | image_url: width: 1440 }}" 
        alt="" 
        loading="lazy" 
        class="hz-faq-wave-img"
      />
    </div>
  {% endif %}

  <div class="hz-faq-container">
    {% if section.settings.heading != blank %}
      <h2 class="hz-faq-heading">{{ section.settings.heading }}</h2>
    {% endif %}

    <div 
      class="accordion accordion--plus border-style spacing-style accordion--dividers"
      style="
        --summary-font-family: inherit;
        --summary-font-weight: 500;
        --summary-font-size: 1.125rem;
        --border-color: {{ section.settings.divider_color }};
      "
    >
      {% for block in section.blocks %}
        {% if block.settings.question != blank %}
          <div class="accordion-item" {{ block.shopify_attributes }}>
            <details class="details" data-testid="accordion-details" {% if block.settings.default_open %}open{% endif %}>
              <summary class="details__header">
                <span class="details__title">{{ block.settings.question }}</span>
                <span class="details__icon" aria-hidden="true"></span>
              </summary>
              <div class="details-content">
                <div class="custom spacing-style text-block custom-typography custom-font-size">
                  {{ block.settings.answer }}
                </div>
              </div>
            </details>
          </div>
        {% endif %}
      {% endfor %}
    </div>
  </div>

  {% comment %} Bottom Wave Divider {% endcomment %}
  {% if section.settings.bottom_wave_image != blank %}
    <div class="hz-faq-wave hz-faq-wave--bottom">
      <img 
        src="{{ section.settings.bottom_wave_image | image_url: width: 1440 }}" 
        alt="" 
        loading="lazy" 
        class="hz-faq-wave-img"
      />
    </div>
  {% endif %}
</div>

<style>
  .hz-faq-wrapper {
    position: relative;
    padding: 70px 24px;
    overflow: hidden;
  }

  .hz-faq-wave {
    position: absolute;
    left: 0;
    width: 100%;
    line-height: 0;
    pointer-events: none;
    z-index: 3;
  }
  .hz-faq-wave--top { top: 0; }
  .hz-faq-wave--bottom { bottom: -1px; }

  .hz-faq-wave-img {
    display: block;
    width: 100%;
    height: 60px;
    object-fit: fill;
  }

  .hz-faq-container {
    max-width: 780px;
    margin: 0 auto;
    position: relative;
    z-index: 2;
  }

  .hz-faq-heading {
    text-align: center;
    font-size: 38px;
    font-family: serif;
    font-weight: 400;
    color: #0b1a30;
    margin: 0 0 36px 0;
    letter-spacing: -0.01em;
  }

  /* Accordion Base */
  .accordion {
    width: 100%;
    display: flex;
    flex-direction: column;
  }

  .accordion--dividers .accordion-item {
    border-bottom: 1px solid var(--border-color, #d4d0c7);
  }

  .accordion--dividers .accordion-item:first-child {
    border-top: 1px solid var(--border-color, #d4d0c7);
  }

  .details {
    width: 100%;
  }

  .details__header {
    list-style: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 22px 0;
    cursor: pointer;
    user-select: none;
    font-family: var(--summary-font-family, inherit);
    font-size: var(--summary-font-size, 1.125rem);
    font-weight: var(--summary-font-weight, 500);
    color: #0b1a30;
    transition: color 0.2s ease;
  }

  .details__header::-webkit-details-marker {
    display: none;
  }

  .details__title {
    padding-right: 18px;
    line-height: 1.35;
  }

  /* Plus / Minus Animated Icon */
  .details__icon {
    position: relative;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }

  .details__icon::before,
  .details__icon::after {
    content: '';
    position: absolute;
    background-color: #0b1a30;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    transition: transform 0.25s ease;
  }

  /* Horizontal line */
  .details__icon::before {
    width: 14px;
    height: 1.5px;
  }

  /* Vertical line */
  .details__icon::after {
    width: 1.5px;
    height: 14px;
  }

  /* Transform plus into minus when open */
  .details[open] .details__icon::after {
    transform: translate(-50%, -50%) rotate(90deg);
    opacity: 0;
  }

  /* Details Content */
  .details-content {
    padding-bottom: 22px;
    animation: hzDetailsFade 0.25s ease-out;
  }

  .details-content .text-block {
    font-size: 15px;
    line-height: 1.6;
    color: #3b4d5b;
  }

  .details-content .text-block p {
    margin: 0 0 10px 0;
  }

  .details-content .text-block p:last-child {
    margin-bottom: 0;
  }

  @keyframes hzDetailsFade {
    from {
      opacity: 0;
      transform: translateY(-4px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 768px) {
    .hz-faq-wrapper {
      padding: 50px 18px;
    }
    .hz-faq-wave-img {
      height: 35px;
    }
    .hz-faq-heading {
      font-size: 30px;
      margin-bottom: 24px;
    }
    .details__header {
      padding: 18px 0;
      font-size: 1rem;
    }
  }
</style>

{% schema %}
{
  "name": "FAQ Accordion",
  "settings": [
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#fdf8ee"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider Border Color",
      "default": "#cbd3d8"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "FAQ"
    },
    {
      "type": "header",
      "content": "Wave Dividers"
    },
    {
      "type": "image_picker",
      "id": "top_wave_image",
      "label": "Top SVG Wave Image"
    },
    {
      "type": "image_picker",
      "id": "bottom_wave_image",
      "label": "Bottom SVG Wave Image"
    }
  ],
  "blocks": [
    {
      "type": "faq_item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "What is the return policy?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We offer a 30-night risk-free guarantee. If you are not completely satisfied, reach out to our team for a full refund.</p>"
        },
        {
          "type": "checkbox",
          "id": "default_open",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "FAQ Accordion",
      "blocks": [
        { "type": "faq_item", "settings": { "question": "What is the return policy?" } },
        { "type": "faq_item", "settings": { "question": "Are any purchases final sale?" } },
        { "type": "faq_item", "settings": { "question": "When will I get my order?" } },
        { "type": "faq_item", "settings": { "question": "Where are your products manufactured?" } },
        { "type": "faq_item", "settings": { "question": "How much does shipping cost?" } }
      ]
    }
  ]
}
{% endschema %}