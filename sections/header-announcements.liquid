{% if section.blocks.size > 1 %}
  <script
    src="{{ 'announcement-bar.js' | asset_url }}"
    type="module"
    fetchpriority="low"
  ></script>
{% endif %}

{% render 'contrast-override', background_color: section.settings.background_color, section_id: section.id %}

{% comment %} Top Wave Divider {% endcomment %}
    {% if section.settings.top_wave_image != blank %}
    <div class="wave-container top" style="background-image: url({{ section.settings.top_wave_image | image_url: width: 1440 }})">
    </div>
    {% endif %}
  {% comment %} Bottom Wave Divider {% endcomment %}
    {% if section.settings.bottom_wave_image != blank %}
    <div class="wave-container bottom" style="background-image: url({{ section.settings.bottom_wave_image | image_url: width: 1440 }})">
    </div>
    {% endif %}
    
<div class="section-background color-custom-{{ section.id }}"></div>
<aside
  class="announcement-bar spacing-style section section--{{ section.settings.section_width }} color-custom-{{ section.id }} announcement-bar--{{ section.settings.display_mode }}"
  style="{% render 'spacing-padding', settings: section.settings %}; --border-bottom-width: {{ section.settings.divider_width }}px;{% if section.settings.divider_color != blank %} --color-border: {{ section.settings.divider_color }};{% endif %} --marquee-speed: {{ section.settings.marquee_speed }}s;"
>

  {% liquid
    assign autoplay = false
    assign show_arrows = false
    if section.blocks.size > 1 and section.settings.display_mode == 'slider'
      assign autoplay = true
      assign show_arrows = true
    endif
  %}

  <announcement-bar-component
    class="announcement-bar__slider"
    {% if autoplay == true %}
      autoplay="{{ section.settings.speed }}" aria-live="polite"
    {% endif %}
  >
    {% if show_arrows and section.settings.display_mode == 'slider' %}
      {% render 'slideshow-arrows', icon_style: 'chevron' %}
    {% endif %}

    {%- capture announcement_blocks -%}
      {% content_for 'blocks' %}
    {%- endcapture -%}

    <div class="announcement-bar__slides {% if section.settings.display_mode == 'marquee' %}announcement-bar__slides--marquee{% endif %}">
      {{ announcement_blocks }}
      {% if section.settings.display_mode == 'marquee' %}
        {{ announcement_blocks }}
      {% endif %}
    </div>
  </announcement-bar-component>
</aside>

{% stylesheet %}
  .announcement-bar {
    border-block-end: var(--border-bottom-width) solid var(--color-border);
    overflow: hidden;
  }

  .announcement-bar__slider {
    display: flex;
    flex-direction: row;
    align-items: center;
    position: relative;
    width: 100%;
    overflow: hidden;

    @media screen and (max-width: 749px) {
      grid-column: 1 / -1;
    }
  }

  .announcement-bar__slides {
    display: grid;
    grid: [stack] auto / [stack] auto;
    max-width: 680px;
    margin-inline: auto;
  }

  .announcement-bar--slider .announcement-bar__slides {
    width: 100%;
  }

  .announcement-bar__slides > * {
    grid-area: stack;
  }

  /* Marquee Mode Styles */
  .announcement-bar__slides--marquee {
    display: flex !important;
    width: max-content !important;
    max-width: none !important;
    animation: announcement-marquee var(--marquee-speed, 20s) linear infinite;
    gap: 4rem;
  }

  .announcement-bar__slides--marquee > * {
    position: static !important;
    grid-area: unset !important;
    flex-shrink: 0;
  }

  @keyframes announcement-marquee {
    0% {
      transform: translateX(0);
    }
    100% {
      transform: translateX(-50%);
    }
  }

  .announcement-bar__slide {
    transition: opacity 0.5s ease-in-out, visibility 0.5s ease-in-out;
    content-visibility: visible;

    &[aria-hidden='true'] {
      opacity: 0;
      visibility: hidden;
    }
  }

  .announcement-bar__slider slideshow-arrows {
    padding: 0;
    mix-blend-mode: normal;
  }

  .announcement-bar__slider slideshow-arrows .slideshow-control {
    color: var(--color-foreground);
  }

  .announcement-bar__slider .slideshow-control {
    display: flex;
    padding: 0;
    width: var(--button-size);
    height: var(--button-size);
    align-items: center;
    justify-content: center;
    opacity: 1;
    animation: none;

    @media screen and (min-width: 750px) {
      --slideshow-control-offset: calc((var(--button-size) - var(--icon-size-xs)) / 2);

      .section--page-width &.slideshow-control--previous {
        transform: translateX(var(--slideshow-control-offset));
      }
    }
  }

  .announcement-bar__slider .slideshow-control .svg-wrapper {
    width: var(--icon-size-xs);
    height: var(--icon-size-xs);
  }

  .announcement-bar__slide {
    place-content: center;
  }

  .announcement-bar__text:first-child {
    margin: 0;
  }

  .announcement-bar__link {
    position: absolute;
    inset: 0;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.announcement_bar",
  "blocks": [
    {
      "type": "_announcement"
    }
  ],
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Behavior & Layout"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display Style",
      "options": [
        {
          "value": "slider",
          "label": "Slider (Auto-rotating)"
        },
        {
          "value": "marquee",
          "label": "Marquee (Continuous scroll)"
        }
      ],
      "default": "slider"
    },
    {
      "type": "range",
      "id": "speed",
      "label": "Slider Rotation Speed",
      "min": 2,
      "max": 10,
      "default": 5,
      "unit": "sec"
    },
    {
      "type": "range",
      "id": "marquee_speed",
      "label": "Marquee Scroll Speed",
      "min": 5,
      "max": 40,
      "step": 1,
      "default": 20,
      "unit": "s",
      "info": "Lower duration means faster continuous scrolling."
    },
    {
      "type": "header",
      "content": "Wave Dividers"
    },
    {
      "type": "image_picker",
      "id": "top_wave_image",
      "label": "Top SVG Wave Image",
      "info": "Upload your custom top wave SVG file."
    },
    {
      "type": "image_picker",
      "id": "bottom_wave_image",
      "label": "Bottom SVG Wave Image",
      "info": "Upload your custom bottom wave SVG file."
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "range",
      "id": "divider_width",
      "label": "t:settings.divider_thickness",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "default": 0
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "t:settings.divider_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 15
    }
  ],
  "presets": [
    {
      "name": "t:names.announcement_bar",
      "blocks": {
        "announcement_1": {
          "type": "_announcement"
        }
      },
      "block_order": ["announcement_1"]
    }
  ]
}
{% endschema %}